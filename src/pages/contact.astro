---
import { badgeImage } from '../lib/badge-image';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpinBadge from '../components/ui/SpinBadge.vue';
import ContactForm from '../components/ContactForm.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { CONTACT_EMAIL } from '../lib/contact';

/*
 * The standfirst, the topics and the closing line are drawn from Sinduri's
 * own copy on /about, so this page adds no claim that page does not make.
 *
 * THE ADDRESSES ARE REAL, deliberately. An address is not editorial copy, it
 * is what the page exists to carry, and a placeholder one makes this page a
 * dead end. The two profile links are the ones the footer already carries.
 *
 * THE FORM POSTS TO /contact/send/, which is the site's one on-demand route.
 * public/_headers carries `form-action 'self'` for it; at `'none'` the browser
 * blocks the submission silently, with nothing on the page to say so.
 */

const EMAIL = CONTACT_EMAIL;

const CONTACT_METHODS = [
  {
    label: 'Email',
    value: EMAIL,
    href: `mailto:${EMAIL}`,
  },
  {
    label: 'LinkedIn',
    value: 'in/sinduri-guntupalli',
    href: 'https://at.linkedin.com/in/sinduri-guntupalli-307542131',
  },
  {
    label: 'GitHub',
    value: '@sindurigf',
    href: 'https://github.com/sindurigf',
  },
] as const;

const REASONS = [
  'Drupal and open source communities',
  'Drupal events and Drupal Austria',
  'Kindness, empathy and positivity',
  'Lord of the Rings, Star Trek, One Piece and Star Wars',
  'Cats, especially Minerva, Hela and Rudra',
] as const;
---

<BaseLayout
  title="Contact | sinduri.lol"
  description="Write to Sinduri in Vienna by email, on LinkedIn or GitHub, or with the contact form."
>
  <PageHero title="Get in touch">
    <p class="standfirst">
      Open source enthusiast in Vienna, cat lover, and a very serious Lord of
      the Rings fan. I love talking about nothing and anything, so write to me!
    </p>

    {/*
      The badge takes the roundel's corner: both are the site's round mark,
      and one corner mark per plate keeps this hero the same as every other.
      client:load because the animation is applied by the island on mount,
      so the pause control SC 2.2.2 asks for and the motion it pauses arrive
      together or not at all.
    */}
    <SpinBadge
      slot="mark"
      client:load
      badge={badgeImage}
      frameClass="h-40 w-40 lg:h-48 lg:w-48"
      markClass="w-28 lg:w-32"
      borderClass="border-8"
      shadowClass="shadow-hard-cyan-8"
    />
  </PageHero>

  {/*
    The form comes first in source order as well as on the left, so the
    reading order at one column matches the two-column reading order.
  */}
  <Section title="Write to me">
    {/*
      Functional microcopy. Says what happens to the message and names the
      way round the form, because a form is not everyone's way in.
    */}
    <p slot="lead" class="lead">
      This goes to the same inbox as the email address on this page. If
      something on this site blocks you, that is worth sending even if you
      cannot say which part is wrong, and you do not need to explain why you are
      writing.
    </p>

    <div class="grid gap-grid lg:grid-cols-12 lg:items-start">
      <div class="card min-w-0 shadow-hard-gold-8 lg:col-span-7">
        <ContactForm />
      </div>

      <div class="flex min-w-0 flex-col gap-grid lg:col-span-5">
        <div>
          <h3 class="card-title">Or find me here</h3>

          {/*
            The whole card is the link here, unlike the blog cards, because of
            the length of the resulting name: a blog card would read as its
            category, reading time, title and a forty-word teaser in one
            string, where this reads as "Email lol@sinduri.lol", which is what
            the control is. The arrow is decoration and out of the tree.
          */}
          <ul class="mt-6 flex flex-col gap-6">
            {CONTACT_METHODS.map((method) => (
              <li class="flex min-w-0">
                <a
                  href={method.href}
                  class="flex w-full min-w-0 items-center justify-between gap-6 border-8 border-border bg-surface p-card-tight text-text shadow-hard-gold-8 hover:text-cyan"
                >
                  <span class="flex min-w-0 flex-col gap-2">
                    <span class="label-wide text-gold">{method.label}</span>
                    <span class="text-h3 font-extrabold">{method.value}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="text-h3 leading-none text-gold"
                  >
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card shadow-hard-gold-8">
          <h3 class="card-title">Write to me about</h3>
          <ul class="bullet-list mt-6">
            {REASONS.map((reason) => (
              <li class="mt-3 text-body text-pretty">{reason}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  {/* ===================================================================
       CLOSING
       =================================================================== */}
  {/*
    THE GOLD BAND. The one ground change on this page that is a real boundary
    rather than a hue shift: #FFC000 against the section above it is 11.32:1,
    where navy against deep is 1.07:1.

    Nothing here names a dark-set token. `.surface-gold` supplies
    `text-gold-text` to the subtree, and an explicit `text-text` would beat it
    and render at 1.27 on this ground. The button is the gold-surface pair;
    `.btn-primary` is unreadable here and is not permitted.
    tests/gold-surface.spec.ts walks this section and fails on either mistake.
  */}
  <section class="surface-gold band py-section">
    <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-grid">
      <p class="max-w-2xl text-h3 font-bold text-pretty">
        We should all be a bit kinder and more empathetic.
      </p>
      <a href="/about/" class="btn-gold-primary">
        More about me
      </a>
    </div>
  </section>
</BaseLayout>
