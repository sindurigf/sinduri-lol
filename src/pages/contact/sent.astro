---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CloseRow from '../../components/CloseRow.astro';
import PageHero from '../../components/PageHero.astro';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../../lib/contact';
import { RETENTION_DAYS } from '../../lib/contact-form';
import { JOURNEY_POST_HREF } from '../../lib/paths';
import { RIDDLE } from '../../lib/riddle';

/*
 * Prerendered, so success is a static asset with public/_headers applied.
 * Reached by a 303 from /contact/send/, so a refresh cannot resubmit.
 * noindex: from a search result it would confirm a message nobody sent.
 */
---

<BaseLayout
  title="Message Sent"
  description="Your message has been received."
  noindex
>
  <PageHero title="Message Sent" titleSize="h2" slab="thin">
    <p class="standfirst">
      Thank you for writing. A reply will come to the email address you gave,
      usually within a few days.
    </p>
  </PageHero>

  <section class="band py-section">
    <div class="mx-auto max-w-page">
      <div class="card">
        <p class="max-w-measure text-body text-text text-pretty">
          Your name, email address and message are stored for {RETENTION_DAYS}{' '}
          days, and you were not added to any list. The{' '}
          <a href="/privacy/">privacy page</a> says what else is recorded when
          you send the form. If you need to add something, write to{' '}
          <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>.
        </p>

        <details class="mt-8 max-w-measure">
          <summary class="post-contents-summary">
            <span>{RIDDLE.question}</span>
            <span class="post-contents-marker" aria-hidden="true"></span>
          </summary>
          <div class="mt-6 text-body text-text text-pretty">
            <p>{RIDDLE.lead}</p>
            <blockquote class="mt-4">
              <p>&ldquo;{RIDDLE.answer}&rdquo;</p>
              <footer class="mt-2 text-subtle">{RIDDLE.source}</footer>
            </blockquote>
            <p class="mt-4 text-subtle">{RIDDLE.note}</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <CloseRow
    readHref={JOURNEY_POST_HREF}
    readLabel="Five Years in Drupal"
    actionHref="/contact/"
    actionLabel="Back to Contact"
  />
</BaseLayout>
