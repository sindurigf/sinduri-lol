---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CloseRow from '../../components/CloseRow.astro';
import PageHero from '../../components/PageHero.astro';
import { CONTACT_EMAIL } from '../../lib/contact';

/*
 * The contact form's confirmation. Prerendered, so a successful submission
 * ends on a static asset with public/_headers applied, the same as every other
 * page: only the failure path needs the Worker to render anything.
 *
 * Reached by a 303 from /contact/send/, which is what stops a refresh
 * resubmitting the message.
 *
 * Copy is functional microcopy, so it is written rather than left as
 * PLACEHOLDER: a confirmation that says nothing leaves a reader who cannot see
 * the page change unsure whether anything happened.
 *
 * `noindex`, because it is served with a 200: listed in a search result, it
 * would tell someone who sent nothing that their message arrived.
 */
---

<BaseLayout
  title="Message sent | sinduri.lol"
  description="Your message has been received."
  noindex
>
  <PageHero title="Message sent">
    <p class="standfirst">
      Your message has been received. A reply will come to the email address you
      gave, usually within a few days.
    </p>
  </PageHero>

  <section class="band py-section">
    <div class="mx-auto max-w-page">
      <p class="max-w-3xl text-body text-text text-pretty">
        Nothing else was stored, and you were not added to any list. If you need
        to add something, write to{' '}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <CloseRow
        readHref="/blog/five-years-in-drupal/"
        readLabel="Five years in Drupal"
        actionHref="/contact/"
        actionLabel="Back to contact"
      />
    </div>
  </section>
</BaseLayout>
