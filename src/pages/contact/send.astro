---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import { CONTACT_EMAIL } from '../../lib/contact';
import { env } from 'cloudflare:workers';
import { rateLimitKey, type ContactEnv } from '../../lib/contact-env';
import {
  handleSubmission,
  type SubmissionKind,
} from '../../lib/contact-submission';
import { applyGlobalHeaders } from '../../lib/response-headers';

/*
 * The contact form's submission target, and the only page on this site that is
 * not prerendered.
 *
 * It renders at all only when something went wrong. A successful submission
 * redirects to /contact/sent/, which is a static asset like every other page;
 * a failed one renders here with the form refilled and the errors on it, so a
 * visitor can fix and resubmit without going back and retyping.
 *
 * Why the form is not simply posted back to /contact/: preserving what
 * somebody typed means rendering it, and rendering it means the page cannot be
 * an asset. Keeping that to one route leaves /contact static, covered by
 * public/_headers and by the header suite like everything else.
 */
export const prerender = false;

/*
 * public/_headers does not reach a response the Worker builds, so this route
 * sets those headers itself. Without this it would ship with no CSP, no HSTS
 * and none of the other headers every other response carries.
 */
applyGlobalHeaders(Astro.response.headers);

const CONTACT_PAGE = '/contact/';
const SENT_PAGE = '/contact/sent/';

/* GET reaches here when somebody opens the URL directly. Nothing to show. */
if (Astro.request.method !== 'POST') {
  return Astro.redirect(CONTACT_PAGE, 303);
}

let form: FormData;
try {
  form = await Astro.request.formData();
} catch {
  /*
   * A body that is not form data did not come from this form. Answered as a
   * redirect rather than an error page: there is no visitor here to help.
   */
  return Astro.redirect(CONTACT_PAGE, 303);
}

const outcome = await handleSubmission(
  form,
  env as ContactEnv,
  Date.now(),
  await rateLimitKey(Astro.request),
);

if (outcome.kind === 'sent') {
  return Astro.redirect(SENT_PAGE, 303);
}

const STATUS: Record<Exclude<SubmissionKind, 'sent'>, number> = {
  invalid: 422,
  limited: 429,
  failed: 503,
};
Astro.response.status = STATUS[outcome.kind];

const tooMany = outcome.kind === 'limited';
const storageFailed = outcome.kind === 'failed';
---

<BaseLayout
  title="Check your message | sinduri.lol"
  description="Something went wrong sending your message."
  noCanonical
>
  <PageHero title="Check your message">
    {tooMany && (
      <p class="standfirst">
        That is a lot of messages in a short time. Wait a few minutes and try
        again, or email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>{' '}
        instead.
      </p>
    )}

    {storageFailed && (
      <p class="standfirst">
        Your message could not be saved, so it has not been received. Please
        email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> instead.
        Your text is still in the form below, so you can copy it.
      </p>
    )}

    {!tooMany && !storageFailed && (
      <p class="standfirst">
        Nothing has been sent yet. What you wrote is still here.
      </p>
    )}
  </PageHero>

  <section class="band py-section">
    <div class="mx-auto max-w-page">
      <div class="card max-w-3xl">
        <ContactForm
          errors={outcome.errors}
          values={outcome.values}
          summaryHeading="h2"
        />
      </div>
    </div>
  </section>
</BaseLayout>
