---
import { Image } from 'astro:assets';
import bunnyDark from '../assets/bunny-dark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import HeroField from '../components/ui/HeroField.vue';
import PlaceholderBox from '../components/PlaceholderBox.astro';
import { BLOG_CATEGORIES } from '../content.config';
import { categoryLabel, getFeaturedPosts } from '../lib/blog';
import { DENSITIES } from '../lib/image-densities';

/*
 * PLACEHOLDER COPY, WITH TWO EXCEPTIONS THAT ARE REAL.
 *
 * The name in the hero and the About teaser's heading are Sinduri's own
 * words. Every other paragraph, heading and card description is lorem ipsum
 * at the length the comp's copy occupies, so the layout is stress-tested at
 * the sizes it will carry. The brand strings, the five category names and the
 * functional microcopy on the controls are structural, not copy.
 *
 * The lorem is Latin inside a lang="en" document, which is wrong for a screen
 * reader and is recorded as a known gap in ACCESSIBILITY.md section 7.
 */

const FEATURED_LIMIT = 3;
const featured = await getFeaturedPosts(FEATURED_LIMIT);

/** The bunny roundel's mark, drawn `h-14`. See the note in Header.astro. */
const ROUNDEL_MARK_HEIGHT = 56;

/*
 * The comps show four category cards; there are five categories. Derived from
 * BLOG_CATEGORIES rather than transcribed, so a category cannot go missing
 * from the homepage.
 *
 * The accent classes are written out per category rather than composed,
 * because Tailwind scans source text and would never see `border-${accent}`.
 */
const CATEGORY_CARDS = [
  {
    category: BLOG_CATEGORIES[0],
    tile: 'bg-gold text-background',
    shadow: 'shadow-hard-gold-8',
    glyph: '✦',
    teaser:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim.',
  },
  {
    category: BLOG_CATEGORIES[1],
    tile: 'bg-cyan text-darkcyan',
    shadow: 'shadow-hard-cyan-8',
    glyph: '✈',
    teaser:
      'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi.',
  },
  {
    category: BLOG_CATEGORIES[2],
    tile: 'bg-pink text-background',
    shadow: 'shadow-hard-pink-8',
    glyph: '❋',
    teaser:
      'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.',
  },
  {
    category: BLOG_CATEGORIES[3],
    tile: 'bg-gold text-background',
    shadow: 'shadow-hard-gold-8',
    glyph: '◆',
    teaser:
      'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia.',
  },
  {
    category: BLOG_CATEGORIES[4],
    tile: 'bg-cyan text-darkcyan',
    shadow: 'shadow-hard-cyan-8',
    glyph: '</>',
    teaser:
      'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium.',
  },
] as const;

const STATS = [
  { value: 'Duis', label: 'Lorem ipsum dolor', frame: 'border-gold text-gold' },
  {
    value: 'Aute',
    label: 'Sit amet consectetur',
    frame: 'border-cyan text-cyan',
  },
] as const;
---

<BaseLayout
  title="Sinduri Guntupalli | Open Source Enthusiast, Positivity Advocate"
  description="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
>
  {/* ===================================================================
       HERO
       =================================================================== */}
  {/*
    `hero` sizes this section to the screen as a min-height, so it grows past
    the viewport at 200% text zoom, under the text-spacing override and at
    400% reflow rather than clipping. See the class.

    `overflow-hidden` crops the field and nothing else: the scene bleeds off
    all four edges, and the type is in normal flow inside the section's
    padding.
  */}
  <section class="band hero relative overflow-hidden">
    {/*
      THE FIELD, AND WHY IT IS AN ISLAND RATHER THAN MARKUP.

      Three canvases, a hare, and the pause control SC 2.2.2 requires. The
      animation is applied by the component on mount and never by what the
      server sends, for the reason SpinBadge.vue gives: the control that stops
      the motion is JavaScript, so motion in the server-rendered HTML would
      run in a browser where the control failed to hydrate. With scripting off
      the canvases render empty and this section is the name and the two
      stickers on a flat ground.

      client:load, matching SpinBadge and MobileMenu. A lazier directive would
      delay the control and the motion together, and `client:visible` on an
      element already visible at the top of the page fires immediately anyway,
      having first shipped an IntersectionObserver to decide so.

      The field carries its own light, a band across the horizon and a
      weighting of the lower edge painted into the canvas. See
      src/lib/hero-field.ts.
    */}
    <HeroField client:load />

    {/*
      `max-w-page`, the same 1280px column every other section uses. The field
      behind it is deliberately not held to it.
    */}
    <div class="hero-stack mx-auto max-w-page">
      <div class="hero-plate">
        {/*
          One <h1> in two lines, where the comp stacks two <h1> elements with
          a -56px overlap. Two <h1>s on one page is a document-outline defect,
          and the overlap is negative margins on a 104px display size, which
          at a small viewport pulls the second line into the first. The
          two-tone treatment and the order are kept; the overlap is not.
        */}
        {/*
          `w-full` and the explicit `{' '}` are both load-bearing.

          Without `w-full` the <h1> is a flex item and shrinks to its longest
          line instead of filling the content box, so the reflow suite's
          heading-word check would measure the heading against a box the width
          of the word inside it, which can never be too small.

          Without the space, Astro emits the two spans adjacent and
          `textContent` reads "SinduriGuntupalli" as one word. It renders the
          same either way, because the spans are block, so the only things
          that notice are the ones reading the text: that check, a screen
          reader, and search.
        */}
        {/*
          `text-hero-h1`, not `text-h1`. Same 33px floor and 104px ceiling,
          and additionally capped against the viewport height, which matters
          here and nowhere else on the site. See the token.
        */}
        <h1 class="w-full text-hero-h1">
          <span class="block text-text">Sinduri</span>{' '}
          <span class="block text-gold">Guntupalli</span>
        </h1>
      </div>

      {/*
        The two brand words. From `sm` up, a column against the right of the
        content area; below it, a row under the name, where there is room. One
        set of elements in both layouts, so anything reading the DOM finds the
        same two words wherever they land. See `.hero-marks`.

        `aria-hidden` because they are decoration: "Lepus Ridet" is the site's
        motto, already announced by the badge on Contact and carried by the
        header wordmark's context.

        30px at the ceiling, from the comp, clamped against the viewport
        height like everything else in this section.

        The shadows stay saturated rather than taking the comp's #001F25 and
        #3F001A, which measure 1.08:1 on this page's #131313 ground. An offset
        shadow falls outside its element, so on this ground the comp's version
        is not a soft shadow, it is no shadow.
      */}
      {/*
        Spans, not paragraphs. WAVE reports a short, large, bold <p> as a
        possible heading, and these are decorative words, not headings and not
        prose. `.hero-marks` is a flex container, so each span lays out as a
        block without being told to. See tests/wave-alerts.spec.ts.
      */}
      <div class="hero-marks" aria-hidden="true">
        <span class="hero-sticker -rotate-6 border-border bg-cyan text-darkcyan shadow-hard-pink-8">
          Lepus
        </span>
        <span class="hero-sticker rotate-6 border-pink bg-surface text-pink-text shadow-hard-cyan-8">
          Ridet
        </span>
      </div>
    </div>
  </section>

  {/* ===================================================================
       ABOUT TEASER
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-gold"></span>
    </div>

    <div class="mx-auto max-w-page">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <span class="section-number" aria-hidden="true">
          01
        </span>
        {/*
          The tagline, as this section's heading. Sinduri's own words.

          It is here rather than in the hero because there it was 13 to 16px
          text over the moving field, where the stems behind it took it to
          1.25:1 against the 4.5:1 SC 1.4.3 asks of text that size. On this
          flat ground, at heading size, it passes.

          Two block spans, one per role, with a visually hidden comma between
          them rather than a bare space, so anything reading the text gets
          "Open Source Enthusiast, Positivity Advocate" and not one run-on
          string. Same reason as the `{' '}` in the <h1> above.
        */}
        <h2 class="text-h2 text-text">
          <span class="block">Open Source Enthusiast</span>
          <span class="sr-only">,</span>{' '}
          <span class="block">Positivity Advocate</span>
        </h2>
      </div>

      <div class="mt-16 grid gap-16 lg:grid-cols-2 lg:items-start">
        <div class="relative">
          <PlaceholderBox ratio="square" label="workspace photo" />
          {/*
            The bunny mark on its gold tile, as in the comp. `bunny-dark` is
            #111111 artwork: 11.50 on gold and 1.02 on the page background, so
            the tile is what makes it visible. alt="" because the heading and
            the header wordmark already name the site.

            `sm:-right-6` is the width of the `sm` gutter, so the roundel
            overhangs the photo as far as the page allows and no further.
            Anything past the gutter scrolls the page sideways at 640px.
          */}
          <span class="absolute -bottom-8 -right-2 flex size-28 items-center justify-center rounded-full border-8 border-border bg-gold shadow-hard-cyan-8 sm:-right-6">
            <Image
              src={bunnyDark}
              alt=""
              height={ROUNDEL_MARK_HEIGHT}
              densities={DENSITIES}
              class="h-14 w-auto"
            />
          </span>
        </div>

        <div class="card mt-12 shadow-hard-pink-8 lg:mt-16">
          <p class="text-h3 font-bold text-text text-pretty">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua veniam.
          </p>

          <p class="mt-8 text-body text-muted text-pretty">
            Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris
            nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in
            reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
            pariatur sint occaecat.
          </p>

          <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {STATS.map((stat) => (
              <li
                class:list={[
                  'flex min-w-0 flex-col items-center border-8 bg-background p-6 text-center',
                  stat.frame,
                ]}
              >
                <span class="text-h3 font-extrabold">{stat.value}</span>
                <span class="label mt-2 text-text">{stat.label}</span>
              </li>
            ))}
          </ul>

          <p class="mt-10 text-body text-muted text-pretty">
            Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
            officia deserunt mollit anim id est laborum. Sed ut perspiciatis
            unde omnis iste natus error sit voluptatem accusantium doloremque.
          </p>

          <p class="mt-10">
            <a href="/about/" class="btn-secondary">
              Learn more about me
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ===================================================================
       CATEGORY GRID
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-cyan"></span>
    </div>

    <div class="mx-auto max-w-page">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <p class="pill">
            <span class="label-wide text-gold">Topics</span>
          </p>
          <div class="mt-6 flex flex-wrap items-baseline gap-x-5 gap-y-2">
            <span class="section-number" aria-hidden="true">
              02
            </span>
            <h2 class="text-h2 text-text">Lorem ipsum dolor</h2>
          </div>
        </div>
        <a href="/blog/" class="btn-secondary">
          View all posts
        </a>
      </div>

      <ul class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {CATEGORY_CARDS.map((card, index) => (
          <li
            class:list={[
              'card flex flex-col',
              card.shadow,
              index === 0 ? 'sm:col-span-2 lg:col-span-2' : '',
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                'flex size-16 -rotate-6 items-center justify-center border-4 border-border text-section-number font-black leading-none',
                card.tile,
              ]}
            >
              {card.glyph}
            </span>

            <h3 class="mt-8 text-h3">
              <a
                href={`/blog/${card.category}/`}
                class="text-text hover:text-cyan"
              >
                {categoryLabel(card.category)}
              </a>
            </h3>

            <p class="mt-5 text-body text-muted text-pretty">{card.teaser}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ===================================================================
       FEATURED POSTS
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-pink"></span>
    </div>

    <div class="mx-auto max-w-page">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <span class="section-number" aria-hidden="true">
          03
        </span>
        <h2 class="text-h2 text-text">Lorem ipsum dolor sit</h2>
      </div>

      <p class="mt-8 max-w-2xl text-body text-muted text-pretty">
        Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut
        fugit, sed quia consequuntur magni dolores eos qui ratione.
      </p>

      <ul class="mt-16 grid gap-10 lg:grid-cols-3">
        {featured.map((post) => (
          <li class="flex min-w-0">
            <BlogCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              teaser={post.data.teaser}
              category={post.data.category}
              date={post.data.date}
              readingTime={post.data.readingTime}
              featured={post.data.featured}
              headingLevel={3}
              class="w-full"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
