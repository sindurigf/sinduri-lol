---
import { Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import CloseRow from '../components/CloseRow.astro';
import Roundel from '../components/Roundel.astro';
import Section from '../components/Section.astro';
import portrait from '../assets/photos/sinduri-studio.jpg';
import '../styles/components/home.css';
import { BLOG_CATEGORIES, type BlogCategory } from '../content.config';
import {
  cardProps,
  categoryLabel,
  getCategoriesWithPosts,
  getFeaturedPosts,
  getSortedPosts,
} from '../lib/blog';
import { CARD_COVER_SIZES, WIDTHS } from '../lib/image-densities';
import { CATEGORIES, CATEGORY_TILE } from '../lib/categories';
import { packRows, wallClasses } from '../lib/wall';
import { BLOG_PATH, categoryHref } from '../lib/paths';

/* Editorial copy is Sinduri's own words; add no line she has not approved. */

const FEATURED_LIMIT = 3;
const featured = await getFeaturedPosts(FEATURED_LIMIT);
/* Matches the `lg:grid-cols-*` choice on the list below. */
const FEWER_FEATURED_COLUMNS = 2;
const [newest] = await getSortedPosts();
const featuredColumns =
  featured.length >= FEATURED_LIMIT ? FEATURED_LIMIT : FEWER_FEATURED_COLUMNS;
const featuredCoverSizes = CARD_COVER_SIZES[featuredColumns];
const featuredWall = wallClasses(
  {
    lg: packRows(
      featured.map(() => 1),
      featuredColumns,
    ),
  },
  featured.length,
);

/* The topic the tagline opens with. */
const LEAD_CATEGORY: BlogCategory = 'open-source';

const withPosts = await getCategoriesWithPosts();

const CATEGORY_CARDS = [
  LEAD_CATEGORY,
  ...BLOG_CATEGORIES.filter((category) => category !== LEAD_CATEGORY),
]
  .filter((category) => withPosts.includes(category))
  .map((category) => ({ category, ...CATEGORIES[category] }));

/* The lead card spans two columns only where the rest then fill whole rows. */
const SM_COLUMNS = 2;
const LG_COLUMNS = 3;
const LEAD_SPAN = 2;
const leadSpansSm = (CATEGORY_CARDS.length - 1) % SM_COLUMNS === 0;
const leadSpansLg =
  CATEGORY_CARDS.length >= LEAD_SPAN &&
  (CATEGORY_CARDS.length - LEAD_SPAN) % LG_COLUMNS === 0;
const spansWith = (leadSpans: boolean) =>
  CATEGORY_CARDS.map((_, index) => (index === 0 && leadSpans ? LEAD_SPAN : 1));
const categoryWall = wallClasses(
  {
    sm: packRows(spansWith(leadSpansSm), SM_COLUMNS),
    lg: packRows(spansWith(leadSpansLg), LG_COLUMNS),
  },
  CATEGORY_CARDS.length,
);

/*
 * Fitted to measured drawn widths (320 to 2560px, within 1.00 to 1.05). The
 * photo shrinks between 83rem and 1396px as the gold column's `vw` padding
 * grows. tests/image-size.spec.ts fails on drift.
 */
const TEASER_PHOTO_SIZES =
  '(min-width: 1829px) calc(25vw + 198px), (min-width: 1396px) calc(21.5vw + 262px), (min-width: 83rem) 562px, (min-width: 64rem) calc(45.7vw - 45px), (min-width: 40rem) calc(93vw - 64px), calc(100vw - 5.5rem)';

const TAGLINES = ['Open Source Enthusiast', 'Positivity Advocate'] as const;
/* Side by side from `sm`, the second climbing a third of the Step. */
const tagWall = wallClasses({ sm: [[0, 1]] }, TAGLINES.length, {
  short: true,
});

/* Bricks in the shelf under the meadow; a phone shows the first five (home.css). */
const LEDGE_BRICKS = 11;

const STATS = [
  {
    value: '3 cats',
    label: 'Minerva, Hela and Rudra',
  },
  {
    value: '2021',
    label: 'The year Drupal found me',
  },
] as const;
/* The two stats sit side by side from `sm`, the second climbing (the Step). */
const statWall = wallClasses({ sm: [[0, 1]] }, STATS.length);
---

<BaseLayout
  title="Sinduri Guntupalli, Open Source Enthusiast"
  titleSuffix={false}
  description="Sinduri Guntupalli, open source enthusiast in Vienna, experienced in product and program management, web development and Drupal community work."
>
  {/*
    One gold area for the hero and the section below. No `.surface-gold` on the
    column: its halves carry it, and nesting double-counts controls in
    tests/gold-surface.spec.ts.
  */}
  <div class="v-column gold-column">
    {/*
    The name's line break sits on the window's top rule: no color clears 4.5:1
    on both grounds, so each line takes its own.
  */}
    <section class="band hero relative">
      <div class="hero-window surface-gold">
        {/* The pause control shows once motion can run (src/scripts/hero-field.ts). */}
        <div class="hero-field" data-hero-field data-hero-motion="paused">
          <canvas aria-hidden="true" class="hero-field-layer"></canvas>
          <canvas aria-hidden="true" class="hero-field-layer"></canvas>
          <canvas aria-hidden="true" class="hero-field-layer"></canvas>

          <button type="button" class="motion-toggle hero-motion-toggle" hidden>
            <span aria-hidden="true" class="text-label leading-none">
              ❚❚
            </span>
            <span class="sr-only">Pause the hero animation</span>
          </button>
        </div>

        <div class="hero-ledge" aria-hidden="true">
          {Array.from({ length: LEDGE_BRICKS }, () => (
            <span />
          ))}
        </div>

        {/*
        Spans, not <p>: WAVE reads short bold paragraphs as headings. No
        `border-border`: it fails SC 1.4.11 here and would beat `.surface-gold`'s.
      */}
        <div class="hero-marks" aria-hidden="true">
          <span class="hero-sticker -rotate-3 bg-block-gold text-gold-text shadow-hard-bunny-8">
            Lepus
          </span>
          <span class="hero-sticker rotate-3 bg-surface text-pink-text shadow-hard-bunny-8">
            Ridet
          </span>
        </div>

        {/*
        Engines that inherit ancestor backgrounds report SINDURI below 4.5:1, a
        false positive: it is drawn on the page (tests/hero-fit.spec.ts).
        `w-full` lets reflow tests measure the real box; `{' '}` keeps the words apart.
      */}
        <div class="hero-plate">
          <h1 class="w-full text-hero-h1">
            <span class="block text-text">Sinduri</span>{' '}
            <span class="block text-gold-text">Guntupalli</span>
          </h1>
        </div>
      </div>
    </section>

    {/* Not in the hero: over the moving field the roles fail SC 1.4.3. The sr-only comma separates them. */}
    <Section surface="gold" headless class="pt-0">
      <h2
        class:list={[
          'card-block home-tags grid text-h3 text-gold-text sm:w-fit sm:grid-cols-2',
          tagWall.wall,
        ]}
      >
        {TAGLINES.map((tag, index) => (
          <span class:list={['home-tag', tagWall.bricks[index]]}>
            <span>{tag}</span>
            {index < TAGLINES.length - 1 && (
              <>
                <span class="sr-only">,</span>{' '}
              </>
            )}
          </span>
        ))}
      </h2>

      <div class="mt-head grid gap-grid lg:grid-cols-2 lg:items-start">
        <div class="relative">
          <div class="aspect-frame aspect-square border-4">
            <Picture
              {...PHOTO_FORMATS}
              src={portrait}
              alt="Sinduri smiling in a studio portrait, standing against a dark wall beside a teal block."
              widths={WIDTHS}
              sizes={TEASER_PHOTO_SIZES}
            />
          </div>
          {/* The art reaches an eighth past the tilted box; these offsets keep it in the gutter (tests/reflow.spec.ts). */}
          <Roundel class="absolute -bottom-8 right-0 sm:-right-3" />
        </div>

        <div class="card">
          <ul
            role="list"
            class:list={['card-block grid sm:grid-cols-2', statWall.wall]}
          >
            {STATS.map((stat, index) => (
              <li
                class:list={[
                  'flex min-w-0 flex-col edge p-card-tight',
                  statWall.bricks[index],
                ]}
              >
                <span class="text-display font-black">{stat.value}</span>
                <span class="label mt-2">{stat.label}</span>
              </li>
            ))}
          </ul>

          <p class="mt-8 text-body text-pretty">
            Welcome to sinduri.lol, my personal site and blog.
          </p>

          <p class="mt-head">
            <a href="/about/" class="btn-gold-secondary">
              Learn More About Me
            </a>
          </p>
        </div>
      </div>
    </Section>
  </div>

  <Section title="What I Write About" class="home-head">
    <ul
      role="list"
      class:list={[
        'card-block grid gap-grid sm:grid-cols-2 lg:grid-cols-3',
        categoryWall.wall,
      ]}
    >
      {CATEGORY_CARDS.map((card, index) => (
        <li
          class:list={[
            'card flex flex-col',
            categoryWall.bricks[index],
            index === 0 && leadSpansSm && 'sm:col-span-2',
            index === 0 && leadSpansLg && 'lg:col-span-2',
          ]}
        >
          <span
            aria-hidden="true"
            class:list={[
              'flex size-16 -rotate-3 items-center justify-center edge text-section-number font-black leading-none',
              CATEGORY_TILE,
            ]}
          >
            {card.glyph}
          </span>

          <h3 class="card-title mt-8">
            <a href={categoryHref(card.category)} class="card-link">
              {categoryLabel(card.category)}
              <span class="sr-only">&nbsp;Posts</span>
            </a>
          </h3>

          <p class="mt-4 text-body text-pretty">{card.teaser}</p>
        </li>
      ))}
    </ul>

    <p class="mt-head">
      <a href={BLOG_PATH} class="btn-secondary">
        View All Posts
      </a>
    </p>
  </Section>

  <Section title="Featured Posts" class="home-head">
    {/* Class names written out in full: Tailwind scans source text. */}
    <ul
      role="list"
      class:list={[
        'card-block grid gap-grid',
        featured.length >= FEATURED_LIMIT ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
        featuredWall.wall,
      ]}
    >
      {featured.map((post, index) => (
        <li class:list={['flex min-w-0', featuredWall.bricks[index]]}>
          <BlogCard
            {...cardProps(post)}
            coverSizes={featuredCoverSizes}
            describeCover={post.id === newest?.id}
            headingLevel={3}
            class="w-full"
          />
        </li>
      ))}
    </ul>
  </Section>

  <CloseRow
    eyebrow="Next"
    readHref="/career/"
    readLabel="Career"
    actionHref="/contact/"
    actionLabel="Get in Touch"
  />
</BaseLayout>

<script>
  import '../scripts/card-click';
  import '../scripts/hero-field';
</script>
