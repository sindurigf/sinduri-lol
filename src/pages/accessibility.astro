---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { accessibilityFacts } from '../lib/accessibility-facts';
import { CONTACT_EMAIL } from '../lib/contact';

/*
 * The public accessibility statement.
 *
 * WHY IT EXISTS. ACCESSIBILITY.md is written for the people a barrier lands
 * on, and they are not reading the repository, so the record needs a page a
 * reader can click.
 *
 * THIS PAGE IS A SUMMARY AND SAYS SO. It does not restate the file, which
 * carries measured contrast ratios for every token against every surface,
 * what is automated and what is not, and every known gap at length.
 * Reproducing that here would be a second copy to keep in step, and would
 * bury what a reader came for: what is aimed at, whether it has been reached,
 * and how to report that it has not.
 *
 * THE VOLATILE FACTS ARE DERIVED, NOT TYPED. The target, the status, the
 * review date and the two reporting routes come out of ACCESSIBILITY.md at
 * build time, so the page cannot quietly go out of date in front of the
 * readers least able to check. See src/lib/accessibility-facts.ts.
 *
 * THE COPY HERE IS NOT EDITORIAL AND DOES NOT WAIT FOR SINDURI. Every
 * sentence is a factual statement about what the project does, drawn from
 * ACCESSIBILITY.md §2, §3, §6 and §8, or functional microcopy on the
 * reporting routes. That is the line AGENTS.md draws.
 */

const { targetStandard, conformanceStatus, lastReviewed, publicReporting } =
  accessibilityFacts;

/*
 * The full record. A reader who wants the measurements rather than the
 * summary reaches it in one click, so the page ends by pointing at it rather
 * than paraphrasing further.
 */
const FULL_RECORD =
  'https://github.com/sindurigf/sinduri-lol/blob/main/ACCESSIBILITY.md';

/*
 * Taken from ACCESSIBILITY.md section 6 and deliberately not counted: a total
 * this page has no way to recount would go stale. The prose says what is
 * covered without asserting one.
 */
const AUTOMATED = [
  'axe on every route, for WCAG 2.2 A and AA and for best practice',
  'colour contrast measured against the composited background, including every result axe leaves undecided',
  'the keyboard tab order walked in both directions on every route, at 305px and 1280px, with every focus ring measured where it lands',
  'target sizes, reflow at 320px and 305px including with increased text spacing, Windows High Contrast Mode, and reduced motion',
  'navigation with JavaScript switched off',
];
---

<BaseLayout
  title="Accessibility | sinduri.lol"
  description="What this site aims for, what has been tested, what has not, and how to report a barrier."
>
  {/* The title carries a U+00AD soft hyphen after "Acces": it only paints at a line break. */}
  <PageHero title="Acces­sibility" measure="reading">
    <p class="standfirst">
      This site aims to be usable with a keyboard, a screen reader, at high
      zoom, and without JavaScript. Where it is not, that is a bug worth
      reporting.
    </p>
  </PageHero>

  <section class="band py-section">
    <div class="mx-auto max-w-page">
      <div class="mx-auto max-w-3xl">
        {/*
        The status is the most important thing on the page and is deliberately
        not softened. "No conformance claim" is the honest position while the
        manual testing is unfinished, and stating a target as though it were
        an achievement is the standard failure of these pages.
      */}
        <dl class="grid gap-grid sm:grid-cols-2">
          <div class="card">
            <dt class="label text-gold">Target</dt>
            <dd class="mt-4 text-text">{targetStandard}</dd>
          </div>
          <div class="card">
            <dt class="label text-gold">Status</dt>
            <dd class="mt-4 text-text">{conformanceStatus}</dd>
          </div>
          <div class="card">
            <dt class="label text-gold">Last reviewed</dt>
            <dd class="mt-4 text-text">
              <time datetime={lastReviewed}>{lastReviewed}</time>
            </dd>
          </div>
          <div class="card">
            <dt class="label text-gold">Scope</dt>
            <dd class="mt-4 text-text">
              Every page on this site. Sites linked from the footer are not
              covered.
            </dd>
          </div>
        </dl>

        <div class="prose mt-section">
          <h2>What is checked automatically</h2>

          <p>
            These run on every change, in Chromium, Firefox and WebKit, and a
            failure blocks the change from being merged.
          </p>

          <ul>
            {AUTOMATED.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <h2>What is not</h2>

          <p>
            Automated checks find a minority of accessibility problems. They
            cannot say whether a focus ring reads as a focus ring, whether a
            page still makes sense with motion removed, or whether a screen
            reader announces something in a useful order. Those need a person,
            and none of them has been done yet. The full record names each check
            rather than implying coverage.
          </p>

          <h2>Known gaps</h2>

          <p>
            No screen reader has been used on this site yet, so how it sounds is
            unknown, including how the uppercase headings and labels are read.
            Nobody has tested the contact form's error messages by hand, and the
            error state is not covered by the automated page checks. The writing
            has not been checked for plain language, and the gold sections have
            only been measured by machine. Each gap, and the reasoning behind
            it, is listed in full in the record below.
          </p>

          <h2>Report a barrier</h2>

          <p>
            If something here blocks you, please say so. You do not need to know
            which guideline it falls under, and you do not need to tell us
            anything about yourself. The page address and what you were trying
            to do are useful, and nothing is required.
          </p>
        </div>

        <ul class="actions mt-actions">
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="btn-secondary">
              Email {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a href={publicReporting} class="btn-secondary">
              Open an issue on GitHub
            </a>
          </li>
        </ul>

        <p class="mt-actions text-body text-text text-pretty">
          The full record, including every measured contrast ratio and every
          known gap, is kept with the source:{' '}
          <a href={FULL_RECORD}>ACCESSIBILITY.md</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
