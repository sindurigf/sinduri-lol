---
import { statSync } from 'node:fs';
import { join } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import CloseRow from '../components/CloseRow.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';

/*
 * REAL COPY, structure per design/Career.dc.html.
 *
 * Every claim below comes from one of two sources Sinduri wrote, and nothing
 * here was written for this page: the published CV, and her own post
 * src/content/blog/five-years-in-drupal.md. A CV is the most claim-dense
 * thing a personal site carries, and an invented job title is not a typo, it
 * is a false statement about a person. Three rules follow:
 *
 *   1. Change the PDF and change this page in the same commit. No test can
 *      hold the two together: tests/cv.spec.ts checks the file's metadata,
 *      not whether its sentences match these.
 *   2. Where the layout has a slot neither source fills, the slot gets fewer
 *      items rather than an invented sentence. The CV lists three roles, so
 *      EXPERIENCE has three entries.
 *   3. The page is more complete than the CV on purpose. What only the post
 *      states (the summary's second sentence, the mossbo awards, the Python
 *      course and the community roles) is marked below where it is used. The
 *      summary's last paragraph and the open source intro are her own lines,
 *      moved here from /about.
 *
 * The CV's wording otherwise, with terminal full stops added and month names
 * abbreviated to match the layout. The summary is in the first person, like
 * the rest of the site, and the hero keeps the CV's three roles; the homepage
 * heading uses the first two.
 *
 * THE CV IS PUBLISHED, and was checked for personal data first. The Canva
 * export carried the template author's name in /Author and dc:creator, the
 * template ids in /Keywords and Canva in /Producer and /Creator; all five are
 * gone, and /Lang (de-DE) over an English document is now (en).
 *
 * The visible text was decided by Sinduri. A phone number, a nationality and
 * a visa status were removed at source and the file re-exported, which is the
 * only way to remove text from a PDF: drawing over them leaves them in the
 * content stream for anyone running pdftotext. A city and an email address
 * remain deliberately, and the email is already on /contact and in the
 * footer.
 *
 * The size in the label is measured off the file rather than typed: a typed
 * number is silently wrong after the next re-export, and statSync fails the
 * build if the file goes missing, so this button cannot quietly point at a
 * 404.
 *
 * No `download` attribute, deliberately. The label says a PDF is coming;
 * whether it opens in the browser's viewer or lands in a folder is the user
 * agent's business, and the viewer is the more accessible of the two for
 * anyone who wants to read it rather than keep it.
 */
const CV_HREF = '/sinduri-guntupalli-cv.pdf';
const JOURNEY_POST_HREF = '/blog/five-years-in-drupal/';
const PUBLIC_DIR = 'public';
const BYTES_PER_KB = 1024;

// Resolved from the project root, not from `import.meta.url`. This
// frontmatter is bundled into dist/.prerender/chunks/ before it runs, so a
// path relative to the module would resolve against that directory and look
// for dist/public/. The build runs this, and it runs at the root.
const CV_KB = Math.round(
  statSync(join(process.cwd(), PUBLIC_DIR, CV_HREF)).size / BYTES_PER_KB,
);

const EXPERIENCE = [
  {
    dates: 'Jan 2026–Present',
    where: 'Dynatrace',
    title: 'Sr Developer Programs Engineer',
    current: true,
    points: [
      'Rebranded the Open Ecosystem Discourse community to OffOn, restructuring categories, navigation, and gamification based on community metrics analysis to drive contributor engagement.',
      'Built offon.dev, a React static site serving as the landing site for the OffOn community.',
      'Built AI-powered automation tools and workflows to support community operations, including content generation, community digest creation, and metrics reporting.',
    ],
  },
  {
    dates: 'Jun 2023–Nov 2025',
    where: 'drunomics',
    title: 'Product Manager',
    current: false,
    points: [
      'Managed the development and launch of mossbo, a fully managed cloud CMS with AI-powered tools, coordinating a cross-functional team of developers, designers, and marketers.',
      'Developed and documented clear product lifecycle processes in collaboration with management.',
      'Worked closely with clients and developers to clarify requirements, prioritise tasks, and ensure smooth project delivery.',
      'Contributed to automated testing using Playwright and frontend development with Nuxt and Tailwind to ensure consistent product quality.',
      'Managed the end-to-end launch of four projects on mossbo, overseeing requirements, timelines, and stakeholder communication, and created documentation to support each project launch.',
      // From the journey post, not the CV.
      'mossbo collected multiple awards in 2025.',
    ],
  },
  {
    dates: 'Jan 2021–May 2023',
    where: 'Jobiqo',
    title: 'Software Developer & Configuration Manager',
    current: false,
    points: [
      'Developed and maintained Drupal-based job board websites, handling both backend and frontend development tasks.',
      'Led the UI and frontend implementation for a client job board website relaunch on Drupal.',
      'Configured and integrated Google APIs, Analytics, Tag Manager, Search Console, social logins, and the Usercentrics CMP with client websites, monitoring SEO performance to minimise issues and drive ongoing optimisation.',
    ],
  },
] as const;

const SKILLS = [
  'Product and program management',
  'Web development',
  'Configuration management',
  'Web analytics',
  'SEO',
  'Community and ecosystem management',
] as const;

/*
 * `honour` is Latin and renders inside `lang="la"` (SC 3.1.2), so a screen
 * reader does not apply English pronunciation rules to it. "Summa cum laude"
 * is arguably English, since dictionaries list it, and is marked anyway
 * rather than leaving pronunciation to that argument.
 */
const EDUCATION = [
  {
    award: 'Java',
    detail: 'Code Factory, Austria, 2020.',
    honour: 'Summa cum laude',
  },
  {
    award: 'Full Stack Web Development',
    detail:
      'Code Factory, Austria, 2019. HTML, CSS, JS, Bootstrap, TypeScript, Angular, PHP, Symfony, MySQL.',
    honour: 'Summa cum laude',
  },
  // From the journey post, not the CV, which names no school for it.
  { award: 'Python', detail: 'Short course, 2019.' },
  {
    award: 'Environmental Engineering, Master of Science',
    detail: 'University of Alabama, Tuscaloosa, USA, 2006–2009. 3.44/4.00.',
  },
  {
    award: 'Civil Engineering, Bachelor of Engineering',
    detail: 'Andhra University, India, 2001–2005. 64%.',
  },
] as const;

const LANGUAGES = [
  { language: 'English', level: 'Fluent' },
  { language: 'German', level: 'A2' },
] as const;

// The award is on the CV; its event and the community roles are from the post.
const OPEN_SOURCE = [
  {
    award: 'Women in Drupal Award',
    detail: 'Build category, DrupalCon Vienna, 2025.',
  },
  {
    award: 'Drupal Austria',
    detail:
      'Elected to the board as marketing manager. Deputy marketing manager in 2026.',
  },
  {
    award: 'Drupal Switzerland',
    detail:
      'Active in the Swiss community, which taught me so much about events.',
  },
  {
    award: 'Event organising',
    detail:
      'Volunteered at Drupal Dev Days Vienna in 2023, then helped organise Drupal Mountain Camp, Drupal Dev Days and DrupalCamp Berlin.',
  },
] as const;
---

<BaseLayout
  title="Career | sinduri.lol"
  description="Sinduri Guntupalli: work history, education and skills, from Drupal development to product management and developer programs, with a CV to download."
>
  <PageHero title="Career">
    <h2 class="standfirst">
      <span class="block text-text">Open Source Enthusiast.</span>{' '}
      <span class="block text-muted">Positivity Advocate.</span>{' '}
      <span class="block text-muted">Continuous Learner.</span>
    </h2>

    {/*
      The primary label names the format and the size, because the button
      hands over a file rather than moving between pages and neither fact is
      recoverable from "Download my CV" alone. Both buttons render uppercase,
      so PDF and KB read as the acronyms they are.
    */}
    <p class="actions mt-actions">
      <a href={CV_HREF} class="btn-primary">
        Download my CV (PDF, {CV_KB} KB)
      </a>
      <a href="/contact/" class="btn-secondary">
        Get in touch
      </a>
    </p>
  </PageHero>

  <Section title="Summary">
    <p slot="lead" class="lead max-w-3xl">
      I am passionate about open source and actively involved in the Drupal
      community. My developer background helps me every single day: it helps me
      create realistic timelines, improve communication between stakeholders and
      engineering, and understand what developers actually need to be
      successful.
    </p>
    <p class="max-w-3xl text-body text-muted text-pretty">
      I never say no to a challenge just because I do not know how to approach
      it. I commit to figuring it out and learning whatever it takes to make it
      work.
    </p>
  </Section>

  <Section title="Work experience">
    <ol class="flex flex-col gap-grid">
      {
        /*
         * The role's title comes first, in the markup and on screen, so
         * someone moving through the page by heading does not land on a
         * role with its employer already behind them. From `lg` the title
         * spans the card, with the dates and employer in the first column
         * under it and the points in the other three.
         *
         * The current role is the section's one pink card, and says so in
         * words with a chip, so colour is never the only signal (SC 1.4.1).
         */
        EXPERIENCE.map((role) => (
          <li
            class:list={[
              'card grid gap-8 lg:grid-cols-4',
              role.current ? 'shadow-hard-pink-8' : 'shadow-hard-gold-8',
            ]}
          >
            <div class="flex min-w-0 flex-col items-start gap-4 lg:col-span-4">
              {role.current && <span class="chip">Current</span>}
              <h3 class="card-title">{role.title}</h3>
            </div>

            <p class="flex min-w-0 flex-col gap-2">
              <span class="label text-gold">{role.dates}</span>
              <span class="label text-subtle">{role.where}</span>
            </p>

            <ul class="bullet-list min-w-0 lg:col-span-3">
              {role.points.map((point) => (
                <li class="mt-3 text-body text-pretty first:mt-0">{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section title="Skills and education">
    <div class="grid gap-grid lg:grid-cols-2">
      <div class="card shadow-hard-gold-8">
        <h3 class="card-title">Education</h3>
        <ul class="mt-8 flex flex-col gap-4">
          {EDUCATION.map((item) => (
            <li class="text-body text-muted text-pretty">
              <strong class="font-extrabold text-text">{item.award}</strong>
              {': '}
              {item.detail}
              {'honour' in item ? (
                <>
                  {' '}
                  <span lang="la">{item.honour}</span>.
                </>
              ) : null}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex min-w-0 flex-col gap-grid">
        <div class="card shadow-hard-gold-8">
          <h3 class="card-title">Skills</h3>
          <ul class="mt-8 flex flex-wrap gap-3">
            {SKILLS.map((skill) => (
              <li class="chip">{skill}</li>
            ))}
          </ul>
        </div>

        <div class="card shadow-hard-gold-8">
          <h3 class="card-title">Languages</h3>
          <ul class="mt-8 flex flex-col gap-4">
            {LANGUAGES.map((item) => (
              <li class="text-body text-muted">
                <strong class="font-extrabold text-text">
                  {item.language}
                </strong>
                {': '}
                {item.level}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section title="Open source">
    {/*
      The intro beside the facts rather than above them, so the section fills
      the column instead of running down its left half. The award is this
      section's one pink card.
    */}
    <div class="grid gap-grid lg:grid-cols-12 lg:items-start">
      <p class="lead mt-0 lg:col-span-5">
        What I love about open source is that people contribute based on passion
        and expertise, not hierarchy. There is room for everyone.
      </p>
      <dl class="grid gap-grid sm:grid-cols-2 lg:col-span-7">
        {OPEN_SOURCE.map((item, index) => (
          <div
            class:list={[
              'card',
              index === 0 ? 'shadow-hard-pink-8' : 'shadow-hard-gold-8',
            ]}
          >
            <dt class="label-wide text-gold">{item.award}</dt>
            <dd class="mt-4 text-body text-muted text-pretty">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>

    <CloseRow
      readHref={JOURNEY_POST_HREF}
      readLabel="Five years in Drupal"
      actionHref="/about/"
      actionLabel="Learn more about me"
    />
  </Section>
</BaseLayout>
