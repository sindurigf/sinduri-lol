---
import { Image } from 'astro:assets';
import badgeDark from '../assets/badge-dark.png';
import { statSync } from 'node:fs';
import { join } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * REAL COPY, structure per design/Career.dc.html.
 *
 * Every claim below is transcribed from the published CV and nothing here was
 * written for it. A CV is the most claim-dense thing a personal site carries,
 * and an invented job title is not a typo, it is a false statement about a
 * person. Two rules follow:
 *
 *   1. Change the PDF and change this page in the same commit. No test can
 *      hold the two together: tests/cv.spec.ts checks the file's metadata,
 *      not whether its sentences match these.
 *   2. Where the layout has a slot the CV has nothing for, the slot gets
 *      fewer items rather than an invented sentence. The CV lists three
 *      roles, so EXPERIENCE has three entries.
 *
 * The one entry not lifted verbatim is OFFON under OPEN_SOURCE, assembled
 * from two facts the CV states separately under Dynatrace. Everything else is
 * the CV's wording, with terminal full stops added and month names
 * abbreviated to match the layout.
 *
 * THE GOLD SURFACE. Everything inside the hero below is governed by
 * `.surface-gold`, and NOTHING in it may reach for a dark-surface token:
 * `text`, `muted`, `subtle`, `border`, `pink`, `pink-text` and `cyan` measure
 * 1.27, 1.03, 1.31, 2.34, 2.31, 1.48 and 1.01 against #FFC000, and an
 * explicit utility beats the class's subtree default, so the cascade cannot
 * stop it. tests/gold-surface.spec.ts measures the rendered result. Two
 * consequences are visible in the markup:
 *
 *   - The section number is NOT `.section-number`, which is `text-pink-text`
 *     at 1.48 on gold. It is `text-gold-muted`, 7.88.
 *   - The buttons are the gold pair. `.btn-primary` is `bg-gold`, a 1.00:1
 *     fill here: an invisible control whose label still passes every
 *     automated contrast rule.
 *
 * THE CV IS PUBLISHED, and was checked for personal data first. The Canva
 * export carried the template author's name in /Author and dc:creator, the
 * template ids in /Keywords and Canva in /Producer and /Creator; all five are
 * gone, and /Lang (de-DE) over an English document is now (en).
 *
 * The visible text was decided by Sinduri. A phone number, a nationality and
 * a visa status were removed at source and the file re-exported, which is the
 * only way to remove text from a PDF: drawing over them leaves them in the
 * content stream for anyone running pdftotext. A city and an email address
 * remain deliberately, and the email is already on /contact and in the
 * footer.
 *
 * The size in the label is measured off the file rather than typed: a typed
 * number is silently wrong after the next re-export, and statSync fails the
 * build if the file goes missing, so this button cannot quietly point at a
 * 404.
 *
 * No `download` attribute, deliberately. The label says a PDF is coming;
 * whether it opens in the browser's viewer or lands in a folder is the user
 * agent's business, and the viewer is the more accessible of the two for
 * anyone who wants to read it rather than keep it.
 */
const CV_HREF = '/sinduri-guntupalli-cv.pdf';
const PUBLIC_DIR = 'public';
const BYTES_PER_KB = 1024;

// Resolved from the project root, not from `import.meta.url`. This
// frontmatter is bundled into dist/.prerender/chunks/ before it runs, so a
// path relative to the module would resolve against that directory and look
// for dist/public/. The build runs this, and it runs at the root.
const CV_KB = Math.round(
  statSync(join(process.cwd(), PUBLIC_DIR, CV_HREF)).size / BYTES_PER_KB,
);

const EXPERIENCE = [
  {
    dates: 'Jan 2026 — Present',
    where: 'Dynatrace',
    title: 'Sr Developer Programs Engineer',
    frame: 'border-gold',
    datesClass: 'text-gold',
    background: 'bg-surface',
    points: [
      'Rebranded the Open Ecosystem Discourse community to OffOn, restructuring categories, navigation, and gamification based on community metrics analysis to drive contributor engagement.',
      'Built offon.dev, a React static site serving as the landing site for the OffOn community.',
      'Built AI-powered automation tools and workflows to support community operations, including content generation, community digest creation, and metrics reporting.',
    ],
  },
  {
    dates: 'Jun 2023 — Nov 2025',
    where: 'drunomics',
    title: 'Product Manager',
    frame: 'border-border',
    datesClass: 'text-cyan',
    background: 'bg-surface',
    points: [
      'Managed the development and launch of mossbo, a fully managed cloud CMS with AI-powered tools, coordinating a cross-functional team of developers, designers, and marketers.',
      'Developed and documented clear product lifecycle processes in collaboration with management.',
      'Worked closely with clients and developers to clarify requirements, prioritise tasks, and ensure smooth project delivery.',
      'Contributed to automated testing using Playwright and frontend development with Nuxt and Tailwind to ensure consistent product quality.',
      'Managed the end-to-end launch of four projects on mossbo, overseeing requirements, timelines, and stakeholder communication, and created documentation to support each project launch.',
    ],
  },
  {
    dates: 'Jan 2021 — May 2023',
    where: 'Jobiqo',
    title: 'Software Developer & Configuration Manager',
    frame: 'border-border',
    datesClass: 'text-pink-text',
    background: 'bg-surface',
    points: [
      'Developed and maintained Drupal-based job board websites, handling both backend and frontend development tasks.',
      'Led the UI and frontend implementation for a client job board website relaunch on Drupal.',
      'Configured and integrated Google APIs, Analytics, Tag Manager, Search Console, social logins, and the Usercentrics CMP with client websites, monitoring SEO performance to minimise issues and drive ongoing optimisation.',
    ],
  },
] as const;

const SKILLS = [
  'Product and program management',
  'Web development',
  'Configuration management',
  'Web analytics',
  'SEO',
  'Community and ecosystem management',
] as const;

/*
 * `honour` is Latin and renders inside `lang="la"` (SC 3.1.2), so a screen
 * reader does not apply English pronunciation rules to it. "Summa cum laude"
 * is arguably English, since dictionaries list it, and is marked anyway
 * rather than leaving pronunciation to that argument.
 */
const EDUCATION = [
  {
    award: 'Java',
    detail: 'Code Factory, Austria, 2020.',
    honour: 'Summa cum laude',
  },
  {
    award: 'Full Stack Web Development',
    detail: 'Code Factory, Austria, 2019.',
    honour: 'Summa cum laude',
  },
  {
    award: 'Environmental Engineering, Master of Science',
    detail: 'University of Alabama, Tuscaloosa, USA, 2006–2009. 3.44/4.00.',
  },
  {
    award: 'Civil Engineering, Bachelor of Engineering',
    detail: 'Andhra University, India, 2001–2005. 64%.',
  },
] as const;

const OPEN_SOURCE = [
  { award: 'Women in Drupal Award (Build)', detail: '2025.' },
  { award: 'Drupal', detail: 'Active involvement in the Drupal community.' },
  {
    award: 'OffOn',
    detail:
      'The Open Ecosystem community, rebranded from Discourse, with offon.dev as its landing site.',
  },
] as const;
---

<BaseLayout
  title="Career | sinduri.lol"
  description="Product and program management, web development, and community and ecosystem management, with active involvement in the Drupal community."
>
  {/* ===================================================================
       HERO: THE GOLD SURFACE
       =================================================================== */}
  <section class="surface-gold band relative overflow-hidden py-24">
    {/*
      alt="" and decorative. At 0.09 opacity this is a texture; see
      .career-watermark in global.css for the placement and for why the -dark
      asset is the right one on this ground.

      The width and height attributes are the intrinsic pixel size, so the
      browser reserves the box before the image loads; the CSS width wins.

      loading="eager", overriding <Image>'s lazy default: it is in the first
      viewport on every load of this route.
    */}
    <Image class="career-watermark" src={badgeDark} alt="" loading="eager" />

    <div class="relative z-10 mx-auto max-w-page">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        {/*
          Not `.section-number`: that class is text-pink-text, 1.48 against
          this ground. gold-muted is 7.88.
        */}
        <span
          class="text-section-number font-extrabold text-gold-muted"
          aria-hidden="true"
        >
          03
        </span>
        <h1 class="text-h1">Career</h1>
      </div>

      <h2 class="mt-8 text-h3">
        <span class="block">Open Source Enthusiast.</span>{' '}
        <span class="block text-gold-muted">
          Positivity Advocate. Continuous Learner.
        </span>
      </h2>

      <p class="mt-8 max-w-2xl text-body text-gold-muted text-pretty">
        Experienced in product and program management, web development,
        configuration management, web analytics, SEO, and community and
        ecosystem management.
      </p>

      {/*
        Both buttons are the gold-surface pair, scoped to .surface-gold, so
        either one used elsewhere renders unstyled. Neither .btn-primary nor
        .btn-secondary may appear on this ground.

        The primary label names the format and the size, because the button
        hands over a file rather than moving between pages and neither fact is
        recoverable from "Download my CV" alone. Both buttons render
        uppercase, so PDF and KB read as the acronyms they are.
      */}
      <p class="mt-10 flex flex-wrap gap-4">
        <a href={CV_HREF} class="btn-gold-primary">
          Download my CV (PDF, {CV_KB} KB)
        </a>
        <a href="/contact/" class="btn-gold-secondary">
          Get in touch
        </a>
      </p>
    </div>
  </section>

  {/* ===================================================================
       SUMMARY: back to the dark token set
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-gold"></span>
    </div>

    <div class="mx-auto max-w-page">
      <h2 class="text-h2 text-text">Summary</h2>
      <p class="mt-8 max-w-3xl text-body text-muted text-pretty">
        Passionate about open source with active involvement in the Drupal
        community. Known for strong organisational skills, clear communication,
        and efficient delivery across full product lifecycles and
        cross-functional teams.
      </p>
    </div>
  </section>

  {/* ===================================================================
       WORK EXPERIENCE
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-cyan"></span>
    </div>

    <div class="mx-auto max-w-page">
      <h2 class="text-h2 text-text">Work experience</h2>

      <ol class="mt-14 flex flex-col gap-10">
        {
          /*
           * The role's title comes first, in the markup and on screen, so
           * someone moving through the page by heading does not land on a
           * role with its employer already behind them. From `lg` the title
           * spans the card, with the dates and employer in the first column
           * under it and the points in the other three.
           */
          EXPERIENCE.map((role) => (
            <li
              class:list={[
                'card grid gap-8 lg:grid-cols-4',
                role.frame,
                role.background,
              ]}
            >
              <h3 class="min-w-0 text-h3 text-text lg:col-span-4">
                {role.title}
              </h3>

              <p class="flex min-w-0 flex-col gap-2">
                <span class:list={['label', role.datesClass]}>
                  {role.dates}
                </span>
                <span class="label text-subtle">{role.where}</span>
              </p>

              <ul class="min-w-0 list-disc pl-6 text-muted marker:text-gold lg:col-span-3">
                {role.points.map((point) => (
                  <li class="mt-3 text-body text-pretty first:mt-0">{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ===================================================================
       SKILLS AND EDUCATION
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-pink"></span>
    </div>

    <div class="mx-auto grid max-w-page gap-10 lg:grid-cols-2">
      <div class="card shadow-hard-cyan-8">
        <h2 class="text-h3 text-text">Education</h2>
        <ul class="mt-8 flex flex-col gap-4">
          {EDUCATION.map((item) => (
            <li class="text-body text-muted text-pretty">
              <strong class="font-extrabold text-cyan">{item.award}</strong>
              {' — '}
              {item.detail}
              {'honour' in item ? (
                <>
                  {' '}
                  <span lang="la">{item.honour}</span>.
                </>
              ) : null}
            </li>
          ))}
        </ul>
      </div>

      <div class="card shadow-hard-gold-8">
        <h2 class="text-h3 text-text">Skills</h2>
        <ul class="mt-8 flex flex-wrap gap-3">
          {SKILLS.map((skill) => (
            <li class="label border-4 border-border px-4 py-2 text-text">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ===================================================================
       OPEN SOURCE
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-gold"></span>
    </div>

    <div class="mx-auto max-w-page">
      <h2 class="text-h2 text-text">Open source</h2>
      <ul class="mt-12 flex max-w-3xl flex-col gap-6">
        {OPEN_SOURCE.map((item) => (
          <li class="text-body text-muted text-pretty">
            <strong class="font-extrabold text-gold">{item.award}</strong>
            {' — '}
            {item.detail}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
