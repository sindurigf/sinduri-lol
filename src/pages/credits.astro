---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/contact';
import {
  ENCOURAGEMENT,
  JOURNEY_SONG,
  NAME_INSPIRATION,
  PHOTOGRAPHERS,
} from '../lib/credits';

/*
 * Who made what on this site. The site name story is Sinduri's own words and
 * leads the page, because she wanted it somewhere visible; everything below
 * it is factual attribution read from src/lib/credits.ts, the same list the
 * photo captions in posts link from.
 *
 * A list item that is nothing but a link gets `min-h-target`: the SC 2.5.8
 * inline exception does not reach a link with no sentence around it.
 */

const JOURNEY_POST_HREF = '/blog/five-years-in-drupal/';

const BUILT_WITH = [
  { name: 'Astro', href: 'https://astro.build/' },
  { name: 'Vue', href: 'https://vuejs.org/' },
  { name: 'Tailwind CSS', href: 'https://tailwindcss.com/' },
  { name: 'Lexend', href: 'https://www.lexend.com/' },
  { name: 'Cloudflare Workers', href: 'https://workers.cloudflare.com/' },
] as const;

const DESIGNED_WITH = [
  {
    name: 'Stitch',
    href: 'https://stitch.withgoogle.com/',
    role: 'for design',
  },
  {
    name: 'Claude Design',
    href: 'https://claude.com/product/design',
    role: 'for refinement',
  },
] as const;

const photographers = Object.entries(PHOTOGRAPHERS).map(([name, href]) => ({
  name,
  href,
}));

const LINK_ITEM = 'inline-flex min-h-target items-center';
---

<BaseLayout
  title="Credits | sinduri.lol"
  description="Where the name sinduri.lol comes from, who took the photos, and what the site was designed and built with."
>
  <section class="band py-16">
    <div class="mx-auto max-w-page">
      <h1 class="text-h1 text-gold">Credits</h1>

      <div class="mt-12 grid gap-12 lg:grid-cols-2">
        <div class="card shadow-hard-pink-8">
          <p class="label-wide text-pink-text">Where the name comes from</p>
          <p class="mt-6 text-h3 font-bold text-text text-pretty">
            The inspiration for the name came from{' '}
            <a href={NAME_INSPIRATION.href}>{NAME_INSPIRATION.site}</a>, the
            website of my fellow Drupalist and friend {NAME_INSPIRATION.name}.
          </p>
          <p class="mt-6 max-w-prose text-body text-muted text-pretty">
            I loved it so much that I used the same pattern for this site and
            even my email address,{' '}
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Thank you,
            Norman!
          </p>
        </div>

        <div class="card shadow-hard-cyan-8">
          <p class="label-wide text-cyan">Thank you</p>
          <p class="mt-6 text-h3 font-bold text-text text-pretty">
            Thank you to <a href={ENCOURAGEMENT.href}>{ENCOURAGEMENT.name}</a>{' '}
            for sharing about Stitch and encouraging me to actually build this
            website.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band pb-24">
    <div class="mx-auto grid max-w-page gap-12 lg:grid-cols-2">
      <div class="card shadow-hard-gold-8">
        <h2 class="text-h3 text-gold">Photos</h2>

        <p class="mt-4 text-body text-muted text-pretty">
          Photos on this site and in its posts are by:
        </p>

        <ul class="mt-4 grid list-disc gap-x-10 pl-6 text-muted marker:text-gold sm:grid-cols-2">
          {photographers.map((photographer) => (
            <li>
              <a href={photographer.href} class={LINK_ITEM}>
                {photographer.name}
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-4 text-body text-muted text-pretty">And more.</p>
      </div>

      <div class="card shadow-hard-pink-8">
        <h2 class="text-h3 text-pink-text">Design tools</h2>

        <ul class="mt-4 list-disc pl-6 text-body text-muted marker:text-gold">
          {DESIGNED_WITH.map((tool) => (
            <li class="mt-3">
              <a href={tool.href}>{tool.name}</a> {tool.role}
            </li>
          ))}
          <li class="mt-3">
            Multiple artists on Fiverr and Upwork created and cleaned the logo
          </li>
        </ul>
      </div>

      <div class="card shadow-hard-cyan-8">
        <h2 class="text-h3 text-cyan">Music</h2>

        <p class="mt-4 text-body text-muted text-pretty">
          The video in <a href={JOURNEY_POST_HREF}>Five years in Drupal</a> is
          set to {JOURNEY_SONG.title} by {JOURNEY_SONG.artist}.
        </p>
      </div>

      <div class="card shadow-hard-gold-8">
        <h2 class="text-h3 text-gold">Built with</h2>

        <ul class="mt-4 grid list-disc gap-x-10 pl-6 text-muted marker:text-gold sm:grid-cols-2">
          {BUILT_WITH.map((tool) => (
            <li>
              <a href={tool.href} class={LINK_ITEM}>
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
