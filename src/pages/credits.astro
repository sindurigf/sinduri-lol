---
import Abbr from '../components/Abbr.astro';
import CloseRow from '../components/CloseRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/contact';
import {
  LICENSED_PHOTOS,
  NAME_INSPIRATION,
  PHOTOGRAPHERS,
  SCREENSHOT_SOURCES,
  THANKS,
} from '../lib/credits';
import { wallClasses } from '../lib/wall';

/* Keep in step with package.json, wrangler.jsonc, src/assets/social-icons.svg and AI_DISCLOSURE.md. */
const BUILT_WITH = [
  { name: 'Astro', href: 'https://astro.build/' },
  { name: 'Vue', href: 'https://vuejs.org/' },
  { name: 'Tailwind CSS', href: 'https://tailwindcss.com/' },
  { name: 'Lexend', href: 'https://www.lexend.com/' },
  { name: 'Fontsource', href: 'https://fontsource.org/' },
  { name: 'Simple Icons', href: 'https://simpleicons.org/' },
  { name: 'Cloudflare Workers', href: 'https://workers.cloudflare.com/' },
  { name: 'Cloudflare D1', href: 'https://developers.cloudflare.com/d1/' },
  {
    name: 'Cloudflare Email Routing',
    href: 'https://developers.cloudflare.com/email-routing/',
  },
  { name: 'Umami', href: 'https://umami.is/' },
  { name: 'Playwright', href: 'https://playwright.dev/' },
  { name: 'axe-core', href: 'https://github.com/dequelabs/axe-core' },
  { name: 'Claude Code', href: 'https://claude.com/product/claude-code' },
] as const;

const DESIGNED_WITH = [
  {
    name: 'Stitch',
    href: 'https://stitch.withgoogle.com/',
    role: 'For design',
  },
  {
    name: 'Claude Design',
    href: 'https://claude.com/product/design',
    role: 'For refinement',
  },
  {
    name: 'Canva',
    href: 'https://www.canva.com/',
    role: 'For the rabbit and cat drawings',
  },
  {
    name: 'Potrace',
    href: 'https://potrace.sourceforge.net/',
    role: 'For tracing the rabbit',
  },
] as const;

const GUIDES = [
  {
    name: 'ACCESSIBILITY.md',
    href: 'https://github.com/mgifford/ACCESSIBILITY.md',
    author: { name: 'Mike Gifford', href: 'https://ox.ca/' },
    use: "Thank you for posting about ACCESSIBILITY.md, and for sharing so many resources that make websites more accessible. It is a good place to learn how to declare what a project does for accessibility. The ACCESSIBILITY.md file in this site's source code follows this format.",
  },
  {
    name: 'The Website Specification',
    href: 'https://specification.website/',
    author: { name: 'Joost de Valk', href: 'https://joost.blog/' },
    use: 'A checklist anyone can use to check a website for search engine optimization and security, and how well automated assistants can read it. It made checking this site much easier. Thank you!',
  },
  {
    name: 'A11Y.md',
    href: 'https://github.com/fecarrico/A11Y.md',
    author: {
      name: 'Felipe A. Carriço',
      href: 'https://www.linkedin.com/in/fecarrico',
    },
    use: 'From A11Y.md you can learn that axe, an automated accessibility checker, has some Web Content Accessibility Guidelines rules switched off by default. This site turns them on. It also follows two more principles from A11Y.md: every choice between conflicting access needs is recorded, and no content is held back behind a script. Thank you, Felipe!',
  },
  {
    name: 'Upstream First',
    href: 'https://github.com/mgifford/upstream-first',
    author: {
      name: 'Upstream First contributors',
      href: 'https://github.com/mgifford/upstream-first/graphs/contributors',
    },
    use: "Upstream First explains why a bug should go back to the people who can fix it for everyone, and it has a template for reporting one. On this site, a workaround for a browser bug links the browser's own bug report. Thank you to everyone who contributes to it.",
  },
  {
    name: 'Spec-First Coding',
    href: 'https://github.com/LaurenceRLewis/a11y-spec-first-skill',
    author: {
      name: 'Laurence Lewis',
      href: 'https://github.com/LaurenceRLewis',
    },
    use: 'This makes coding assistants cite the specification before they write any code, which is a good lesson for people too. This site treats the Web Content Accessibility Guidelines and the specifications behind them as the rule, their Understanding documents as the explanation, and everything else as opinion. Thank you for sharing it.',
  },
  {
    name: 'Intopia Web Accessibility Skill',
    href: 'https://github.com/Intopia/intopia-web-accessibility-skill',
    author: { name: 'Intopia', href: 'https://www.intopia.digital/' },
    use: 'This skill comes with scripts that blend a see-through color with the color behind it before measuring contrast. Its guide to zoomed-in pages covers a window 256px tall. This site tests both ideas. Thank you for sharing them.',
  },
  {
    name: 'accessibility-skills',
    href: 'https://github.com/mgifford/accessibility-skills',
    author: { name: 'Mike Gifford', href: 'https://ox.ca/' },
    use: 'Thank you, Mike, for another helpful one! Its navigation, touch and speech recognition skills show how to test a website with voice control. The voice control check in the manual tests of this site builds on them.',
  },
  {
    name: 'Accessibility Agents',
    href: 'https://github.com/Community-Access/accessibility-agents',
    author: {
      name: 'Taylor Arndt, Jeff Bishop and contributors',
      href: 'https://github.com/Community-Access/accessibility-agents/graphs/contributors',
    },
    use: 'The cognitive accessibility skill in this set has good ideas on plain language and error messages. The writing rules of this site borrow from them. Thank you to Taylor, Jeff and everyone who contributes.',
  },
  {
    name: 'GOV.UK Design System',
    href: 'https://design-system.service.gov.uk/',
    author: {
      name: 'Government Digital Service',
      href: 'https://www.gov.uk/government/organisations/government-digital-service',
    },
    use: 'Its patterns for names, email addresses and error messages shaped the contact form of this site, from the error summary to the page title when something goes wrong. Thank you for making them public.',
  },
  {
    name: 'OWASP Secure Headers Project',
    href: 'https://owasp.org/www-project-secure-headers/',
    author: { name: 'OWASP Foundation', href: 'https://owasp.org/' },
    use: 'It lists the security headers a website should send and explains each one. This site follows it and switches off every browser feature it does not use. Thank you!',
  },
  {
    name: 'Understanding WCAG 2.2',
    href: 'https://www.w3.org/WAI/WCAG22/Understanding/',
    author: {
      name: 'W3C Web Accessibility Initiative',
      href: 'https://www.w3.org/WAI/',
    },
    use: 'These documents explain what each success criterion means and how to meet it. When a rule was unclear, this is where I checked. Thank you to everyone at the W3C who writes them.',
  },
  {
    name: 'Google Search Central',
    href: 'https://developers.google.com/search',
    author: { name: 'Google', href: 'https://developers.google.com/' },
    use: 'Its guides explain canonical links, robots rules, sitemaps and structured data. This site follows them so search engines show each page correctly. Thank you.',
  },
  {
    name: '“Fixing” Lists',
    href: 'https://www.scottohara.me/blog/2019/01/12/lists-and-safari.html',
    author: { name: "Scott O'Hara", href: 'https://www.scottohara.me/' },
    use: 'His article explains why Safari stops announcing a list once its bullets are removed, and how to fix it. Lists on this site stay lists for screen readers. Thank you, Scott!',
  },
  {
    name: 'Inclusive Components',
    href: 'https://inclusive-components.design/',
    author: { name: 'Heydon Pickering', href: 'https://heydonworks.com/' },
    use: 'Its card pattern shows how a whole card can open a post while its text stays selectable. The blog cards on this site work this way. Thank you, Heydon!',
  },
  {
    name: 'Adrian Roselli on Dark Mode',
    href: 'https://x.com/aardrian/status/1385210854715629569',
    author: { name: 'Adrian Roselli', href: 'https://adrianroselli.com/' },
    use: 'His post on dark mode points out that a theme switch needs three options, not two. The theme menu on this site offers System, Light and Dark because of it. Thank you, Adrian!',
  },
] as const;

/* Keep in step with AI_DISCLOSURE.md "At runtime". */
const MADE_WITH_AI = [
  { name: 'The hopping bunny on the homepage', href: '/' },
  { name: 'The About cats and their control and trick icons', href: '/about/' },
  {
    name: 'The sticker bunny in the footer and on the 404 page, and the jumping bunny in the logo, roundel, site icons and share images',
    href: '/',
  },
  {
    name: 'The line bunny on the /about tile',
    href: '/about/',
  },
] as const;

const AI_DISCLOSURE =
  'https://github.com/sindurigf/sinduri-lol/blob/main/AI_DISCLOSURE.md';

const photographers = Object.entries(PHOTOGRAPHERS).map(([name, href]) => ({
  name,
  href,
}));

/* `min-h-target` and `min-w-target`: the SC 2.5.5 inline exception does not cover a bare link. */
const LINK_ITEM = 'link inline-flex min-h-target min-w-target items-center';
const CARD_HEADING = 'text-h2 text-text';

const NAMED_LIST = 'mt-6 grid gap-4';
/* `min-w-0`: otherwise "ACCESSIBILITY.md" under SC 1.4.12 spacing overflows its grid track at 305px. */
const NAMED_ENTRY = 'min-w-0 bg-background p-card-tight';

/* `lg:grid-cols-12` and spans: the 3/9 split; one column below `lg`. */
const GUIDE_ROW = 'lg:grid lg:grid-cols-12 lg:gap-x-grid';

const PEOPLE_WALL = wallClasses({}, 2);
/* Design Tools, Built and Tested With, The 404 Page, The Rabbit Hole, Made with AI. */
const TOOLS_WALL = wallClasses({ lg: [[0, 1], [2], [3], [4]] }, 5);
---

<BaseLayout
  title="Credits"
  description="Where the name sinduri.lol comes from, who helped, who took the photos and what the site was designed, built and tested with."
>
  <PageHero title="Credits">
    <p class="standfirst">
      Thank you to the people who had a part in this site, and to everyone
      behind the tools and open source projects this site is built with.
    </p>
  </PageHero>

  <section class="band py-section">
    <div class="card-block mx-auto max-w-page">
      <div id="name" class:list={['card', PEOPLE_WALL.bricks[0]]}>
        <h2 class={CARD_HEADING}>Where the Name Comes From</h2>
        <p class="mt-6 mb-paragraph max-w-4xl text-lead font-normal text-text text-pretty">
          The inspiration for the name came from{' '}
          <a href={NAME_INSPIRATION.href}>{NAME_INSPIRATION.site}</a>, the
          website of my fellow Drupalist and friend {NAME_INSPIRATION.name}.
        </p>
        <p class="mt-6 max-w-measure text-body text-text text-pretty">
          I loved it so much that I used the same pattern for this site and even
          my email address, <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>. Thank
          you, Norman!
        </p>
        <p class="mt-8">
          <a href="/about/#lepus-ridet" class="chip">
            {/* One child, so the flex container keeps the space. */}
            <span>
              Why <span lang="la">Lepus Ridet</span>
            </span>
          </a>
        </p>
      </div>

      <div class:list={['card', PEOPLE_WALL.bricks[1]]}>
        <h2 class={CARD_HEADING}>Thank You</h2>
        <dl class:list={[NAMED_LIST, 'md:grid-cols-2']}>
          {THANKS.map((person) => (
            <div class={NAMED_ENTRY}>
              <dt class="text-body font-black">
                <a href={person.href} class={LINK_ITEM}>
                  {person.name}
                </a>
              </dt>
              <dd class="mt-1 max-w-measure text-body text-text text-pretty">
                {person.reason}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="band pb-section">
    <div class="card-block mx-auto max-w-page">
      <div class="card">
        <h2 class={CARD_HEADING}>Guides</h2>

        <dl class={NAMED_LIST}>
          {GUIDES.map((guide) => (
            <div class:list={[NAMED_ENTRY, GUIDE_ROW]}>
              <dt class="min-w-0 text-body font-black lg:col-span-3">
                <a href={guide.href} class={LINK_ITEM}>
                  {guide.name}
                </a>
              </dt>
              <dd class="mt-1 min-w-0 max-w-measure text-body text-text text-pretty lg:col-span-9 lg:mt-0">
                By <a href={guide.author.href}>{guide.author.name}</a>.{' '}
                {guide.use}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="band pb-section">
    <div class="card-block mx-auto max-w-page">
      <div class="card">
        <h2 class={CARD_HEADING}>Photos</h2>

        <p class="mt-6 text-body text-text text-pretty">
          Photos on this site and in its posts are by:
        </p>

        {/* Grid, not `columns`, here and below: WebKit does not scroll a focused inline-flex link in a multi-column box into view (SC 2.4.11). */}
        <ul class="bullet-list mt-4 gap-x-12 sm:grid sm:grid-cols-2">
          {photographers.map((photographer) => (
            <li>
              <a href={photographer.href} class={LINK_ITEM}>
                {photographer.name}
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-4 text-body text-text text-pretty">
          And others whose names I do not have.
        </p>

        <p class="mt-6 text-body text-text text-pretty">
          Screenshots in posts are from:
        </p>
        <ul class="bullet-list mt-4">
          {Object.entries(SCREENSHOT_SOURCES).map(([name, href]) => (
            <li>
              <a href={href} class={LINK_ITEM}>
                {name}
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-body text-text text-pretty">
          Used under Creative Commons Attribution or Attribution-ShareAlike
          licenses:
        </p>
        <ul class="bullet-list mt-4">
          {Object.values(LICENSED_PHOTOS).map((photo) => (
            <li>
              <a href={photo.source}>{photo.title}</a>, by {photo.photographer},
              on {photo.sourceName},{' '}
              <a href={photo.licenseHref}>{photo.license}</a>, {photo.changes}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band pb-section">
    <div class="card-block mx-auto grid max-w-page lg:grid-cols-2">
      <div class:list={['card', TOOLS_WALL.bricks[0]]}>
        <h2 class={CARD_HEADING}>Design Tools</h2>

        <dl class={NAMED_LIST}>
          {DESIGNED_WITH.map((tool) => (
            <div class={NAMED_ENTRY}>
              <dt class="text-body font-black">
                <a href={tool.href} class={LINK_ITEM}>
                  {tool.name}
                </a>
              </dt>
              <dd class="mt-1 text-body text-text">{tool.role}</dd>
            </div>
          ))}
          <div class={NAMED_ENTRY}>
            <dt class="text-body font-black text-text">Canva and Claude</dt>
            <dd class="mt-1 text-body text-text">For the logo</dd>
          </div>
        </dl>
      </div>

      <div class:list={['card', TOOLS_WALL.bricks[1]]}>
        <h2 class={CARD_HEADING}>Built and Tested With</h2>

        <ul class="bullet-list mt-6 gap-x-12 sm:grid sm:grid-cols-2 lg:grid-cols-3">
          {BUILT_WITH.map((tool) => (
            <li>
              <a href={tool.href} class={LINK_ITEM}>
                {tool.name}
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-body text-text text-pretty">
          The license of every package, script and font this site sends to your
          browser is in <a href="/licenses.txt">the licenses file</a>.
        </p>
      </div>

      <div
        id="not-found"
        class:list={['card lg:col-span-2', TOOLS_WALL.bricks[2]]}
      >
        <h2 class={CARD_HEADING}>The 404 Page</h2>
        <p class="mt-6 mb-paragraph max-w-4xl text-lead font-normal text-text text-pretty">
          The 404 page is a nod to Lewis Carroll&rsquo;s{' '}
          <cite>Alice&rsquo;s Adventures in Wonderland</cite> (1865).
        </p>
        <p class="mt-6 max-w-measure text-body text-text text-pretty">
          The White Rabbit&rsquo;s line comes from chapter I and the Cheshire
          Cat&rsquo;s from chapter VI, both Carroll&rsquo;s own. The White
          Rabbit points to the page you most likely meant.
        </p>
      </div>

      <div id="alice" class:list={['card lg:col-span-2', TOOLS_WALL.bricks[3]]}>
        <h2 class={CARD_HEADING}>Alice in Wonderland</h2>
        <p class="mt-6 mb-paragraph max-w-4xl text-lead font-normal text-text text-pretty">
          The text size buttons are a nod to{' '}
          <cite>Alice&rsquo;s Adventures in Wonderland</cite> (1865) by Lewis
          Carroll.
        </p>
        <p class="mt-6 max-w-measure text-body text-text text-pretty">
          &ldquo;Drink Me&rdquo; is the label on the bottle and &ldquo;Eat
          Me&rdquo; the label on the cake. The book&rsquo;s text is free to use.
          You can read it in full on{' '}
          <a href="https://www.gutenberg.org/ebooks/11">Project Gutenberg</a>.
        </p>
        <p class="mt-6 max-w-measure text-body text-text text-pretty">
          The answer to the riddle on the message sent page is Carroll&rsquo;s
          own, from the preface to the 1896 edition.
        </p>
      </div>

      <div id="ai" class:list={['card lg:col-span-2', TOOLS_WALL.bricks[4]]}>
        <h2 class={CARD_HEADING}>
          Made with <Abbr short="AI" long="artificial intelligence" />
        </h2>
        <ul class="bullet-list mt-6">
          {MADE_WITH_AI.map((item) => (
            <li>
              <a href={item.href} class={LINK_ITEM}>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 mb-paragraph text-post-h2 leading-paragraph font-black text-text uppercase text-balance">
          Thank you to all the artists whose designs AI models are built on and
          ripped off from.
        </p>
        <p class="mt-6 text-body text-text text-pretty">
          How AI helped build the site:{' '}
          <a href={AI_DISCLOSURE}>AI disclosure</a>.
        </p>
      </div>
    </div>
  </section>

  <CloseRow
    eyebrow="Next"
    readHref="/accessibility/"
    readLabel="Accessibility Statement"
    actionHref="/contact/"
    actionLabel="Get in Touch"
  />
</BaseLayout>
