---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { CONTACT_EMAIL } from '../lib/contact';
import { NAME_INSPIRATION, PHOTOGRAPHERS, THANKS } from '../lib/credits';

/*
 * Who made what on this site. The site name story is Sinduri's own words and
 * leads the page, because she wanted it somewhere visible; everything below
 * it is factual attribution read from src/lib/credits.ts, the same list the
 * photo captions in posts link from.
 *
 * People come first (the name, the thank-yous, the photographers), then the
 * tools. A card's title is an h2 at h3 size, as the cards on /career are.
 *
 * A list item that is nothing but a link gets `min-h-target`: the SC 2.5.8
 * inline exception does not reach a link with no sentence around it.
 */

/*
 * Everything that ships, serves or checks the site, in that order. Read from
 * package.json, wrangler.jsonc, src/lib/social-icons.ts and AI_DISCLOSURE.md;
 * a tool added there belongs here too.
 */
const BUILT_WITH = [
  { name: 'Astro', href: 'https://astro.build/' },
  { name: 'Vue', href: 'https://vuejs.org/' },
  { name: 'Tailwind CSS', href: 'https://tailwindcss.com/' },
  { name: 'Lexend', href: 'https://www.lexend.com/' },
  { name: 'Fontsource', href: 'https://fontsource.org/' },
  { name: 'Simple Icons', href: 'https://simpleicons.org/' },
  { name: 'Cloudflare Workers', href: 'https://workers.cloudflare.com/' },
  { name: 'Cloudflare D1', href: 'https://developers.cloudflare.com/d1/' },
  {
    name: 'Cloudflare Email Routing',
    href: 'https://developers.cloudflare.com/email-routing/',
  },
  { name: 'Umami', href: 'https://umami.is/' },
  { name: 'Playwright', href: 'https://playwright.dev/' },
  { name: 'axe-core', href: 'https://github.com/dequelabs/axe-core' },
  { name: 'Claude Code', href: 'https://claude.com/product/claude-code' },
] as const;

const DESIGNED_WITH = [
  {
    name: 'Stitch',
    href: 'https://stitch.withgoogle.com/',
    role: 'For design',
  },
  {
    name: 'Claude Design',
    href: 'https://claude.com/product/design',
    role: 'For refinement',
  },
] as const;

const GUIDES = [
  {
    name: 'ACCESSIBILITY.md',
    href: 'https://github.com/mgifford/ACCESSIBILITY.md',
    author: { name: 'Mike Gifford', href: 'https://ox.ca/' },
    use: 'The format this site uses for its accessibility statement.',
  },
  {
    name: 'The Website Specification',
    href: 'https://specification.website/',
    author: { name: 'Joost de Valk', href: 'https://joost.blog/' },
    use: 'The checklist used to check the SEO, security and agent readiness of this site.',
  },
] as const;

const photographers = Object.entries(PHOTOGRAPHERS).map(([name, href]) => ({
  name,
  href,
}));

const LINK_ITEM = 'inline-flex min-h-target items-center';
const CARD_HEADING = 'text-h3 text-text';

/*
 * A name with a line saying what it did is a `dl` entry under a rule; a list
 * of bare names keeps its bullets. The name is a `dt`, not a bold paragraph,
 * so it is neither a fake heading nor a heading it is not. The rule sits above
 * every entry, the first included, so it reads the same in one column or two.
 */
const RULED_LIST = 'mt-6 grid gap-6';
const RULED_ENTRY = 'border-t-4 border-border pt-5';
---

<BaseLayout
  title="Credits | sinduri.lol"
  description="Where the name sinduri.lol comes from, who helped, who took the photos, and what the site was designed, built and tested with."
>
  <PageHero title="Credits">
    <p class="mt-8 max-w-2xl text-h3 font-bold text-text text-pretty">
      A big thank you to everyone who helped me build this site, and to the
      tools that made it possible.
    </p>
  </PageHero>

  <section class="band py-16">
    <div class="mx-auto max-w-page">
      <div id="name" class="card shadow-hard-pink-8">
        <h2 class={CARD_HEADING}>Where the name comes from</h2>
        <p class="mt-6 max-w-4xl text-h3 font-bold text-text text-pretty">
          The inspiration for the name came from{' '}
          <a href={NAME_INSPIRATION.href}>{NAME_INSPIRATION.site}</a>, the
          website of my fellow Drupalist and friend {NAME_INSPIRATION.name}.
        </p>
        <p class="mt-6 max-w-prose text-body text-muted text-pretty">
          I loved it so much that I used the same pattern for this site and even
          my email address,{' '}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Thank you,
          Norman!
        </p>
        <p class="mt-6 text-body">
          <a href="/about/#lepus-ridet" class={LINK_ITEM}>
            {/* One child, so the flex container keeps the space. */}
            <span>
              Why <span lang="la">Lepus Ridet</span>
            </span>
          </a>
        </p>
      </div>

      <div class="card mt-12 shadow-hard-cyan-8">
        <h2 class={CARD_HEADING}>Thank you</h2>
        <dl class:list={[RULED_LIST, 'md:grid-cols-2 md:gap-x-12']}>
          {THANKS.map((person) => (
            <div class={RULED_ENTRY}>
              <dt class="text-body font-bold">
                <a href={person.href} class={LINK_ITEM}>
                  {person.name}
                </a>
              </dt>
              <dd class="mt-1 max-w-prose text-body text-muted text-pretty">
                {person.reason}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="card mt-12 shadow-hard-gold-8">
        <h2 class={CARD_HEADING}>Photos</h2>

        <p class="mt-6 text-body text-muted text-pretty">
          Photos on this site and in its posts are by:
        </p>

        <ul class="mt-4 list-disc gap-x-12 pl-6 text-muted marker:text-gold sm:columns-2">
          {photographers.map((photographer) => (
            <li class="break-inside-avoid">
              <a href={photographer.href} class={LINK_ITEM}>
                {photographer.name}
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-4 text-body text-muted text-pretty">And more.</p>
      </div>
    </div>
  </section>

  <section class="band pb-24">
    <div class="mx-auto grid max-w-page gap-12 lg:grid-cols-2">
      <div class="card shadow-hard-pink-8">
        <h2 class={CARD_HEADING}>Design tools</h2>

        <dl class={RULED_LIST}>
          {DESIGNED_WITH.map((tool) => (
            <div class={RULED_ENTRY}>
              <dt class="text-body font-bold">
                <a href={tool.href} class={LINK_ITEM}>
                  {tool.name}
                </a>
              </dt>
              <dd class="mt-1 text-body text-muted">{tool.role}</dd>
            </div>
          ))}
          <div class={RULED_ENTRY}>
            <dt class="text-body font-bold text-text">
              Multiple artists on Fiverr and Upwork
            </dt>
            <dd class="mt-1 text-body text-muted">
              Created and cleaned the logo
            </dd>
          </div>
        </dl>
      </div>

      <div class="card shadow-hard-cyan-8">
        <h2 class={CARD_HEADING}>Guides</h2>

        <dl class={RULED_LIST}>
          {GUIDES.map((guide) => (
            <div class={RULED_ENTRY}>
              <dt class="text-body font-bold">
                <a href={guide.href} class={LINK_ITEM}>
                  {guide.name}
                </a>
              </dt>
              <dd class="mt-1 text-body text-muted text-pretty">
                By <a href={guide.author.href}>{guide.author.name}</a>.{' '}
                {guide.use}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="card shadow-hard-gold-8 lg:col-span-2">
        <h2 class={CARD_HEADING}>Built and tested with</h2>

        <ul class="mt-6 list-disc gap-x-12 pl-6 text-muted marker:text-gold sm:columns-2 lg:columns-3">
          {BUILT_WITH.map((tool) => (
            <li class="break-inside-avoid">
              <a href={tool.href} class={LINK_ITEM}>
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
