---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { CONTACT_PATH } from '../lib/paths';
import textSizeFeature from '../scripts/text-size.ts?worker&url';
import {
  CURIOUSER_QUOTE,
  FALL_QUOTE,
  QUOTE_SOURCE,
  shelves,
} from '../lib/rabbit-hole';

/*
 * The shelves are the site's own content, read at build time. Everything is a
 * plain list and link: nothing here needs a script except the door's size buttons.
 */
const items = await shelves();
const SHELF =
  'edge border-border bg-surface p-card-tight shadow-hard-pink-object sm:p-card max-w-xl';
---

<BaseLayout
  title="Down the Rabbit Hole"
  description="A page to fall through: real posts, a talk, a fact and the credits on the shelves going past, and a little door at the bottom."
>
  <PageHero title="Down the Rabbit Hole">
    <p class="standfirst">
      Keep scrolling. Things from this site go past on the way down, and each
      one is a link.
    </p>
  </PageHero>

  <section class="band py-section" aria-labelledby="fall-heading">
    <div class="mx-auto max-w-page">
      <h2 id="fall-heading" class="text-h2 text-text">
        The Fall
      </h2>
      <blockquote class="mt-head max-w-measure text-lead text-subtle">
        &ldquo;{FALL_QUOTE}&rdquo;
        <cite class="mt-3 block text-body not-italic">
          {QUOTE_SOURCE}, chapter 1
        </cite>
      </blockquote>
      <ol role="list" class="mt-section space-y-section">
        {items.map((shelf, i) => (
          <li class:list={[SHELF, i % 2 === 1 && 'ml-auto']}>
            <div class="label text-subtle">
              {shelf.kind}, {shelf.depth} ft down
            </div>
            <p class="mt-3 mb-paragraph text-body text-text text-pretty">
              {shelf.term && <span lang="la">{shelf.term}</span>}
              {shelf.text}
            </p>
            <p>
              <a
                href={shelf.href}
                class="link inline-flex min-h-target min-w-target items-center"
              >
                {shelf.linkLabel}
              </a>
            </p>
          </li>
        ))}
      </ol>
      <blockquote class="mt-section max-w-measure text-lead text-subtle">
        &ldquo;{CURIOUSER_QUOTE}&rdquo;
        <cite class="mt-3 block text-body not-italic">
          {QUOTE_SOURCE}, chapter 2
        </cite>
      </blockquote>
    </div>
  </section>

  <Section title="The Little Door" id="door" surface="gold">
    <p class="js-only max-w-measure text-body text-gold-text text-pretty">
      Too big for the door? Drink Me makes the text smaller and Eat Me makes it
      larger, on this page only. Then knock.
    </p>
    <div
      class="js-only mt-head"
      role="group"
      aria-labelledby="door-size-label"
      data-text-size="page"
    >
      <div id="door-size-label" class="label text-gold-text">
        Text Size
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-6">
        <button
          type="button"
          class="btn-gold-secondary"
          hidden
          data-on-demand={textSizeFeature}
          data-size-action="smaller"
        >
          Drink Me
        </button>
        <button
          type="button"
          class="btn-gold-secondary"
          hidden
          data-on-demand={textSizeFeature}
          data-size-action="larger"
        >
          Eat Me
        </button>
        <button
          type="button"
          class="btn-gold-secondary"
          hidden
          data-on-demand={textSizeFeature}
          data-size-action="reset"
        >
          Just Right
        </button>
      </div>
      <p
        class="mt-4 text-body text-gold-text"
        role="status"
        data-size-status
      ></p>
    </div>
    <p class="mt-head">
      <a href={CONTACT_PATH} class="btn-gold-primary">
        Knock: Get in Touch
      </a>
    </p>
  </Section>
</BaseLayout>
