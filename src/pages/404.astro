---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/components/starfield.css';
import '../styles/components/lost-page.css';
import { BLOG_PATH } from '../lib/paths';
import { sitePages } from '../lib/site-pages';

/* What src/scripts/lost-page.ts matches the mistyped address against. */
const pages = await sitePages();

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */
---

<BaseLayout
  title="Page Not Found"
  description="These are not the droids you are looking for: that address does not lead anywhere on sinduri.lol."
  noCanonical
  noindex
>
  <PageHero
    title="These are not the droids you are looking for."
    titleSize="h2"
    hiddenPrefix="Page Not Found:"
    slab="none"
    starfield
  >
    <span slot="eyebrow" class="badge">
      Episode 404
    </span>

    <p slot="kicker" class="mb-6 text-post-teaser text-text text-pretty">
      <span class="star-clear">
        A long time ago, on a website not so far, far away&hellip;
      </span>
    </p>

    <p class="standfirst">
      This page does not exist. It may have moved, or the address has a typo.
      Nothing is broken on your end, so move along. The credits{' '}
      <a href="/credits/#not-found">explain the Star Wars lines</a>. If a link
      on this site brought you here,{' '}
      <a href="/contact/">tell me about the broken link</a>.
    </p>

    <ul role="list" class="actions mt-head">
      <li>
        <a href="/" class="btn-primary">
          Go to the Homepage
        </a>
      </li>
      <li>
        <a href={BLOG_PATH} class="btn-secondary">
          Read the Blog
        </a>
      </li>
    </ul>
  </PageHero>

  {/* Placeholder copy. Without script only the heading and the quick links show. */}
  <section data-lost-game class="band py-section" aria-labelledby="lost-title">
    <div class="mx-auto max-w-page">
      <h2 id="lost-title" class="text-h2 text-text">
        Find Your Way
      </h2>
      <div data-lost-play hidden>
        <p class="lost-intro">
          The rabbit can sniff out where you meant to go. Or take a quick way
          out below.
        </p>
        <div class="lost-sniff-row">
          <button type="button" class="btn-primary" data-lost-sniff>
            Sniff Around
          </button>
          <span data-lost-rabbit aria-hidden="true"></span>
        </div>
      </div>
      <p class="lost-status" role="status"></p>
      <ul class="lost-finds" role="list" data-lost-finds>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href={BLOG_PATH}>Blog</a>
        </li>
      </ul>
    </div>
  </section>
  <script
    type="application/json"
    id="lost-pages"
    set:html={JSON.stringify(pages).replaceAll('<', '\\u003c')}
  />
</BaseLayout>

<script>
  import '../scripts/lost-page';
</script>
