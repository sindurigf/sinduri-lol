---
import { Image } from 'astro:assets';
import bunnyDark from '../assets/bunny-dark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DENSITIES } from '../lib/image-densities';

/*
 * Workers static assets serves 404.html with a 404 status for any path that
 * matches no asset, because wrangler.jsonc sets `not_found_handling:
 * "404-page"`. Without both, a wrong address gets an empty response, or under
 * Pages it got the homepage with a 200, which crawlers and link checkers take
 * for a working page.
 *
 * Astro emits this route as 404.html rather than 404/index.html, which is the
 * filename Cloudflare looks for. tests/routes.ts derives routes
 * from both shapes, so this one is not invisible to the suite.
 *
 * Themed on Star Wars at Sinduri's request, around "These are not the droids
 * you are looking for", in the site's own card and tile vocabulary. The mark
 * is decorative: `bunny-dark` is #111111 artwork, 11.50:1 on gold and 1.02:1
 * on the page background, so the gold tile is what makes it visible.
 *
 * `noCanonical` because this page answers every wrong address on the site,
 * and a canonical link here would name each of those dead URLs as the
 * preferred address for this content. Deliberately no `noindex` with it: the
 * 404 status already tells a crawler not to index the response, and
 * tests/not-found.spec.ts asserts that status.
 *
 * These notes are in the frontmatter rather than above <BaseLayout>, because
 * a comment there is emitted between the doctype and <html> and shipped on
 * every 404 response.
 */

/** The mark on the gold tile, drawn `h-12`. See the note in Header.astro. */
const MARK_HEIGHT = 48;
---

<BaseLayout
  title="Page not found | sinduri.lol"
  description="These are not the droids you are looking for: that address does not lead anywhere on sinduri.lol."
  noCanonical
>
  <div class="mx-auto grid max-w-page gap-16 py-28 lg:grid-cols-2 lg:items-center">
    <div class="min-w-0">
      <p class="chip text-gold">Episode 404</p>

      <p class="mt-10 text-h3 font-normal text-text text-pretty">
        A long time ago, on a website not so far, far away&hellip;
      </p>

      {/*
        The heading is the line, and the paragraph under it says plainly what
        happened, so the joke never stands in for the explanation. The page
        title still reads "Page not found" for anyone who only hears that. Set
        at the h2 size because it is a sentence: at h1 it ran to six lines.
      */}
      <h1 class="mt-6 -rotate-1 text-h2 text-gold">
        These are not the droids you are looking for.
      </h1>

      <p class="mt-10 max-w-2xl text-body text-text text-pretty">
        This page does not exist. It may have moved, or the address has a typo.
        Nothing is broken on your end, so move along.
      </p>

      <ul class="actions mt-14">
        <li>
          <a href="/" class="btn-primary">
            Go to the homepage
          </a>
        </li>
        <li>
          <a href="/blog/" class="btn-secondary">
            Read the blog
          </a>
        </li>
      </ul>
    </div>

    {/*
      Decoration: the logo tile in a patch of night sky. It holds no text, so
      the starfield behind it has nothing to put a contrast ratio in doubt.
    */}
    <div
      aria-hidden="true"
      class="starfield flex min-h-80 min-w-0 items-center justify-center border-8 border-border shadow-hard-pink-8"
    >
      <span class="flex h-24 w-24 rotate-3 items-center justify-center rounded-nav border-4 border-border bg-gold shadow-hard-pink-12">
        {/* loading="eager": in view on arrival at every width. */}
        <Image
          src={bunnyDark}
          alt=""
          height={MARK_HEIGHT}
          densities={DENSITIES}
          loading="eager"
          class="h-12 w-auto"
        />
      </span>
    </div>
  </div>
</BaseLayout>
