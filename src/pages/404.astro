---
import { Image } from 'astro:assets';
import bunnyFooter from '../assets/bunny-footer.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { DENSITIES } from '../lib/image-densities';
import { HEADER_LINKS } from '../lib/nav';
import { CONTACT_PATH } from '../lib/paths';
import { sitePages } from '../lib/site-pages';

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */

/* CSS px: the rabbit beside its line (h-24). */
const RABBIT_HEIGHT = 96;

/* Carroll's text, Project Gutenberg #11: the Rabbit in chapter I, the Cat in chapter VI. */
const RABBIT_LINE = '“Oh dear! Oh dear! I shall be late!”';
const CAT_LINE =
  '“That depends a good deal on where you want to get to,” said the Cat.';

const SECTIONS = [...HEADER_LINKS, { href: CONTACT_PATH, label: 'Contact' }];

/* `<` escaped, so no title can close the data block. */
const pagesJson = JSON.stringify(
  (await sitePages()).filter((page) => page.path !== '/'),
).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Page Not Found"
  description="That address does not lead anywhere on sinduri.lol. Follow the White Rabbit to a page that does."
  noCanonical
  noindex
>
  <PageHero title="I’m Late! This Page Is Gone" slab="none">
    <p class="standfirst">
      This page does not exist, and nothing is broken on your end. If a link on
      this site brought you here,{' '}
      <a href={CONTACT_PATH}>tell me about the broken link</a>.
    </p>
  </PageHero>

  <div class="band py-section">
    <div class="mx-auto flex max-w-page flex-col gap-head">
      <div class="card relative pt-card lg:max-w-2xl">
        <span class="sticker absolute top-0 left-8 -translate-y-1/2 -rotate-3">
          The White Rabbit
        </span>
        {/* <div>s: a large bold <p> trips WAVE's "Possible heading" (tests/wave-alerts.spec.ts). */}
        <div class="flex items-end gap-6">
          <Image
            src={bunnyFooter}
            alt=""
            height={RABBIT_HEIGHT}
            densities={DENSITIES}
            class="h-24 w-auto shrink-0"
          />
          <div class="text-lead font-black text-text text-pretty">
            {RABBIT_LINE}
          </div>
        </div>
        {/* Home without JavaScript; src/scripts/follow-rabbit.ts points it at the page the address meant. */}
        <p class="mt-6">
          <a href="/" class="btn-primary" data-follow>
            Follow Me Home
          </a>
        </p>
      </div>

      <div class="card relative pt-card lg:ml-auto lg:max-w-2xl">
        <span class="sticker absolute top-0 right-8 -translate-y-1/2 rotate-3">
          The Cheshire Cat
        </span>
        <div class="text-lead text-text italic text-pretty">{CAT_LINE}</div>
        <details class="mt-6">
          <summary class="btn-secondary cursor-pointer">Or Ask the Cat</summary>
          <ul
            role="list"
            class="mt-6 flex flex-wrap gap-4"
            aria-label="Sections"
          >
            {SECTIONS.map((link) => (
              <li>
                <a href={link.href} class="chip">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    id="site-pages"
    set:html={pagesJson}
  />
</BaseLayout>

<script>
  import '../scripts/follow-rabbit';
</script>
