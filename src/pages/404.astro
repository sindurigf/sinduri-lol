---
import { Image } from 'astro:assets';
import bunnyFooter from '../assets/bunny-footer.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/components/rabbit-chase.css';
import { chasePages, sectionsOf } from '../lib/chase-pages';
import { DENSITIES } from '../lib/image-densities';
import { sitePages } from '../lib/site-pages';

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */

/* CSS px: --size-rabbit-runner, the rabbit at the crossroads. */
const RABBIT_HEIGHT = 72;

const pages = chasePages(await sitePages());
/* `<` escaped, so no title can close the data block. */
const pagesJson = JSON.stringify(pages).replace(/</g, '\\u003c');
const sections = sectionsOf(pages);

/* Carroll's text, Project Gutenberg #11, chapter VI. */
const CAT_LINE =
  '“That depends a good deal on where you want to get to,” said the Cat.';
---

<BaseLayout
  title="Page Not Found"
  description="That address does not lead anywhere on sinduri.lol. Follow the White Rabbit to a page that does."
  noCanonical
  noindex
>
  <PageHero
    title="Which Way From Here?"
    titleSize="h2"
    hiddenPrefix="Page Not Found:"
    slab="none"
  >
    <span slot="eyebrow" class="badge">
      Page Not Found
    </span>

    <p slot="slab" class="standfirst">
      This page does not exist, but the White Rabbit knows the way. Nothing is
      broken on your end. If a link on this site brought you here,{' '}
      <a href="/contact/">tell me about the broken link</a>.
    </p>

    {/* Without JavaScript the signs are links; src/scripts/rabbit-chase.ts makes them choose a way. */}
    <div id="crossroads" slot="slab" class="crossroads mt-head">
      <p class="crossroads-cat">{CAT_LINE}</p>
      <div class="crossroads-map">
        <div class="crossroads-column">
          <div id="crossroads-signs-label" class="crossroads-heading label">
            Sections
          </div>
          <ul
            role="list"
            class="crossroads-signs"
            aria-labelledby="crossroads-signs-label"
          >
            {sections.map((section) => (
              <li>
                <a
                  href={section.path}
                  class="crossroads-sign label"
                  data-path={section.path}
                >
                  {section.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="crossroads-pole" aria-hidden="true">
          <Image
            src={bunnyFooter}
            alt=""
            height={RABBIT_HEIGHT}
            densities={DENSITIES}
            class="crossroads-rabbit"
          />
        </div>
        <div class="crossroads-column" data-pending></div>
      </div>
      <p class="sr-only" aria-live="polite"></p>
      <script
        is:inline
        type="application/json"
        id="chase-pages"
        set:html={pagesJson}
      />
    </div>
  </PageHero>
</BaseLayout>

<script>
  import '../scripts/rabbit-chase';
</script>
