---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/components/starfield.css';
import '../styles/components/lost-page.css';
import { BLOG_PATH } from '../lib/paths';

/* The 404 game's bricks; src/scripts/lost-page.ts hides the page behind one. */
const BRICKS = [1, 2, 3, 4, 5];

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */
---

<BaseLayout
  title="Page Not Found"
  description="These are not the droids you are looking for: that address does not lead anywhere on sinduri.lol."
  noCanonical
  noindex
>
  <PageHero
    title="These are not the droids you are looking for."
    titleSize="h2"
    hiddenPrefix="Page Not Found:"
    slab="none"
    starfield
  >
    <span slot="eyebrow" class="badge">
      Episode 404
    </span>

    <p slot="kicker" class="mb-6 text-post-teaser text-text text-pretty">
      <span class="star-clear">
        A long time ago, on a website not so far, far away&hellip;
      </span>
    </p>

    <p class="standfirst">
      This page does not exist. It may have moved, or the address has a typo.
      Nothing is broken on your end, so move along. The credits{' '}
      <a href="/credits/#not-found">explain the Star Wars lines</a>. If a link
      on this site brought you here,{' '}
      <a href="/contact/">tell me about the broken link</a>.
    </p>

    <ul role="list" class="actions mt-head">
      <li>
        <a href="/" class="btn-primary">
          Go to the Homepage
        </a>
      </li>
      <li>
        <a href={BLOG_PATH} class="btn-secondary">
          Read the Blog
        </a>
      </li>
    </ul>
  </PageHero>

  {/* Placeholder copy. Shown by src/scripts/lost-page.ts: without it there is nothing to play. */}
  <section
    data-lost-game
    class="band py-section"
    aria-labelledby="lost-title"
    hidden
  >
    <div class="mx-auto max-w-page">
      <h2 id="lost-title" class="text-h2 text-text">
        Help Find This Page
      </h2>
      <p class="lost-status" role="status"></p>
      <ul class="lost-bricks" role="list">
        {BRICKS.map((n) => (
          <li>
            <button
              type="button"
              class="lost-brick"
              aria-label={`Look behind brick ${n}`}
            >
              {n}
            </button>
          </li>
        ))}
      </ul>
      <button type="button" data-lost-again class="btn-secondary mt-6" hidden>
        Play Again
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/lost-page';
</script>
