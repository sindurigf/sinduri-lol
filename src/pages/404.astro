---
import { Image } from 'astro:assets';
import bunnyFooter from '../assets/bunny-footer.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/components/rabbit-chase.css';
import { chasePages } from '../lib/chase-pages';
import { DENSITIES } from '../lib/image-densities';
import { ABOUT_PATH, BLOG_PATH, CAREER_PATH } from '../lib/paths';
import { sitePages } from '../lib/site-pages';

/*
 * Served with status 404 via `not_found_handling: "404-page"` in wrangler.jsonc.
 * noCanonical: it answers every dead URL. noindex: /404 itself is a route that
 * answers 200, and would otherwise be indexable.
 */

/* CSS px: --size-rabbit-runner, the rabbit at the crossroads. */
const RABBIT_HEIGHT = 72;

/* Without JavaScript these are the way out; src/scripts/rabbit-chase.ts replaces them with the crossroads. */
const MAIN_PAGES = [
  { href: '/', label: 'Home' },
  { href: ABOUT_PATH, label: 'About' },
  { href: CAREER_PATH, label: 'Career' },
  { href: BLOG_PATH, label: 'Blog' },
] as const;

/* `<` escaped, so no title can close the data block. */
const pagesJson = JSON.stringify(chasePages(await sitePages())).replace(
  /</g,
  '\\u003c',
);
---

<BaseLayout
  title="Page Not Found"
  description="That address does not lead anywhere on sinduri.lol. Follow the White Rabbit to a page that does."
  noCanonical
  noindex
>
  <PageHero
    title="Which Way From Here?"
    titleSize="h2"
    hiddenPrefix="Page Not Found:"
    slab="none"
  >
    <span slot="eyebrow" class="badge">
      Page Not Found
    </span>

    <p slot="slab" class="standfirst">
      This page does not exist, but the White Rabbit knows the way. Nothing is
      broken on your end. If a link on this site brought you here,{' '}
      <a href="/contact/">tell me about the broken link</a>.
    </p>

    <div id="crossroads" slot="slab" class="crossroads mt-head">
      <nav aria-label="Main pages" data-fallback>
        <ul role="list" class="actions">
          {MAIN_PAGES.map((page, index) => (
            <li>
              <a
                href={page.href}
                class={index === 0 ? 'btn-primary' : 'btn-secondary'}
              >
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <Image
        src={bunnyFooter}
        alt=""
        height={RABBIT_HEIGHT}
        densities={DENSITIES}
        class="crossroads-rabbit"
        data-runner
        hidden
      />
      <script type="application/json" id="chase-pages" set:html={pagesJson} />
    </div>
  </PageHero>
</BaseLayout>

<script>
  import '../scripts/rabbit-chase';
</script>
