---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/BlogListing.astro';
import PageHero from '../../components/PageHero.astro';
import { getSortedPosts, pageCount, postsOnPage } from '../../lib/blog';

/*
 * The blog index, page 1. Pages 2 and up are src/pages/blog/page/[page].astro
 * and render the same component with a different slice; the note there says
 * why the pager lives under an extra path segment.
 *
 * The heading and standfirst name what the blog holds, in the five categories
 * of the content model, and claim nothing about posts that do not exist yet.
 */

const posts = await getSortedPosts();
const totalPages = pageCount(posts.length);
---

<BaseLayout
  title="Blog | sinduri.lol"
  description="Sinduri Guntupalli writes about open source, her professional journey, travel, skincare and personal thoughts."
>
  <PageHero title="Blog">
    <p class="mt-8 max-w-2xl text-body text-muted text-pretty">
      Posts about open source, my professional journey, travel, skincare and
      personal thoughts. Pick a category below, or read everything.
    </p>
  </PageHero>

  <div class="mx-auto max-w-page pb-28 pt-16 lg:pt-40">
    <BlogListing
      posts={postsOnPage(posts, 1)}
      filter={{ kind: 'all' }}
      currentPage={1}
      totalPages={totalPages}
      featureFirst
    />
  </div>
</BaseLayout>
