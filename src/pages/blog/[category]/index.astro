---
import type { GetStaticPaths } from 'astro';
import { BLOG_CATEGORIES } from '../../../content.config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogListing from '../../../components/BlogListing.astro';
import {
  categoryLabel,
  getSortedPosts,
  type BlogPost,
} from '../../../lib/blog';

interface Props {
  posts: BlogPost[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getSortedPosts();

  return BLOG_CATEGORIES.map((category) => ({
    params: { category },
    props: {
      posts: posts.filter((post) => post.data.category === category),
    },
  }));
};

const { category } = Astro.params;
const { posts } = Astro.props as Props;

// `category` comes from getStaticPaths, so it is always one of BLOG_CATEGORIES,
// but Astro.params is typed as string | undefined. Fail loudly rather than
// rendering a page titled "undefined".
if (!category) {
  throw new Error('Category route rendered without a category param.');
}

const label = categoryLabel(category);

/*
 * A CATEGORY LISTING IS NOT PAGINATED, and that is a decision rather than an
 * omission. The index paginates because it holds every post; a category holds
 * a slice, the largest of which is three posts today. Paginating it would add
 * a /blog/<category>/page/<n> route that emits nothing, which is a code path
 * that ships and is never exercised — worth less than the long page it would
 * one day prevent. Revisit when a single category passes a screenful; the
 * helpers in src/lib/blog.ts already do the arithmetic.
 */
---

<BaseLayout
  title={`${label} | sinduri.lol`}
  description={`Posts filed under ${label}.`}
>
  <!-- No horizontal padding here; see the note in [slug].astro. -->
  <div class="mx-auto max-w-7xl py-20">
    <!--
      inline-block py-2 -my-2 is a target-size rule, not spacing (SC 2.5.8).
      The 13px/1.2 .label renders a 15.6px line box, so the bare link measured
      87x16 and passed only by the spacing exception, with the nearest other
      target 167px away. That is the load-bearing-gap arrangement this project
      decided not to depend on, because an unrelated layout change can break
      conformance silently and at a distance from the edit.

      py-2 takes the hit area to 31.6px. The matching -my-2 pulls the layout
      box back to the 15.6px it occupied before, so the padding grows the
      target about the same centre line and no glyph moves: the <h1> below
      stays at the same y. Margins do not shrink the padding box, so the
      target keeps its full height. inline-block rather than block, so the
      target is the width of the words and not of the whole container.
    -->
    <p class="label text-subtle">
      <a href="/blog" class="-my-2 inline-block py-2 text-gold">All posts</a>
    </p>

    <h1 class="mt-6 text-h1 text-text">{label}</h1>

    <div class="mt-12">
      <BlogListing
        posts={posts}
        activeCategory={category as (typeof BLOG_CATEGORIES)[number]}
        currentPage={1}
        totalPages={1}
      />
    </div>
  </div>
</BaseLayout>
