---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { blogTrail } from '../../../lib/breadcrumbs';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogListing from '../../../components/BlogListing.astro';
import {
  getSortedPosts,
  pageCount,
  postsOnPage,
  type BlogPost,
} from '../../../lib/blog';

/*
 * Pages 2 and up of the blog index. Page 1 is /blog, which is
 * src/pages/blog/index.astro; this file starts at 2 and emits nothing when
 * there is only one page of posts.
 *
 * WHY THE EXTRA `page` SEGMENT rather than a flat `/blog/2`. The segment
 * after `/blog` is already spoken for by `/blog/[category]` and
 * `/blog/[slug]`. A third dynamic route there would let a numeric category or
 * post slug collide with a page number, and the build would write one file
 * over the other without saying so. `/blog/page/<n>` cannot collide.
 *
 * The listing is a component rather than duplicated markup, so the filter,
 * the cards and the pager on page 2 cannot drift from page 1.
 */

interface Props {
  posts: BlogPost[];
  page: number;
  totalPages: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  /*
   * Declared inside the function, not at the top of the frontmatter: Astro
   * hoists getStaticPaths and evaluates it first, so a module-scope const is
   * not defined yet and the build fails with "X is not defined" at
   * route-generation time. Page 1 is /blog, so this route starts at 2.
   */
  const FIRST_PAGED_ROUTE = 2;

  const posts = await getSortedPosts();
  const totalPages = pageCount(posts.length);

  // Empty when there is only one page of posts, which is the right answer:
  // this route then emits nothing at all rather than a bare /blog/page/1.
  return Array.from(
    { length: Math.max(0, totalPages - FIRST_PAGED_ROUTE + 1) },
    (_, index) => {
      const page = index + FIRST_PAGED_ROUTE;
      return {
        params: { page: String(page) },
        props: { posts: postsOnPage(posts, page), page, totalPages },
      };
    },
  );
};

const { posts, page, totalPages } = Astro.props as Props;
const trail = blogTrail(`Blog, page ${page}`);
---

<BaseLayout
  title={`Blog, page ${page} | sinduri.lol`}
  description={`Page ${page} of my posts on open source, my professional journey, travel, skincare and personal thoughts.`}
  trail={trail}
>
  {/*
    `py-2` takes the label link past the 24px of SC 2.5.8; `-my-2` pulls its
    layout box back to what the bare label occupied, so the hit area grows
    about the same centre line and the <h1> below does not move.

    The page number belongs in the <h1>: it is the one thing distinguishing
    this page from /blog, and a reader arriving from a search result or a
    bookmark has nothing else to say which slice of the archive this is.
  */}
  <PageHero title={`Blog, page ${page}`}>
    <Breadcrumbs slot="eyebrow" crumbs={trail.crumbs} />
  </PageHero>

  <div class="mx-auto max-w-page py-section">
    <BlogListing
      posts={posts}
      filter={{ kind: 'all' }}
      currentPage={page}
      totalPages={totalPages}
    />
  </div>
</BaseLayout>
