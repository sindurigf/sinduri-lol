---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { postTrail } from '../../lib/breadcrumbs';
import { markdownSourcePath } from '../../lib/markdown-source';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { categoryAccent, tagHref, tagLabel } from '../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as Props;
const { Content, headings } = await render(post);

const {
  title,
  date,
  category,
  tags,
  teaser,
  ogImage,
  readingTime,
  placeholder,
} = post.data;

const DATE_LOCALE = 'en-GB';
const DATE_FORMAT: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

/* The contents list names the post's own sections, not their subsections. */
const CONTENTS_DEPTH = 2;
const contents = headings.filter((heading) => heading.depth === CONTENTS_DEPTH);

const formattedDate = date.toLocaleDateString(DATE_LOCALE, DATE_FORMAT);
const machineDate = date.toISOString().slice(0, 10);
const trail = postTrail(category, title);
const accent = categoryAccent(category);

// A placeholder stays a plain page: BlogPosting would present lorem ipsum to
// a search engine as writing.
const article = placeholder
  ? undefined
  : {
      headline: title,
      datePublished: machineDate,
      keywords: tags.map(tagLabel),
    };
---

<BlogLayout
  title={`${post.data.seoTitle ?? title} | sinduri.lol`}
  description={post.data.seoDescription ?? teaser}
  ogImage={ogImage}
  article={article}
  trail={trail}
  markdownSource={placeholder ? undefined : markdownSourcePath(post.id)}
>
  {/*
    A post opens as an article, not with PageHero: the breadcrumb, the title
    in the case it is written in and in the text colour, the teaser and the
    date, then the text. The contents list sits beside the text from `xl`
    and above it below that; see `.post-layout` in global.css.
  */}
  <article class="band py-section">
    <div class="post-layout mx-auto max-w-page">
      <header>
        <Breadcrumbs crumbs={trail.crumbs} lastClass={accent.text} />
        <h1 class="text-post-title post-title text-text">{title}</h1>
        <p class="mt-8 text-body text-text text-pretty">{teaser}</p>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-label text-subtle">
          <time datetime={machineDate}>{formattedDate}</time>
          {readingTime ? <span>{readingTime} min read</span> : null}
        </p>
      </header>

      {contents.length > 0 ? (
        <nav aria-labelledby="post-contents" class="post-contents">
          {/*
            A label, not a heading: it names the navigation landmark, which
            is how a screen reader user reaches it. As an h2 it sat in the
            outline ahead of the article's first real section.
          */}
          <p id="post-contents" class="label px-card-tight pt-4 text-subtle">
            In this post
          </p>
          <ol class="mt-3">
            {contents.map((heading) => (
              <li class="border-t-4 border-border">
                <a
                  href={`#${heading.slug}`}
                  class="block px-card-tight py-3 text-contents font-normal text-text"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      ) : null}

      <div class="prose">
        <Content />
      </div>

      {tags.length > 0 ? (
        <nav aria-labelledby="post-tags" class="border-t-4 border-border pt-8">
          <p id="post-tags" class="label text-subtle">
            Tags
          </p>
          <ul class="mt-6 flex flex-wrap gap-6">
            {tags.map((tag) => (
              <li>
                <a href={tagHref(tag)} class="chip">
                  {tagLabel(tag)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
    </div>
  </article>
</BlogLayout>
