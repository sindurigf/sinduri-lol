---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { categoryAccent, tagHref, tagLabel } from '../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as Props;
const { Content } = await render(post);

const {
  title,
  date,
  category,
  tags,
  teaser,
  ogImage,
  readingTime,
  placeholder,
} = post.data;

const DATE_LOCALE = 'en-GB';
const DATE_FORMAT: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

const formattedDate = date.toLocaleDateString(DATE_LOCALE, DATE_FORMAT);
const machineDate = date.toISOString().slice(0, 10);
const categoryLabel = category.replaceAll('-', ' ');
const accent = categoryAccent(category);

// A placeholder stays a plain page: BlogPosting would present lorem ipsum to
// a search engine as writing.
const article = placeholder
  ? undefined
  : {
      headline: title,
      datePublished: machineDate,
      keywords: tags.map(tagLabel),
    };
---

<BlogLayout
  title={`${post.data.seoTitle ?? title} | sinduri.lol`}
  description={post.data.seoDescription ?? teaser}
  ogImage={ogImage}
  article={article}
>
  <PageHero title={title} titleSize="post">
    {/*
      `py-2` takes this label link past the 24px of SC 2.5.8; `-my-2` pulls
      its layout box back to what the bare label occupied, so the heading
      below does not move.
    */}
    <p slot="eyebrow" class="label mb-6 text-subtle">
      <a
        href={`/blog/${category}/`}
        class:list={['-my-2 inline-block py-2', accent.text]}
      >
        {categoryLabel}
      </a>
    </p>

    <p class="mt-8 max-w-2xl text-body text-muted text-pretty">{teaser}</p>

    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-label text-subtle">
      <time datetime={machineDate}>{formattedDate}</time>
      {readingTime ? <span>{readingTime} min read</span> : null}
    </p>
  </PageHero>

  {/*
    The reading column sits at the left of the page column, under the plate's
    own text, rather than centred in it: centred, it started a different
    distance from the edge than the title above it.
  */}
  <section class="band py-section">
    <div class="mx-auto max-w-page">
      <div class="prose max-w-3xl">
        <Content />
      </div>

      {tags.length > 0 ? (
        <div class="mt-section max-w-3xl border-t-4 border-border pt-10">
          <h2 class="label text-subtle">Tags</h2>
          <ul class="mt-6 flex flex-wrap gap-3">
            {tags.map((tag) => (
              <li>
                <a href={tagHref(tag)} class="chip">
                  {tagLabel(tag)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null}
    </div>
  </section>
</BlogLayout>
