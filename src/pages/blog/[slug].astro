---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as Props;
const { Content } = await render(post);

const { title, date, category, tags, teaser, ogImage, readingTime } = post.data;

const DATE_LOCALE = 'en-GB';
const DATE_FORMAT: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

const formattedDate = date.toLocaleDateString(DATE_LOCALE, DATE_FORMAT);
const machineDate = date.toISOString().slice(0, 10);
const categoryLabel = category.replaceAll('-', ' ');
---

<BlogLayout
  title={`${post.data.seoTitle ?? title} | sinduri.lol`}
  description={post.data.seoDescription ?? teaser}
  ogImage={ogImage}
>
  <!--
    No horizontal padding below `sm`. Every route has to present the same
    content box width at 320px, or the heading floors need one set of
    arithmetic per route. The stub pages render straight into <main>, which
    has no padding, so 24px here made this route's box 48px narrower than
    theirs and "PROFESSIONAL" overflowed it. Padding returns at `sm`, where
    the box is wide enough that it costs nothing. See the --text-h1 comment
    in global.css.
  -->
  <div class="mx-auto max-w-3xl py-20 sm:px-6">
    <p class="label text-subtle">
      <a href={`/blog/${category}`} class="text-gold">{categoryLabel}</a>
    </p>

    <h1 class="mt-6">{title}</h1>

    <p class="mt-8 text-muted">{teaser}</p>

    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-label text-subtle">
      <time datetime={machineDate}>{formattedDate}</time>
      {readingTime ? <span>{readingTime} min read</span> : null}
    </p>

    <div class="prose mt-16">
      <Content />
    </div>

    {
      tags.length > 0 ? (
        <div class="mt-16 border-t-8 border-border pt-10">
          <h2 class="label text-subtle">Tags</h2>
          <ul class="mt-6 flex flex-wrap gap-3">
            {tags.map((tag) => (
              <li class="label border-4 border-border bg-surface px-4 py-2 text-text">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
  </div>
</BlogLayout>
