---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as Props;
const { Content } = await render(post);

const { title, date, category, tags, teaser, ogImage, readingTime } = post.data;

const DATE_LOCALE = 'en-GB';
const DATE_FORMAT: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

const formattedDate = date.toLocaleDateString(DATE_LOCALE, DATE_FORMAT);
const machineDate = date.toISOString().slice(0, 10);
const categoryLabel = category.replaceAll('-', ' ');
---

<BlogLayout
  title={`${post.data.seoTitle ?? title} | sinduri.lol`}
  description={post.data.seoDescription ?? teaser}
  ogImage={ogImage}
>
  {/*
    No horizontal padding here. <main> carries the one page gutter for the
    whole site, so this container only sets the measure. Padding here would
    narrow this route's box below the one the heading floors are calibrated
    against, and a long heading word then overflows. See the .page-gutter
    comment in global.css.
  */}
  <div class="mx-auto max-w-3xl py-28">
    {/*
      `py-2` takes this label link past the 24px of SC 2.5.8; `-my-2` pulls
      its layout box back to what the bare label occupied, so the heading
      below does not move.
    */}
    <p class="label text-subtle">
      <a href={`/blog/${category}/`} class="-my-2 inline-block py-2 text-gold">
        {categoryLabel}
      </a>
    </p>

    {/*
      `text-post-h1`, not the base `h1` size. This heading sits in the
      `max-w-3xl` measure above rather than the full page column, and
      `text-h1`'s 104px ceiling overflows that box on any 12-character title
      word. See the token in global.css.
    */}
    <h1 class="mt-6 text-post-h1">{title}</h1>

    <p class="mt-8 text-muted">{teaser}</p>

    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-label text-subtle">
      <time datetime={machineDate}>{formattedDate}</time>
      {readingTime ? <span>{readingTime} min read</span> : null}
    </p>

    <div class="prose mt-16">
      <Content />
    </div>

    {tags.length > 0 ? (
      <div class="mt-16 border-t-8 border-border pt-10">
        <h2 class="label text-subtle">Tags</h2>
        {/*
            Plain labels, not boxes. Tags are not links, and as bordered chips
            they look like the category filter's links on the listing pages,
            which invites a click that does nothing.
          */}
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          {tags.map((tag) => (
            <li class="label text-text">{tag}</li>
          ))}
        </ul>
      </div>
    ) : null}
  </div>
</BlogLayout>
