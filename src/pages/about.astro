---
import type { ImageMetadata } from 'astro';
import { getImage, Image, Picture } from 'astro:assets';
import { PHOTO_FORMATS } from '../lib/photo-formats';
import bunnyDark from '../assets/bunny-dark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import CloseRow from '../components/CloseRow.astro';
import PageHero from '../components/PageHero.astro';
import LicensedPhotoCredit from '../components/LicensedPhotoCredit.astro';
import PhotoTile from '../components/PhotoTile.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import Section from '../components/Section.astro';
import AboutCats from '../components/ui/AboutCats.vue';
import type { CatInfo } from '../lib/about-cats';
import { THANKS } from '../lib/credits';
import rainbowPortrait from '../assets/photos/sinduri-pride.jpg';
import lake from '../assets/photos/sinduri-lake.jpg';
import bicycle from '../assets/photos/sinduri-bicycle.jpg';
import bestFriendSelfie from '../assets/photos/best-friend-selfie.jpg';
import bestFriendBeach from '../assets/photos/best-friend-beach.jpg';
import withJohann from '../assets/photos/sinduri-johann.jpg';
import johannCeremony from '../assets/photos/johann-ceremony.jpg';
import ceremonyHands from '../assets/photos/ceremony-hands.jpg';
import johannLights from '../assets/photos/johann-lights.jpg';
import keralaSand from '../assets/photos/kerala-sand.jpg';
import starTrek from '../assets/photos/sinduri-star-trek.jpg';
import studioPortrait from '../assets/photos/sinduri-studio.jpg';
import minerva from '../assets/photos/minerva.jpg';
import hela from '../assets/photos/hela.jpg';
import rudra from '../assets/photos/rudra.jpg';
import mountainCamp from '../assets/photos/drupal-mountain-camp.webp';
import friendsMossWall from '../assets/photos/friends-moss-wall.jpg';
import escapeRoom from '../assets/photos/escape-room.jpg';
import kannurSea from '../assets/photos/kannur-sea.jpg';
import withFriend from '../assets/photos/pride-with-friend.jpg';
import dosa from '../assets/photos/sinduri-dosa.jpg';
import lectureHall from '../assets/photos/drupal-lecture-hall.jpg';
import mountainCampBeanie from '../assets/photos/mountain-camp-beanie.jpg';
import mountainCampTable from '../assets/photos/mountain-camp-table.jpg';
import mountainCampGroup from '../assets/photos/mountain-camp-group.jpg';
import { photoSize } from '../lib/photo-size';
import mountainCampDinner from '../assets/photos/mountain-camp-dinner.jpg';
import mountainCampTalk from '../assets/photos/mountain-camp-talk.jpg';
import mountainCampAudience from '../assets/photos/mountain-camp-audience.jpg';
import mountainCampFriend from '../assets/photos/mountain-camp-friend.jpg';
import mountainCampHallway from '../assets/photos/mountain-camp-hallway.jpg';
import rotterdamAward from '../assets/photos/drupalcon-rotterdam-award.jpg';
import PhotoStrip from '../components/PhotoStrip.astro';
import {
  LICENSED_PHOTOS,
  photographerHref,
  type Photographer,
} from '../lib/credits';
import { DENSITIES, WIDTHS } from '../lib/image-densities';
import { JOURNEY_POST_HREF } from '../lib/paths';

/*
 * Sinduri's own copy: add no line she has not approved, and keep her few
 * apostrophes ("I am", "it is"). Jump links repeat the headings verbatim.
 */

/* Matches `size-14`. */
const THUMB_SIZE = 56;

/*
 * Drawn widths net of gutter and padding. The `lg` terms omit the fluid column
 * gap, so they overstate by at most half a gap. tests/image-size.spec.ts fails on drift.
 */
const SIZES = {
  panorama:
    '(min-width: 40rem) min(calc(100vw - 9rem), 74rem), calc(100vw - 6rem)',
  halfCard:
    '(min-width: 64rem) min(calc(50vw - 120px), 34rem), (min-width: 40rem) calc(100vw - 9rem), calc(100vw - 6rem)',
} as const;

/* Matches `lg:h-16`. */
const MARK_HEIGHT = 64;

const MENTOR: Photographer = 'Klaus Purer';
const MOUNTAIN_CAMP_URL = 'https://drupalmountaincamp.ch/';
const MOUNTAIN_CAMP_PHOTOGRAPHER: Photographer = 'Josef Kruckenberg';
const EVENT_PHOTOGRAPHER: Photographer = 'Patrick Itten';
const ROTTERDAM_AWARD = LICENSED_PHOTOS['drupalcon-rotterdam-award'];
const ROTTERDAM_PHOTOGRAPHER: Photographer = ROTTERDAM_AWARD.photographer;

const SECTIONS = [
  { id: 'lepus-ridet', title: 'Why Lepus Ridet' },
  { id: 'believe', title: 'Positivity Advocate' },
  { id: 'people', title: 'People and Places' },
  { id: 'important-things', title: 'The Important Things' },
  { id: 'drupal', title: 'Engineer to Drupal' },
] as const;

/* On the `.aspect-frame`, so the border stays when a failed photo fades out. */
const PHOTO = 'border-4 border-border';

/* Uncaptioned by Sinduri's choice; the alt text names who is in each. */
const PLACES = [
  {
    src: bestFriendBeach,
    alt: 'Sinduri and her best friend Hemu walking on a beach.',
  },
  {
    src: johannCeremony,
    alt: 'Sinduri and Johann sitting on the floor during their wedding ceremony, Johann holding a leaf with a flower on it.',
  },
  {
    src: ceremonyHands,
    alt: 'At their wedding, Johann’s hands holding a leaf with two rings on it, above Sinduri’s hennaed hands and bangles.',
  },
  {
    src: johannLights,
    alt: 'Sinduri and Johann taking a selfie at night, under trees lit red and blue.',
  },
  {
    src: lake,
    alt: 'Sinduri in a pink dress on a balcony, with trees and a lake behind her.',
  },
  {
    src: rainbowPortrait,
    alt: 'Sinduri smiling, with a rainbow painted on her cheek and rainbow wings behind her.',
  },
  {
    src: kannurSea,
    alt: 'Sinduri standing at the edge of the sea in Kannur, Kerala, with her arms spread wide, a wave breaking behind her.',
  },
  {
    src: keralaSand,
    alt: 'Handprints in the sand around the words Kerala 2012.',
  },
  {
    src: escapeRoom,
    alt: 'Sinduri with a group after an escape room, two of them holding Mission Complete signs.',
  },
  {
    src: withFriend,
    alt: 'Sinduri leaning on a friend’s shoulder, both smiling into the camera.',
  },
  {
    src: mountainCampBeanie,
    alt: 'Sinduri in a pink beanie, laughing, with snowy mountains behind her.',
  },
] as const;

const DRUPAL_EVENTS = [
  {
    src: mountainCampGroup,
    alt: 'Sinduri in a pink beanie with a group of Drupal Mountain Camp attendees on a sunny terrace, snowy mountains behind them.',
  },
  {
    src: rotterdamAward,
    alt: 'Sinduri on stage at DrupalCon Rotterdam with the Women in Drupal Award winners, two of them holding trophies.',
  },
  {
    src: mountainCampHallway,
    alt: 'Sinduri holding a bottle among Drupal Mountain Camp attendees, in front of the event banner.',
  },
  {
    src: mountainCampAudience,
    alt: 'Sinduri in profile, listening to a talk at Drupal Mountain Camp.',
  },
  {
    src: mountainCampTalk,
    alt: 'Two speakers at the front of the Drupal Mountain Camp room, one reading from a sheet of paper, beside the Drupal and sponsor posters.',
  },
  {
    src: mountainCampDinner,
    alt: 'Sinduri smiling at a dinner table in a wooden restaurant at Drupal Mountain Camp, beside a friend serving salad.',
  },
  {
    src: mountainCampFriend,
    alt: 'Sinduri smiling at a friend across a dinner table at Drupal Mountain Camp.',
  },
] as const;

const CATS = [
  {
    id: 'minerva',
    src: minerva,
    name: 'Minerva',
    role: 'The elegant queen. She sips wine, eats watermelon and turns her nose up at meat.',
    alt: 'Minerva, a tabby cat, curled up on a blanket.',
  },
  {
    id: 'hela',
    src: hela,
    name: 'Hela',
    role: 'Tiny, anxious and a total dad’s girl. I suspect she is plotting to get rid of me and take my pillow.',
    alt: 'Hela, a white calico cat, asleep against a plush toy.',
  },
  {
    id: 'rudra',
    src: rudra,
    name: 'Rudra',
    role: 'A total mom’s boy. He follows me everywhere, pushes things off tables and hides under the covers when the doorbell rings.',
    alt: 'Rudra, a black cat, having his head stroked.',
  },
] as const;

/* Match `.cat-dialog-body`: w-48 on phones, w-72 from md (48rem). */
const CAT_PHOTO_WIDTHS = [192, 288, 384, 576];
const CAT_PHOTO_SIZES = '(min-width: 48rem) 288px, 192px';

/* Thanked in each cat's card for the idea; the link comes from the Credits list. */
const catInspiration = THANKS.find((person) => person.name === 'Arthur Lorenz');
if (!catInspiration) throw new Error('No THANKS entry for "Arthur Lorenz".');

/* Shown whole, in its own ratio, so nobody at the table is cut off. */
const tableSize = await photoSize(mountainCampTable);
const mossWallSize = await photoSize(friendsMossWall);

/*
 * A `.photo-pair` row from 40rem: the two photos share `min(100vw - 12rem,
 * 71rem)` in proportion to their ratios, as flex shrinks them to one height.
 */
const pairSizes = async (images: readonly [ImageMetadata, ImageMetadata]) => {
  const ratios = await Promise.all(
    images.map(async (image) => {
      const { width, height } = await photoSize(image);
      return width / height;
    }),
  );
  const total = ratios.reduce((sum, ratio) => sum + ratio, 0);
  return ratios.map((ratio) => {
    const share = (ratio / total).toFixed(4);
    return `(min-width: 40rem) min(calc((100vw - 12rem) * ${share}), calc(71rem * ${share})), calc(100vw - 7rem)`;
  });
};
const [johannSizes, selfieSizes] = await pairSizes([
  withJohann,
  bestFriendSelfie,
]);
const [lectureHallSizes, mountainCampSizes] = await pairSizes([
  lectureHall,
  mountainCamp,
]);

const catInfo: CatInfo[] = await Promise.all(
  CATS.map(async (cat) => {
    const photo = await getImage({
      src: cat.src,
      widths: CAT_PHOTO_WIDTHS,
      sizes: CAT_PHOTO_SIZES,
      format: 'webp',
    });
    return {
      id: cat.id,
      name: cat.name,
      role: cat.role,
      photo: {
        src: photo.src,
        srcset: photo.srcSet.attribute,
        sizes: CAT_PHOTO_SIZES,
        width: Number(photo.attributes['width']),
        height: Number(photo.attributes['height']),
        alt: cat.alt,
      },
    };
  }),
);
---

<BaseLayout
  title="About"
  description="Sinduri Guntupalli lives in Vienna with her husband and three cats. Read about her love of Lord of the Rings and how a civil engineer found Drupal."
  profile={{ portrait: studioPortrait }}
>
  <PageHero
    title="About Me"
    image={bicycle}
    imageAlt="Sinduri laughing as she rides a bicycle with a basket down a tree-lined path."
  >
    <p class="standfirst">
      I live in Vienna with my husband and three cats. I love open source, my
      friends, Lord of the Rings and One Piece.
    </p>

    <nav aria-label="On this page" class="mt-8">
      <ul class="flex flex-wrap gap-6">
        {SECTIONS.map((section) => (
          <li>
            <a href={`#${section.id}`} class="chip">
              {section.id === 'lepus-ridet' ? (
                <>
                  Why <span lang="la">Lepus Ridet</span>
                </>
              ) : (
                section.title
              )}
              <span class="sr-only">&nbsp;section</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHero>

  <Section id={SECTIONS[0].id} headless>
    <div class="flex flex-wrap items-center gap-6 lg:gap-8">
      <span class="flex size-20 shrink-0 rotate-3 items-center justify-center rounded-nav border-4 border-tile-edge bg-gold shadow-hard-bunny-8 lg:size-28 lg:shadow-hard-bunny-12">
        <Image
          src={bunnyDark}
          alt=""
          height={MARK_HEIGHT}
          densities={DENSITIES}
          class="h-11 w-auto lg:h-16"
        />
      </span>
      <div class="min-w-0">
        <h2 id="lepus-ridet-heading" class="text-h2 text-text">
          {/* &nbsp;: an ordinary space beside `.sr-only` collapses and Chromium copies "WHYLEPUS RIDET". */}
          <span class="sr-only">Why&nbsp;</span>
          <span lang="la">Lepus Ridet</span>
        </h2>
        <p class="mt-3 text-body text-text text-pretty">
          Latin for &ldquo;the hare laughs&rdquo;
        </p>
      </div>
    </div>

    <div class="cat-perch mt-head">
      <div class="cat-spot" id="cat-spot-minerva"></div>
      <div class="card">
        <p class="mb-paragraph text-lead font-black text-text text-pretty">
          My pet name is Bunny. My uncle started it: in a Telugu children’s
          poem, Bunny means a doll.
        </p>
        <p class="mt-4 max-w-measure text-body text-text text-pretty">
          I love the name. I do have bunny teeth, so people sometimes call me
          Bugs Bunny. The one downside is Playboy, so now I get a little
          embarrassed telling people my pet name.
        </p>
        <p class="mt-8">
          <a href="/credits/#name" class="chip">
            Where the name sinduri.lol comes from
          </a>
        </p>
      </div>
    </div>
  </Section>

  <Section id={SECTIONS[1].id} title={SECTIONS[1].title}>
    <div class="card-block grid lg:grid-cols-2">
      <blockquote class="card card-raised surface-gold flex flex-col justify-center">
        <span aria-hidden="true" class="self-start text-quote-mark font-black">
          &ldquo;
        </span>
        <p class="mt-6 text-h2 font-black text-pretty">
          We should all be a bit kinder and more empathetic.
        </p>
      </blockquote>
      <div class="card">
        <div class:list={['aspect-frame', PHOTO]}>
          <svg
            class="aspect-sizer"
            viewBox={`0 0 ${mossWallSize.width} ${mossWallSize.height}`}
            aria-hidden="true"
            focusable="false"
          />
          <Picture
            {...PHOTO_FORMATS}
            src={friendsMossWall}
            alt="Sinduri between two friends in front of a moss wall, all three smiling."
            width={mossWallSize.width}
            height={mossWallSize.height}
            widths={WIDTHS}
            sizes={SIZES.halfCard}
          />
        </div>
        <ul class="bullet-list mt-8 max-w-measure text-body text-text">
          <li>Be as generous with compliments as with critique.</li>
          <li>
            When someone is down, you do not need the right words. A hug and
            &ldquo;I am here for you&rdquo; help more than you think.
          </li>
          <li>
            Be kind to the people around you. It makes the world a little
            better.
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <Section
    id={SECTIONS[2].id}
    title={SECTIONS[2].title}
    lead="I moved to Vienna in 2017. Making friends gets harder as we grow older and move countries, so I am proud of the people who let me into their world."
  >
    <div class="cat-perch">
      <div class="cat-spot" id="cat-spot-hela"></div>
      <div class="card">
        <div class="photo-pair">
          <PhotoTile
            image={withJohann}
            alt="Sinduri and Johann at their wedding, sitting side by side in flower garlands, both smiling."
            group="people"
            sizes={johannSizes}
          />
          <PhotoTile
            image={bestFriendSelfie}
            alt="Sinduri taking a selfie with her best friend, Hemu."
            group="people"
            sizes={selfieSizes}
          />
        </div>

        <PhotoStrip
          id="people-photos"
          label="More photos"
          noun="photos"
          group="people"
          photos={PLACES}
        />
      </div>
    </div>
  </Section>

  <Section id={SECTIONS[3].id} title={SECTIONS[3].title}>
    {/* A <dl>, so short bold values are not paragraphs WAVE reads as headings. */}
    <div class="cat-perch">
      <div class="cat-spot" id="cat-spot-rudra"></div>
      <div class="card-block flex flex-col lg:flex-row">
        <dl class="card min-w-0 divide-y-4 divide-border lg:flex-1">
          <div class="pb-6">
            <dt class="label text-gold">Favourite story</dt>
            <dd class="mt-4">
              <span class="card-title block">Lord of the Rings</span>
              <span class="mt-2 block text-body text-text">
                A well-written story with fascinating characters. For once, the
                films did the books justice.
              </span>
            </dd>
          </div>
          <div class="py-6">
            <dt class="label text-gold">Fandoms</dt>
            <dd class="mt-4 flex items-start justify-between gap-4">
              <span class="card-title block text-pretty">
                One Piece, Star Trek, Star Wars
              </span>
              <Picture
                {...PHOTO_FORMATS}
                src={starTrek}
                alt="Sinduri in a Star Trek uniform."
                width={THUMB_SIZE}
                height={THUMB_SIZE}
                densities={DENSITIES}
                class="size-14 shrink-0 rounded-nav border-4 border-border object-cover"
              />
            </dd>
          </div>
          <div class="py-6">
            <dt class="label text-gold">Music</dt>
            <dd class="mt-4">
              <span class="card-title block text-pretty">
                The Killers, Hozier, Imagine Dragons, A.&nbsp;R. Rahman
              </span>
              <span class="mt-2 block text-body text-text">
                Plus &ldquo;Somebody That I Used to Know&rdquo;, &ldquo;Ho
                Hey&rdquo;, &ldquo;Spirits&rdquo;, &ldquo;Shut Up and
                Dance&rdquo; and &ldquo;You&rsquo;re Gonna Go Far, Kid&rdquo;.
              </span>
            </dd>
          </div>
          <div class="pt-6">
            <dt class="label text-gold">Food</dt>
            <dd class="mt-4">
              <span class="card-title block">A picky eater who loves food</span>
              <span class="mt-2 block text-body text-text">
                Smoky seafood, meat that melts but still has a crunch, pastries
                and cake. I hate bananas and avocados.
              </span>
            </dd>
          </div>
        </dl>
        <div class="card card-raised lg:flex lg:w-1/2 lg:shrink-0 lg:flex-col lg:justify-center">
          <div class:list={['aspect-frame aspect-square', PHOTO]}>
            <Picture
              {...PHOTO_FORMATS}
              src={dosa}
              alt="Sinduri, eyes closed, about to take a bite of dosa with her hand."
              widths={WIDTHS}
              sizes={SIZES.halfCard}
            />
          </div>
        </div>
      </div>
    </div>

    <p class="mt-grid text-body text-subtle">
      The moving cats are drawn with AI.
    </p>
  </Section>

  <Section id={SECTIONS[4].id} title={SECTIONS[4].title}>
    <p slot="lead" class="lead">
      There is a Sinduri before <a href={photographerHref(MENTOR)}>{MENTOR}</a>{' '}
      and Drupal, and a Sinduri after.
    </p>

    <div class="card">
      <figure class="mb-8">
        <div class:list={['aspect-frame', PHOTO]}>
          <svg
            class="aspect-sizer"
            viewBox={`0 0 ${tableSize.width} ${tableSize.height}`}
            aria-hidden="true"
            focusable="false"
          />
          <Picture
            {...PHOTO_FORMATS}
            src={mountainCampTable}
            alt="Sinduri laughing with friends around a red-lit table at Drupal Mountain Camp, one of them holding up a toy frog on a fork."
            width={tableSize.width}
            height={tableSize.height}
            widths={WIDTHS}
            sizes={SIZES.panorama}
          />
        </div>
        <figcaption class="mt-4 text-body text-text">
          <span class="block font-black">Drupal Mountain Camp</span>
          Photo:{' '}
          <a href={photographerHref(MOUNTAIN_CAMP_PHOTOGRAPHER)}>
            {MOUNTAIN_CAMP_PHOTOGRAPHER}
          </a>
        </figcaption>
      </figure>

      <div class="flex flex-col gap-8 sm:flex-row">
        <div class="min-w-0 sm:flex-1">
          <span class="label block text-gold">Before</span>
          <p class="mt-3 text-body text-text text-pretty">
            I studied civil engineering in India and environmental engineering
            in the US, but I always wanted to be a computer engineer. Maths
            always came easily to me; languages never did. When I moved to
            Vienna, I enjoyed German grammar, but I still cannot remember the
            vocabulary or reproduce the sounds I hear. Tech had jobs in English,
            so in 2019 I took a one-week Python course. I enjoyed it so much
            that I signed up for a full-stack web development course and loved
            learning and coding every day.
          </p>
        </div>
        <div class="min-w-0 sm:flex-1">
          <span class="label block text-gold">After</span>
          <p class="mt-3 text-body text-text text-pretty">
            Finding a first job without connections was hard, and then the
            pandemic hit. Then Klaus Purer found me on LinkedIn and gave me a
            Drupal test. I had absolutely no idea what Drupal was, but I got the
            job in January 2021. I am so fortunate that my first job was with
            someone who believes in open source. Since then I have helped
            organise Drupal events across Europe, and{' '}
            <a href={MOUNTAIN_CAMP_URL}>Drupal Mountain Camp</a> is my
            favourite. In 2025 I won the Women in Drupal Award in the Build
            category.
          </p>
        </div>
      </div>

      <div class="photo-pair mt-8">
        <PhotoTile
          image={lectureHall}
          alt="Sinduri standing and clapping in a lecture hall full of Drupal event attendees."
          group="drupal"
          sizes={lectureHallSizes}
        >
          <span class="block font-black text-text">The Drupal community</span>
          <LicensedPhotoCredit photo="drupal-lecture-hall" />
        </PhotoTile>
        <PhotoTile
          image={mountainCamp}
          alt="Drupal Mountain Camp attendees gathered together in the snow."
          group="drupal"
          sizes={mountainCampSizes}
        >
          <span class="block font-black text-text">Drupal Mountain Camp</span>
          Photo:{' '}
          <a href={photographerHref(EVENT_PHOTOGRAPHER)}>
            {EVENT_PHOTOGRAPHER}
          </a>
        </PhotoTile>
      </div>

      <PhotoStrip
        id="drupal-photos"
        label="Drupal events"
        noun="Drupal photos"
        group="drupal"
        photos={DRUPAL_EVENTS}
      />
      <p class="mt-4 text-body text-subtle">
        Photos:{' '}
        <a href={photographerHref(ROTTERDAM_PHOTOGRAPHER)}>
          {ROTTERDAM_PHOTOGRAPHER}
        </a>{' '}
        at DrupalCon Rotterdam (
        <a href={ROTTERDAM_AWARD.source}>{ROTTERDAM_AWARD.title}</a> on{' '}
        {ROTTERDAM_AWARD.sourceName},{' '}
        <a href={ROTTERDAM_AWARD.licenceHref}>{ROTTERDAM_AWARD.licence}</a>,{' '}
        {ROTTERDAM_AWARD.changes}),{' '}
        <a href={photographerHref(MOUNTAIN_CAMP_PHOTOGRAPHER)}>
          {MOUNTAIN_CAMP_PHOTOGRAPHER}
        </a>{' '}
        at Drupal Mountain Camp.
      </p>
    </div>
  </Section>

  <CloseRow
    readHref={JOURNEY_POST_HREF}
    readLabel="Five Years in Drupal"
    actionHref="/career/"
    actionLabel="Career"
  />

  <PhotoViewer />
  <AboutCats
    client:load
    cats={catInfo}
    inspiration={{
      name: catInspiration.name.split(' ')[0] ?? catInspiration.name,
      href: catInspiration.href,
    }}
  />
</BaseLayout>
