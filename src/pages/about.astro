---
import { Image } from 'astro:assets';
import bunnyDark from '../assets/bunny-dark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderBox from '../components/PlaceholderBox.astro';
import { DENSITIES } from '../lib/image-densities';

/*
 * Sinduri's own copy, built from her writing. Layout, spacing and hierarchy
 * are design/About.dc.html's.
 *
 * Two deliberate departures from the comp. The personal sections come before
 * the story, because she wants the page to be about her first and her work
 * second; the section rules keep the comp's gold, cyan, pink order by position.
 * And the closing call to action points at Career rather than Contact, with a
 * label that matches where it goes.
 *
 * Her voice uses few apostrophes: "I am", "it is". Keep that when editing.
 */

/** The bunny roundel's mark, drawn `h-14`. See the note in Header.astro. */
const ROUNDEL_MARK_HEIGHT = 56;

const JOURNEY_POST_HREF = '/blog/five-years-in-drupal/';

const INTERESTS = [
  {
    value: 'Middle-earth',
    frame: 'border-gold',
    valueClass: 'text-gold',
    body: 'Watching the extended versions of Lord of the Rings every year is a sacred tradition!',
  },
  {
    value: 'Fandoms',
    frame: 'border-cyan',
    valueClass: 'text-cyan',
    body: 'I am also a huge fan of Star Trek, One Piece and Star Wars.',
  },
  {
    value: 'Three cats',
    frame: 'border-pink',
    valueClass: 'text-pink-text',
    body: 'Minerva, the queen of the house. Hela, the conspirator. Rudra, the baby of the family.',
  },
] as const;
---

<BaseLayout
  title="About | sinduri.lol"
  description="Sinduri in Vienna: cats, Lord of the Rings, kindness, and how a civil engineer found her way into the Drupal community."
>
  {/* ===================================================================
       HERO
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <span class="section-number" aria-hidden="true">
          01
        </span>
        <h1 class="text-h1 text-text">About me</h1>
      </div>

      <div class="mt-14 grid gap-16 lg:grid-cols-2 lg:items-start">
        <div class="flex min-w-0 flex-col gap-8">
          <p class="text-h3 font-bold text-gold text-pretty">
            Open source enthusiast in Vienna, cat lover, and a very serious Lord
            of the Rings fan.
          </p>
          <p class="text-body text-muted text-pretty">
            I moved to Vienna in 2017. I love cats, travelling, and long
            evenings with my friends talking about nothing and anything.
          </p>
          <p class="text-body text-muted text-pretty">
            I love food but I am a picky eater, and my music taste is all over
            the place.
          </p>
        </div>

        <div class="relative">
          <PlaceholderBox ratio="portrait" label="portrait" />
          {/*
            The offset frame from the comp, drawn as a second border rather
            than a shadow. Decoration with no meaning, so pointer-events-none
            and out of the accessibility tree. `pink` is right here because it
            is a border and never a glyph.
          */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -left-3 -top-3 hidden size-full border-8 border-pink sm:block"
          ></span>
          {/*
            `sm:-right-6`, the width of the `sm` gutter, so the roundel
            overhangs the frame as far as the page allows and no further.
            Anything past the gutter scrolls the page sideways from 640px up.
          */}
          <span class="absolute -bottom-8 -right-2 flex size-28 items-center justify-center rounded-full border-8 border-border bg-gold shadow-hard-cyan-8 sm:-right-6">
            <Image
              src={bunnyDark}
              alt=""
              height={ROUNDEL_MARK_HEIGHT}
              densities={DENSITIES}
              class="h-14 w-auto"
            />
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* ===================================================================
       VALUES
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-gold"></span>
    </div>

    <div class="mx-auto grid max-w-page gap-16 lg:grid-cols-2 lg:items-start">
      <div class="flex min-w-0 flex-col gap-6">
        <h2 class="text-h2 text-text">Kindness first.</h2>
        <p class="text-body text-muted text-pretty">
          I believe everything can be said with empathy and kindness.
        </p>
        <p class="text-body text-muted text-pretty">
          That is also what I love about open source. People contribute based on
          passion and expertise, not hierarchy, and there is room for everyone.
        </p>
      </div>

      <div class="card shadow-hard-pink-8">
        <p class="label-wide text-pink-text">One thing I never do</p>
        <p class="mt-6 text-h3 font-bold text-text text-pretty">
          Say no to a challenge just because I do not know how to approach it.
        </p>
        <p class="mt-6 text-body text-muted text-pretty">
          I commit to figuring it out and learning whatever it takes to make it
          work.
        </p>
      </div>
    </div>
  </section>

  {/* ===================================================================
       INTERESTS AND FUN FACTS
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-cyan"></span>
    </div>

    <div class="mx-auto max-w-page">
      <h2 class="text-h2 text-text">The important things.</h2>

      <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {INTERESTS.map((item) => (
          <li
            class:list={[
              'flex min-w-0 flex-col gap-4 border-8 bg-background p-8',
              item.frame,
            ]}
          >
            <span class:list={['text-h3 font-extrabold', item.valueClass]}>
              {item.value}
            </span>
            <p class="text-body text-muted text-pretty">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ===================================================================
       STORY
       =================================================================== */}
  <section class="band py-24">
    <div class="mx-auto max-w-page">
      <span class="section-rule bg-pink"></span>
    </div>

    <div class="mx-auto max-w-page">
      <h2 class="text-h2 text-text">
        There is a Sinduri before Klausi and Drupal, and a Sinduri after.
      </h2>

      <div class="mt-14 grid gap-10 lg:grid-cols-2">
        <div class="card shadow-hard-gold-8">
          <p class="label-wide text-gold">Before</p>
          <p class="mt-6 text-body text-muted text-pretty">
            I studied civil engineering in India and environmental engineering
            in the US. I always wanted to become a developer, but I never felt
            ready until I moved to Vienna. Honestly, after a few German courses,
            learning to code seemed much easier! A short Python course in 2019
            showed me I loved programming, and a full-stack web development
            course gave me the confidence to make the switch.
          </p>
        </div>

        <div class="card shadow-hard-cyan-8">
          <p class="label-wide text-cyan">After</p>
          <p class="mt-6 text-body text-muted text-pretty">
            In January 2021, Klaus Purer gave me a Drupal test. I had absolutely
            no idea what Drupal was, but I did well enough to get the job. Since
            then I have organised Drupal events, joined the Drupal Austria
            board, where I am deputy marketing manager in 2026, and won the
            Women in Drupal Award in 2025. I wrote the whole story down in
            <a href={JOURNEY_POST_HREF}>Five years in Drupal</a>.
          </p>
        </div>
      </div>

      <div class="card mt-14 shadow-hard-gold-8">
        <p class="text-h3 font-bold text-text text-pretty">
          There is room for everyone in open source.
        </p>
        <p class="mt-8 max-w-4xl text-body text-muted text-pretty">
          Developers, designers, writers, marketers and managers. The skills you
          build while contributing carry into every part of life. If you are
          thinking about getting involved, come say hello.
        </p>
        <p class="mt-10">
          <a href="/career/" class="btn-primary">
            See my career
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
