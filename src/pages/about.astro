---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/photos/sinduri-pride.jpg';
import lake from '../assets/photos/sinduri-lake.jpg';
import bicycle from '../assets/photos/sinduri-bicycle.jpg';
import bestFriendSelfie from '../assets/photos/best-friend-selfie.jpg';
import bestFriendBeach from '../assets/photos/best-friend-beach.jpg';
import withJohann from '../assets/photos/sinduri-johann.jpg';
import starTrek from '../assets/photos/sinduri-star-trek.jpg';
import minerva from '../assets/photos/minerva.jpg';
import hela from '../assets/photos/hela.jpg';
import rudra from '../assets/photos/rudra.jpg';
import mountainCamp from '../assets/photos/drupal-mountain-camp.jpg';
import friendsMossWall from '../assets/photos/friends-moss-wall.jpg';
import escapeRoom from '../assets/photos/escape-room.jpg';
import { DENSITIES, WIDTHS } from '../lib/image-densities';

/*
 * Sinduri's own copy, set as a magazine issue: a cover, then four spreads.
 * The cover lines are the table of contents and link to the spreads, and the
 * spread titles echo her tagline, Open Source Enthusiast and Positivity
 * Advocate. The magazine vocabulary (running head, kicker, standfirst, drop
 * cap, pull quote) is in global.css under `.mag-`.
 *
 * Her voice uses few apostrophes: "I am", "it is". Keep that when editing,
 * and add no line she has not said or approved.
 */

const JOURNEY_POST_HREF = '/blog/five-years-in-drupal/';

/** The Fandoms thumbnail, drawn `size-14`. */
const THUMB_SIZE = 56;

/** The Johann photo, drawn `w-64`; its master is only 278px wide. */
const JOHANN_WIDTH = 256;

/*
 * Only used to pick a file from WIDTHS; tests/image-size.spec.ts measures the
 * result. Each names the column the photo fills from `lg`, and the page
 * column below it.
 */
const SIZES = {
  cover: '(min-width: 64rem) 46rem, 100vw',
  sideColumn: '(min-width: 64rem) 32rem, 100vw',
  sidePair: '(min-width: 64rem) 16rem, 50vw',
  third: '(min-width: 64rem) 16rem, (min-width: 40rem) 33vw, 100vw',
  essayLead: '(min-width: 64rem) 52rem, 100vw',
  essaySide: '(min-width: 64rem) 26rem, 100vw',
} as const;

const SPREADS = [
  {
    id: 'vienna',
    title: 'Vienna since 2017',
    teaser: 'Cats, friends and long evenings',
  },
  {
    id: 'positivity',
    title: 'Positivity advocate',
    teaser: 'Why we should all be a bit kinder',
  },
  {
    id: 'important-things',
    title: 'The important things',
    teaser: 'Middle-earth, fandoms and three cats',
  },
  {
    id: 'open-source',
    title: 'Open source enthusiast',
    teaser: 'A Sinduri before Drupal, and after',
  },
] as const;

const CATS = [
  {
    src: minerva,
    name: 'Minerva',
    role: 'the queen of the house.',
    alt: 'Minerva, a tabby cat, curled up on a blanket.',
  },
  {
    src: hela,
    name: 'Hela',
    role: 'the conspirator.',
    alt: 'Hela, a white calico cat, asleep against a plush toy.',
  },
  {
    src: rudra,
    name: 'Rudra',
    role: 'the baby of the family.',
    alt: 'Rudra, a black cat, having his head stroked.',
  },
] as const;

const SPREAD_NUMBER_DIGITS = 2;
const spreadNumber = (index: number): string =>
  String(index + 1).padStart(SPREAD_NUMBER_DIGITS, '0');
---

<BaseLayout
  title="About | sinduri.lol"
  description="Sinduri in Vienna: cats, Lord of the Rings, positivity, and how a civil engineer found her way into the Drupal community."
>
  {/* ===================================================================
       COVER
       =================================================================== */}
  <section class="band py-16">
    <div class="mx-auto max-w-page">
      <div class="mag-cover">
        <div class="flex min-w-0 flex-col gap-10">
          <p class="mag-dateline">
            <span class="mag-kicker text-text">sinduri.lol</span>
            <span class="mag-kicker text-muted">Vienna · Since 2017</span>
          </p>

          <div class="flex flex-col gap-6">
            <h1 class="text-h1 text-text">About me</h1>
            <p class="text-h3 font-black text-gold text-pretty">
              Open source enthusiast in Vienna, cat lover, and a very serious
              Lord of the Rings fan.
            </p>
          </div>

          <nav aria-label="In this issue">
            <ol class="grid gap-5">
              {SPREADS.map((spread, index) => (
                <li>
                  <a href={`#${spread.id}`} class="mag-coverline">
                    <span class="mag-kicker">{spreadNumber(index)}</span>
                    <span class="mag-coverline-title">{spread.title}</span>
                    <span class="text-label text-muted">{spread.teaser}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>

        <Image
          src={bicycle}
          alt="Sinduri laughing as she rides a bicycle with a basket down a tree-lined path."
          widths={WIDTHS}
          sizes={SIZES.cover}
          loading="eager"
          class="block aspect-portrait h-auto w-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* ===================================================================
       01 VIENNA SINCE 2017
       =================================================================== */}
  <section class="band pb-24" id={SPREADS[0].id}>
    <div class="mx-auto max-w-page">
      <p class="mag-runhead" aria-hidden="true">
        <span>
          <span class="text-text">01</span> · {SPREADS[0].title}
        </span>
        <span>sinduri.lol</span>
      </p>

      <div class="mag-spread-7-5 mt-14 grid gap-14 lg:items-start">
        <div class="flex min-w-0 flex-col gap-6">
          <p class="mag-kicker">Home</p>
          <h2 id="spread-vienna" class="text-h1 text-text">
            Vienna <span class="text-gold">since 2017</span>
          </h2>
          <p class="mag-standfirst">
            I moved to Vienna in 2017. I love cats, travelling, and long
            evenings with my friends talking about nothing and anything.
          </p>
        </div>

        <div class="flex min-w-0 flex-col gap-6">
          <figure>
            <Image
              src={lake}
              alt="Sinduri in a pink dress on a balcony, with trees and a lake behind her."
              widths={WIDTHS}
              sizes={SIZES.sideColumn}
              class="block aspect-portrait h-auto w-full object-cover"
            />
            <figcaption class="mag-caption">
              <strong class="text-text">Travelling.</strong>
            </figcaption>
          </figure>
          <figure>
            <div class="grid grid-cols-2 gap-3">
              <Image
                src={bestFriendSelfie}
                alt="Sinduri taking a selfie with her best friend, Hemu."
                widths={WIDTHS}
                sizes={SIZES.sidePair}
                class="block aspect-square h-auto w-full object-cover"
              />
              <Image
                src={bestFriendBeach}
                alt="Sinduri and her best friend Hemu walking on a beach."
                widths={WIDTHS}
                sizes={SIZES.sidePair}
                class="block aspect-square h-auto w-full object-cover"
              />
            </div>
            <figcaption class="mag-caption">
              <strong class="text-text">My best friend,</strong> Hemu.
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  {/* ===================================================================
       02 POSITIVITY ADVOCATE
       =================================================================== */}
  <section class="band pb-24" id={SPREADS[1].id}>
    <div class="mx-auto max-w-page">
      <p class="mag-runhead" aria-hidden="true">
        <span>
          <span class="text-text">02</span> · {SPREADS[1].title}
        </span>
        <span>sinduri.lol</span>
      </p>

      <div class="mag-spread-5-7 mt-14 grid gap-14 lg:items-start">
        <div class="flex min-w-0 flex-col gap-10">
          <Image
            src={portrait}
            alt="Sinduri smiling, with a rainbow painted on her cheek and rainbow wings behind her."
            widths={WIDTHS}
            sizes={SIZES.sideColumn}
            class="block aspect-portrait h-auto w-full object-cover"
          />
          <figure class="w-64 max-w-full">
            <Image
              src={withJohann}
              alt="Sinduri smiling with Johann, his arms wrapped around her."
              width={JOHANN_WIDTH}
              densities={DENSITIES}
              class="block aspect-portrait h-auto w-full object-cover"
            />
            <figcaption class="mag-caption">
              <strong class="text-text">Johann,</strong> my husband and the
              non-Drupaler who always has my back.
            </figcaption>
          </figure>
        </div>

        <div class="flex min-w-0 flex-col gap-6">
          <p class="mag-kicker">What I believe</p>
          <h2 id="spread-positivity" class="text-h1 text-text">
            Positivity <span class="text-gold">advocate</span>
          </h2>
          <blockquote class="mt-4">
            <span class="mag-quote-mark" aria-hidden="true">
              &ldquo;
            </span>
            <p class="mag-quote">
              We should all be a bit kinder and more empathetic.
            </p>
          </blockquote>
          <p class="max-w-prose text-body text-muted text-pretty">
            That is also what I love about open source: people contribute based
            on passion and expertise, not hierarchy, and there is room for
            everyone.
          </p>
          <div class="mt-4 flex flex-col gap-2 border-t-4 border-border pt-5">
            <p class="mag-kicker text-pink-text">One thing I never do</p>
            <p class="text-h3 font-bold text-text text-pretty">
              Say no to a challenge just because I do not know how to approach
              it.
            </p>
            <p class="max-w-prose text-body text-muted text-pretty">
              I commit to figuring it out and learning whatever it takes to make
              it work.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===================================================================
       03 THE IMPORTANT THINGS
       =================================================================== */}
  <section class="band pb-24" id={SPREADS[2].id}>
    <div class="mx-auto max-w-page">
      <p class="mag-runhead" aria-hidden="true">
        <span>
          <span class="text-text">03</span> · {SPREADS[2].title}
        </span>
        <span>sinduri.lol</span>
      </p>

      <div class="mag-spread-4-8 mt-14 grid gap-14 lg:items-start">
        <div class="surface-gold flex flex-col gap-3 p-8">
          <p class="mag-kicker text-gold-text">Fact file</p>
          <h2 id="spread-important" class="text-h3">
            The important things
          </h2>
        </div>

        <div class="flex min-w-0 flex-col gap-12">
          <dl class="mag-facts">
            <div>
              <dt>Sacred tradition</dt>
              <dd>
                Lord of the Rings
                <span class="block text-label font-normal text-muted">
                  The extended versions, every year
                </span>
              </dd>
            </div>
            <div>
              <dt>Fandoms</dt>
              <dd class="flex items-center justify-between gap-4">
                Star Trek, One Piece, Star Wars
                <Image
                  src={starTrek}
                  alt="Sinduri in a Star Trek uniform."
                  width={THUMB_SIZE}
                  height={THUMB_SIZE}
                  densities={DENSITIES}
                  class="size-14 rounded-full object-cover"
                />
              </dd>
            </div>
            <div>
              <dt>Food</dt>
              <dd>
                Love it
                <span class="block text-label font-normal text-muted">
                  But I am a picky eater
                </span>
              </dd>
            </div>
            <div>
              <dt>Music</dt>
              <dd>All over the place</dd>
            </div>
          </dl>

          <div class="flex flex-col gap-4">
            <p class="mag-kicker">Three cats</p>
            <ul class="grid gap-4 sm:grid-cols-3">
              {CATS.map((cat) => (
                <li>
                  <figure>
                    <Image
                      src={cat.src}
                      alt={cat.alt}
                      widths={WIDTHS}
                      sizes={SIZES.third}
                      class="block aspect-square h-auto w-full object-cover"
                    />
                    <figcaption class="mag-caption">
                      <strong class="text-text">{cat.name},</strong> {cat.role}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===================================================================
       04 OPEN SOURCE ENTHUSIAST
       =================================================================== */}
  <section class="band pb-24" id={SPREADS[3].id}>
    <div class="mx-auto max-w-page">
      <p class="mag-runhead" aria-hidden="true">
        <span>
          <span class="text-text">04</span> · {SPREADS[3].title}
        </span>
        <span>sinduri.lol</span>
      </p>

      <div class="mt-14 flex flex-col gap-6">
        <p class="mag-kicker">The story</p>
        <h2 id="spread-open-source" class="text-h1 text-text">
          Open source <span class="text-gold">enthusiast</span>
        </h2>
        <p class="mag-standfirst">
          There is a Sinduri before Klausi and Drupal, and a Sinduri after.
        </p>
      </div>

      <div class="mag-columns mt-10 max-w-5xl">
        <div class="mb-8">
          <p class="mag-kicker mb-2">Before</p>
          <p class="mag-dropcap text-body text-muted text-pretty">
            I studied civil engineering in India and environmental engineering
            in the US. I always wanted to become a developer, but I never felt
            ready until I moved to Vienna. Honestly, after a few German courses,
            learning to code seemed much easier! A short Python course in 2019
            showed me I loved programming, and a full-stack web development
            course gave me the confidence to make the switch.
          </p>
        </div>
        <div class="mb-8">
          <p class="mag-kicker mb-2">After</p>
          <p class="text-body text-muted text-pretty">
            In January 2021, Klaus Purer gave me a Drupal test. I had absolutely
            no idea what Drupal was, but I did well enough to get the job. Since
            then I have organised Drupal events, joined the Drupal Austria
            board, where I am deputy marketing manager in 2026, and won the
            Women in Drupal Award in 2025.
          </p>
        </div>
      </div>

      <div class="mag-essay mt-10 grid gap-4">
        <figure>
          <Image
            src={mountainCamp}
            alt="The Drupal Mountain Camp group photo: a crowd of attendees standing in the snow."
            widths={WIDTHS}
            sizes={SIZES.essayLead}
            class="block aspect-video h-auto w-full object-cover"
          />
          <figcaption class="mag-caption">
            <strong class="text-text">Drupal Mountain Camp.</strong>
          </figcaption>
        </figure>
        <div class="flex flex-col gap-4">
          <figure>
            <Image
              src={friendsMossWall}
              alt="Sinduri between two friends in front of a moss wall, all three looking up and laughing."
              widths={WIDTHS}
              sizes={SIZES.essaySide}
              class="block aspect-photo h-auto w-full object-cover"
            />
            <figcaption class="mag-caption">
              <strong class="text-text">With friends.</strong>
            </figcaption>
          </figure>
          <figure>
            <Image
              src={escapeRoom}
              alt="Sinduri with a group after an escape room, two of them holding Mission Complete signs."
              widths={WIDTHS}
              sizes={SIZES.essaySide}
              class="block aspect-photo h-auto w-full object-cover"
            />
            <figcaption class="mag-caption">
              <strong class="text-text">Mission complete.</strong>
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t-4 border-border pt-6">
        <p class="text-body text-text">
          Continue reading: <a href={JOURNEY_POST_HREF}>Five years in Drupal</a>
        </p>
        <a href="/career/" class="btn-primary">
          See my career
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
