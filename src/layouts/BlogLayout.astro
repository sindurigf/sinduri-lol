---
import BaseLayout from './BaseLayout.astro';
import type { ArticleMeta } from '../lib/structured-data';
import type { Trail } from '../lib/breadcrumbs';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: ArticleMeta;
  trail?: Trail;
}

const { title, description, ogImage, article, trail } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  article={article}
  trail={trail}
>
  <article>
    <slot />
  </article>
</BaseLayout>
