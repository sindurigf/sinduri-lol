---
/*
 * The approved rabbit's face rising from behind a section's bottom edge, eyes
 * open. The viewBox ends at the chin line (y 0), so the edge hides the rest.
 * Decoration: hidden from assistive technology, never moves.
 */
---

<svg
  class="rabbit-peek"
  viewBox="-32.6 -92.1 68.8 92.1"
  aria-hidden="true"
  focusable="false"
>
  <g transform="translate(0 63.9)">
    <g class="rabbit-throw" transform="translate(3.6 3.6)">
      <ellipse
        class="rabbit-edge"
        cx="9"
        cy="-123.5"
        rx="7.5"
        ry="25"
        transform="rotate(4 9 -98.5)"
      />
      <ellipse
        class="rabbit-edge"
        cx="-9"
        cy="-123.5"
        rx="7.5"
        ry="25"
        transform="rotate(-10 -9 -98.5)"
      />
      <ellipse class="rabbit-edge" cx="0" cy="-78" rx="25.6" ry="25.6" />
    </g>
    <ellipse
      class="rabbit-edge"
      cx="9"
      cy="-123.5"
      rx="7.5"
      ry="25"
      transform="rotate(4 9 -98.5)"
    />
    <ellipse
      class="rabbit-edge"
      cx="-9"
      cy="-123.5"
      rx="7.5"
      ry="25"
      transform="rotate(-10 -9 -98.5)"
    />
    <ellipse
      class="rabbit-body"
      cx="9"
      cy="-123.5"
      rx="7.5"
      ry="25"
      transform="rotate(4 9 -98.5)"
    />
    <ellipse
      class="rabbit-body"
      cx="-9"
      cy="-123.5"
      rx="7.5"
      ry="25"
      transform="rotate(-10 -9 -98.5)"
    />
    <ellipse class="rabbit-edge" cx="0" cy="-78" rx="25.6" ry="25.6" />
    <ellipse class="rabbit-body" cx="0" cy="-78" rx="25.6" ry="25.6" />
    <ellipse
      class="rabbit-ear"
      cx="9"
      cy="-123.5"
      rx="3"
      ry="15"
      transform="rotate(4 9 -98.5)"
    />
    <ellipse
      class="rabbit-ear"
      cx="-9"
      cy="-123.5"
      rx="3"
      ry="15"
      transform="rotate(-10 -9 -98.5)"
    />
    <g>
      <ellipse class="rabbit-ink" cx="-11.5" cy="-83.1" rx="6.5" ry="8.4" />
      <circle class="rabbit-shine" cx="-9.4" cy="-86.5" r="3" />
      <path
        class="rabbit-shine"
        d="M-13.8 -82.3Q-13.3 -80.3 -11.3 -79.8Q-13.3 -79.3 -13.8 -77.3Q-14.3 -79.3 -16.4 -79.8Q-14.3 -80.3 -13.8 -82.3Z"
      />
      <circle class="rabbit-shine" cx="-8.5" cy="-78.8" r="1" />
    </g>
    <g>
      <ellipse class="rabbit-ink" cx="11.5" cy="-83.1" rx="6.5" ry="8.4" />
      <circle class="rabbit-shine" cx="13.6" cy="-86.5" r="3" />
      <path
        class="rabbit-shine"
        d="M9.3 -82.3Q9.8 -80.3 11.9 -79.8Q9.8 -79.3 9.3 -77.3Q8.8 -79.3 6.8 -79.8Q8.8 -80.3 9.3 -82.3Z"
      />
      <circle class="rabbit-shine" cx="14.5" cy="-78.8" r="1" />
