---
import {
  FIELDS,
  LIMITS,
  type ContactSubmission,
  type FieldError,
} from '../lib/contact-form';

/*
 * The contact form, rendered twice: empty on /contact, and refilled with the
 * submitted values and their errors by /contact/send when validation fails.
 * One component so the two cannot drift, and so a visitor who hits an error
 * can fix and resubmit without going back.
 */

interface Props {
  errors?: FieldError[];
  values?: Partial<ContactSubmission>;
}

const { errors = [], values = {} } = Astro.props;

const errorFor = (field: FieldError['field']): string | undefined =>
  errors.find((error) => error.field === field)?.message;

const nameError = errorFor('name');
const emailError = errorFor('email');
const bodyError = errorFor('body');

const ACTION = '/contact/send/';
---

{errors.length > 0 && (
  /*
   * role="alert" announces it, autofocus and tabindex put the reader on it.
   * Each entry links to its own control, which is what makes the summary
   * useful rather than decorative.
   */
  <div class="error-summary" role="alert" tabindex="-1" autofocus>
    <h3 class="text-h3 text-text">
      {errors.length === 1
        ? 'There is one problem with this form'
        : `There are ${errors.length} problems with this form`}
    </h3>
    <ul class="mt-4 list-disc pl-6">
      {errors.map((error) => (
        <li class="mt-2 text-body">
          <a href={`#contact-${error.field}`}>{error.message}</a>
        </li>
      ))}
    </ul>
  </div>
)}

<form method="post" action={ACTION} class="mt-10">
  <div class="field">
    <label class="field-label" for="contact-name">
      Name
    </label>
    <input
      class="field-control"
      id="contact-name"
      name={FIELDS.name}
      type="text"
      autocomplete="name"
      maxlength={LIMITS.nameMax}
      required
      value={values.name ?? ''}
      aria-invalid={nameError ? 'true' : undefined}
      aria-describedby={nameError ? 'contact-name-error' : undefined}
    />
    {nameError && (
      <p class="field-error" id="contact-name-error">
        {nameError}
      </p>
    )}
  </div>

  <div class="field">
    <label class="field-label" for="contact-email">
      Email
    </label>
    <input
      class="field-control"
      id="contact-email"
      name={FIELDS.email}
      type="email"
      autocomplete="email"
      maxlength={LIMITS.emailMax}
      required
      value={values.email ?? ''}
      aria-invalid={emailError ? 'true' : undefined}
      aria-describedby={
        emailError
          ? 'contact-email-error contact-email-hint'
          : 'contact-email-hint'
      }
    />
    <p class="mt-3 text-body text-muted" id="contact-email-hint">
      Used to reply, and nothing else.
    </p>
    {emailError && (
      <p class="field-error" id="contact-email-error">
        {emailError}
      </p>
    )}
  </div>

  <div class="field">
    <label class="field-label" for="contact-message">
      Message
    </label>
    <textarea
      class="field-control"
      id="contact-message"
      name={FIELDS.body}
      rows="8"
      maxlength={LIMITS.bodyMax}
      required
      aria-invalid={bodyError ? 'true' : undefined}
      aria-describedby={bodyError ? 'contact-message-error' : undefined}
    >{values.body ?? ''}</textarea>
    {bodyError && (
      <p class="field-error" id="contact-message-error">
        {bodyError}
      </p>
    )}
  </div>

  {/*
    The honeypot, `hidden` rather than positioned off-screen.

    Off-screen was tried and reverted: it leaves a real control in the tab
    order's selector that no keyboard can reach, which tests/focus.spec.ts
    reports as SC 2.1.1, and with no border or fill, which
    tests/forced-colors.spec.ts reports as having no edges. Both are right, and
    excluding the field from them would blunt two checks that exist to catch
    exactly that shape. `hidden` removes it from layout, from the tab order and
    from the accessibility tree, and still leaves a text input in the markup
    for anything filling in every field it parses.
  */}
  <div hidden>
    <label for="contact-website" hidden>
      Website
    </label>
    <input
      hidden
      id="contact-website"
      name={FIELDS.honeypot}
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <button class="btn-primary mt-10" type="submit">
    Send message
  </button>
</form>
