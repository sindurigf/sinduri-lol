---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { DENSITIES } from '../lib/image-densities';

/*
 * A photo pinned to the page at a tilt, with a hard offset shadow.
 *
 * Two fixed shapes, each a box the file is cropped to, so upright and wide
 * photos sit side by side without either being stretched. The rotation is
 * static, so it is not motion and needs no reduced-motion override.
 *
 * A wide tile is 288px, wider than the 273px column at 305px, so it is capped
 * at the column and only tilted from `sm`: a rotated box counts towards
 * scrollable overflow and would scroll the page sideways (SC 1.4.10).
 * object-cover keeps the capped photo from being squashed.
 *
 * Every class below is written out in full because Tailwind scans source
 * text and would never see a composed `rotate-${n}`.
 */

const SHAPES = {
  upright: {
    width: 224,
    height: 288,
    box: 'h-72 w-56',
    tile: 'w-56',
    tiltAt: 'always',
  },
  wide: {
    width: 288,
    height: 224,
    box: 'h-56 w-72 max-w-full',
    tile: 'w-72 max-w-full',
    tiltAt: 'sm',
  },
} as const;

const TILTS = {
  left: { always: '-rotate-2', sm: 'sm:-rotate-2' },
  slightLeft: { always: '-rotate-1', sm: 'sm:-rotate-1' },
  slightRight: { always: 'rotate-1', sm: 'sm:rotate-1' },
  right: { always: 'rotate-2', sm: 'sm:rotate-2' },
} as const;

const SHADOWS = {
  gold: 'shadow-hard-gold-8',
  cyan: 'shadow-hard-cyan-8',
  pink: 'shadow-hard-pink-8',
} as const;

interface Props {
  src: ImageMetadata;
  alt: string;
  shape: keyof typeof SHAPES;
  tilt: keyof typeof TILTS;
  shadow: keyof typeof SHADOWS;
  caption?: string;
  class?: string;
}

const {
  src,
  alt,
  shape,
  tilt,
  shadow,
  caption,
  class: className = '',
} = Astro.props;
const { width, height, box, tile, tiltAt } = SHAPES[shape];
---

<figure class:list={['shrink-0', tile, TILTS[tilt][tiltAt], className]}>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    densities={DENSITIES}
    class:list={[
      'block border-4 border-border object-cover',
      box,
      SHADOWS[shadow],
    ]}
  />
  {caption && (
    <figcaption class="mt-5 text-label text-subtle text-pretty">
      {caption}
    </figcaption>
  )}
</figure>
