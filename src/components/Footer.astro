---
/*
 * TODO(design): the design comps show a badge mark in the footer, but there is
 * no <img> here yet and the comps do not fix its placement or size. When it is
 * added it takes alt="Sinduri - Lepus Ridet". A large decorative watermark
 * version of the same badge takes alt="" and aria-hidden="true", because it
 * repeats the mark that already carries the name.
 */

// PLACEHOLDER hrefs. Every `#` below needs a real URL before launch.
const SOCIAL_LINKS = [
  { href: '#', label: 'GitHub' },
  { href: '#', label: 'LinkedIn' },
  { href: '#', label: 'Instagram' },
  { href: '#', label: 'Email' },
] as const;

const SITE_NAME = 'sinduri.lol';
const currentYear = new Date().getFullYear();

// Built here rather than interpolated inline. Astro collapses the whitespace
// between two adjacent expressions when a formatter puts them on their own
// lines, which silently renders "2026sinduri.lol".
const copyright = `© ${currentYear} ${SITE_NAME}`;
---

<footer class="border-t-8 border-gold bg-deep px-6 pb-10 pt-20">
  <div class="mx-auto max-w-7xl">
    <h2 class="-rotate-1 text-h2 text-gold">Let&rsquo;s Talk.</h2>

    <nav aria-label="Social" class="mt-14">
      <ul class="flex flex-wrap gap-6">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="label block border-4 border-border bg-surface px-6 py-4 text-text hover:shadow-hard-gold-6"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mt-20 text-label font-black uppercase tracking-label text-subtle">
      {copyright}
    </p>
  </div>
</footer>
