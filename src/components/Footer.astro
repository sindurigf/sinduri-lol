---
import { Image } from 'astro:assets';
import bunnyFooter from '../assets/bunny-footer.webp';
import { CONTACT_MAILTO } from '../lib/contact';
import { DENSITIES } from '../lib/image-densities';
import { NAV_LINKS, ariaCurrent } from '../lib/nav';
import {
  EMAIL_LINK_NAME,
  SOCIAL_PROFILES,
  profileLinkName,
} from '../lib/profiles';
import { SITE_NAME } from '../lib/site';
import { DOWN_PATH } from '../lib/paths';
import { curiouserPages } from '../lib/rabbit-hole';
import onDemand from '../scripts/on-demand.ts?worker&url';
import curiouserFeature from '../scripts/curiouser.ts?worker&url';
import textSizeFeature from '../scripts/text-size.ts?worker&url';
/* Hashed under /_astro/ and cached once, instead of inline on every page. */
import socialIcons from '../assets/social-icons.svg?url';

/* Source order is the reading order at every width; no CSS `order`. */

/* Email is appended here, not in profiles.ts, which also feeds JSON-LD `sameAs`. */
const SOCIAL_LINKS = [
  ...SOCIAL_PROFILES.map((profile) => ({
    ...profile,
    name: profileLinkName(profile.label),
  })),
  { href: CONTACT_MAILTO, label: 'Email', name: EMAIL_LINK_NAME },
];

const POLICY_LINKS = [
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/credits/', label: 'Credits' },
  { href: '/brand/', label: 'Brand' },
] as const;

const current = (href: string) => ariaCurrent(Astro.url.pathname, href);

/* The year of first publication, not the build year: a build date goes stale. */
const FIRST_PUBLISHED = 2026;

/* Not inline: Astro drops the space between two expressions on separate lines. */
const copyright = `© ${FIRST_PUBLISHED} ${SITE_NAME}`;

/* /down/ has the same size buttons at its door, scoped to that page. */
const sizeControls = Astro.url.pathname !== DOWN_PATH;
const curiouserLinks = await curiouserPages();

/* CSS px: the rabbit's display height at its largest (--size-footer-rabbit). */
const RABBIT_HEIGHT = 160;
---

<footer class="page-gutter bg-background">
  <div class="mx-auto max-w-page">
    <div class="footer-inner">
      <div class="footer-top">
        <nav aria-label="Social">
          <ul class="footer-stickers">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-sticker"
                  rel={link.href.startsWith('https:') ? 'me' : undefined}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <use href={`${socialIcons}#${link.label}`} />
                  </svg>
                  <span class="sr-only">{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Site" class="footer-pages">
          <ul>
            {NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current(link.href)}
                  class="label text-text hover:text-cyan"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="About this site" class="footer-policies">
          <ul>
            {POLICY_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current(link.href)}
                  class="label text-subtle hover:text-cyan"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-extras">
        <ul class="footer-links">
          <li>
            <a
              href={DOWN_PATH}
              aria-current={current(DOWN_PATH)}
              class="label text-text hover:text-cyan"
            >
              Down the Rabbit Hole
            </a>
          </li>
        </ul>

        <div class="footer-controls">
          <div class="footer-curiouser" data-curiouser-scope>
            <a
              href={DOWN_PATH}
              class="footer-curiouser-link label text-text hover:text-cyan"
            >
              Curiouser
            </a>
            <button
              type="button"
              class="label text-text hover:text-cyan"
              hidden
              data-on-demand="curiouser"
              data-go-class="footer-go label text-text hover:text-cyan"
            >
              Curiouser
            </button>
            <span class="footer-reel" data-curiouser-result></span>
            <span class="sr-only" role="status" data-curiouser-status></span>
            <ul hidden data-curiouser-pages>
              {curiouserLinks.map((page) => (
                <li>
                  <a href={page.href}>{page.title}</a>
                </li>
              ))}
            </ul>
          </div>

          {sizeControls && (
            <div
              class="footer-size js-only"
              role="group"
              aria-labelledby="footer-size-label"
              data-text-size="site"
            >
              <span id="footer-size-label" class="label text-subtle">
                Text Size
              </span>
              <button
                type="button"
                class="label text-text hover:text-cyan"
                hidden
                data-on-demand="text-size"
                data-size-action="smaller"
              >
                Drink Me
              </button>
              <button
                type="button"
                class="label text-text hover:text-cyan"
                hidden
                data-on-demand="text-size"
                data-size-action="larger"
              >
                Eat Me
              </button>
              <button
                type="button"
                class="label text-text hover:text-cyan"
                hidden
                data-on-demand="text-size"
                data-size-action="reset"
              >
                Just Right
              </button>
              <span
                class="footer-size-status"
                role="status"
                data-size-status
              ></span>
            </div>
          )}
        </div>
      </div>

      <small class="footer-copyright">{copyright}</small>
    </div>

    {/* A <div>: a <p> trips WAVE's "Possible heading" (tests/wave-alerts.spec.ts). */}
    <div class="footer-name" lang="la">
      <span class="footer-name-text">
        Lepus Ridet
        <Image
          src={bunnyFooter}
          alt=""
          height={RABBIT_HEIGHT}
          densities={DENSITIES}
          class="footer-rabbit"
        />
      </span>
    </div>
  </div>
</footer>

<script
  is:inline
  type="module"
  src={onDemand}
  data-on-demand-curiouser={curiouserFeature}
  data-on-demand-text-size={textSizeFeature}
></script>
