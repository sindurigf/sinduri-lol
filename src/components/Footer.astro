---
/*
 * The footer badge, placed per SiteFooter.dc.html: 44px tall, auto width, 0.8
 * opacity, sitting to the left of the copyright line in a 14px flex row.
 *
 * alt="" is deliberate. In this position the badge sits directly beside
 * "(c) 2026 sinduri.lol", so a name of "Sinduri - Lepus Ridet" would announce
 * the same thing twice and add nothing. Here it is decoration. The same asset
 * elsewhere, standing alone as the only carrier of the name, would need a real
 * alt; the alt belongs to the placement, not to the file.
 *
 * width and height are the intrinsic pixel size of the source, so the browser
 * reserves the correct box before the image loads and the copyright line does
 * not shift sideways (CLS).
 */
const FOOTER_BADGE = {
  src: '/images/badge-white.png',
  width: 760,
  height: 900,
} as const;

const EMAIL = 'sinduri.g@gmail.com';

const SOCIAL_LINKS = [
  { href: 'https://github.com/sindurigf', label: 'GitHub' },
  {
    href: 'https://at.linkedin.com/in/sinduri-guntupalli-307542131',
    label: 'LinkedIn',
  },
  { href: 'https://www.instagram.com/sindurigf/', label: 'Instagram' },
  {
    href: 'https://bsky.app/profile/sinduri-lol.bsky.social',
    label: 'Bluesky',
  },
  { href: 'https://drupal.community/@sinduri', label: 'Drupal' },
  { href: `mailto:${EMAIL}`, label: 'Email' },
] as const;

const SITE_NAME = 'sinduri.lol';
const currentYear = new Date().getFullYear();

// Built here rather than interpolated inline. Astro collapses the whitespace
// between two adjacent expressions when a formatter puts them on their own
// lines, which silently renders "2026sinduri.lol".
const copyright = `© ${currentYear} ${SITE_NAME}`;
---

<!--
  No horizontal padding below `sm`. The footer carries an <h2>, so it is one
  of the boxes the heading floors are calibrated against and it has to match
  the page content box exactly. The header is excluded on purpose: it holds no
  heading, and zeroing its padding would push the rotated logo tile past the
  left edge.
-->
<footer class="border-t-8 border-gold bg-deep pb-10 pt-20 sm:px-6">
  <div class="mx-auto max-w-7xl">
    <h2 class="-rotate-1 text-h2 text-gold">Let&rsquo;s Talk.</h2>

    <nav aria-label="Social" class="mt-14">
      <ul class="flex flex-wrap gap-6">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="label block border-4 border-border bg-surface px-6 py-4 text-text hover:shadow-hard-gold-6"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-20 flex items-center gap-3.5">
      <img
        src={FOOTER_BADGE.src}
        alt=""
        width={FOOTER_BADGE.width}
        height={FOOTER_BADGE.height}
        class="h-11 w-auto opacity-80"
      />
      <p class="text-label font-black uppercase tracking-label text-subtle">
        {copyright}
      </p>
    </div>
  </div>
</footer>
