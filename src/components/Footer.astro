---
import { Image } from 'astro:assets';
import bunnyFooter from '../assets/bunny-footer.webp';
import { CONTACT_MAILTO } from '../lib/contact';
import { DENSITIES } from '../lib/image-densities';
import { NAV_LINKS, ariaCurrent } from '../lib/nav';
import {
  EMAIL_LINK_NAME,
  SOCIAL_PROFILES,
  profileLinkName,
} from '../lib/profiles';
import { TALKS_PATH } from '../lib/paths';
import { SITE_NAME } from '../lib/site';
/* Hashed under /_astro/ and cached once, instead of inline on every page. */
import socialIcons from '../assets/social-icons.svg?url';
/* `?worker&url`: a separate file, so no Vite preload helper, loaded by src under Trusted Types. */
import onDemandRegistry from '../scripts/on-demand.ts?worker&url';
import drushApp from '../scripts/drush.ts?worker&url';

/* Source order is the reading order at every width; no CSS `order`. */

/* Email is appended here, not in profiles.ts, which also feeds JSON-LD `sameAs`. */
const SOCIAL_LINKS = [
  ...SOCIAL_PROFILES.map((profile) => ({
    ...profile,
    name: profileLinkName(profile.label),
  })),
  { href: CONTACT_MAILTO, label: 'Email', name: EMAIL_LINK_NAME },
];

const POLICY_LINKS = [
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/credits/', label: 'Credits' },
  { href: '/brand/', label: 'Brand' },
] as const;

const current = (href: string) => ariaCurrent(Astro.url.pathname, href);

/* Feature name to its `?worker&url` file; its trigger carries the file as `data-on-demand`. */
const FEATURES: Record<string, string> = { drush: drushApp };

/* A slide deck keeps its script budget for the deck. */
const onDemand =
  Object.keys(FEATURES).length > 0 &&
  !Astro.url.pathname.startsWith(TALKS_PATH);

/* The year of first publication, not the build year: a build date goes stale. */
const FIRST_PUBLISHED = 2026;

/* Not inline: Astro drops the space between two expressions on separate lines. */
const copyright = `© ${FIRST_PUBLISHED} ${SITE_NAME}`;

/* CSS px: the rabbit's display height at its largest (--size-footer-rabbit). */
const RABBIT_HEIGHT = 160;
---

<footer class="page-gutter bg-background">
  <div class="mx-auto max-w-page">
    <div class="footer-inner">
      <div class="footer-top">
        <nav aria-label="Social">
          <ul class="footer-stickers">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-sticker"
                  rel={link.href.startsWith('https:') ? 'me' : undefined}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <use href={`${socialIcons}#${link.label}`} />
                  </svg>
                  <span class="sr-only">{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Site" class="footer-pages">
          <ul>
            {NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current(link.href)}
                  class="label text-text hover:text-cyan"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="About this site" class="footer-policies">
          <ul>
            {POLICY_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current(link.href)}
                  class="label text-subtle hover:text-cyan"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      {onDemand && (
        <script is:inline type="module" src={onDemandRegistry}></script>
      )}

      <small class="footer-copyright">{copyright}</small>

      {onDemand && (
        <button
          type="button"
          class="drush-trigger label"
          data-on-demand={FEATURES.drush}
          data-on-demand-keys="drush"
          hidden
        >
          Try a Command
        </button>
      )}
    </div>

    {/* A <div>: a <p> trips WAVE's "Possible heading" (tests/wave-alerts.spec.ts). */}
    <div class="footer-name" lang="la">
      <span class="footer-name-text">
        Lepus Ridet
        <Image
          src={bunnyFooter}
          alt=""
          height={RABBIT_HEIGHT}
          densities={DENSITIES}
          class="footer-rabbit"
        />
      </span>
    </div>
  </div>
</footer>
