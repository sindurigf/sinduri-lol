---
import { CONTACT_EMAIL } from '../lib/contact';
import { NAV_LINKS } from '../lib/nav';
import { SOCIAL_PROFILES } from '../lib/profiles';
import { SOCIAL_ICONS } from '../lib/social-icons';

/*
 * THE FOOTER: the name with the profiles under it, the site's pages and its
 * policies, and a bottom line with the copyright and the gold hare asleep in
 * a tuft of grass. The layout lives with the other component classes in
 * global.css under "THE FOOTER".
 *
 * NOTHING HERE RUNS IN THE BROWSER. The tuft is a still inline SVG, so it
 * needs no pause control and no script. The homepage hero is the one animated
 * field.
 *
 * The source order is the phone's reading order: name, pages, policies,
 * profiles, copyright, tuft. From `md` the grid places the profiles under the
 * name, which is still row-major reading order, so nothing is reordered with
 * `order` and the tab sequence matches what is on screen at every width.
 */

/*
 * Imported rather than declared here, because `/.well-known/security.txt`
 * publishes the same address as its `Contact:` and the two must not drift.
 * See src/lib/contact.ts.
 */
const EMAIL = CONTACT_EMAIL;

/*
 * The profiles come from src/lib/profiles.ts, which the JSON-LD also reads as
 * its `sameAs`. The email is appended here rather than living in that module:
 * it is a `mailto:`, not a profile. Every entry needs an icon in
 * src/lib/social-icons.ts, and TypeScript refuses the build until it has one.
 */
const SOCIAL_LINKS = [
  ...SOCIAL_PROFILES,
  { href: `mailto:${EMAIL}`, label: 'Email' },
] as const;

/*
 * The header's destinations, imported from src/lib/nav.ts rather than
 * transcribed. `isActive` is deliberately not imported with them: a footer
 * nav is what you reach having finished reading, and marking the page you are
 * already at the bottom of says nothing.
 */
const POLICY_LINKS = [
  { href: '/accessibility/', label: 'Accessibility' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/credits/', label: 'Credits' },
] as const;

const SITE_NAME = 'sinduri.lol';
const currentYear = new Date().getFullYear();

// Built here rather than interpolated inline. Astro collapses the whitespace
// between two adjacent expressions when a formatter puts them on their own
// lines, which silently renders "2026sinduri.lol".
const copyright = `© ${currentYear} ${SITE_NAME}`;
---

{/*
  The footer sits outside <main>, so it applies the shared gutter itself, and
  its content keeps to the same column as the header and <main>.
  tests/alignment.spec.ts measures that.
*/}
<footer class="page-gutter bg-background">
  <div class="mx-auto max-w-page">
    <div class="footer-inner">
      <div class="footer-top">
        {/*
          Not a heading: it is the site's name signing off, and a heading here
          would add a level to every page's outline. Not a <p> either: WAVE
          reports a short, large, bold paragraph as a possible heading, and
          tests/wave-alerts.spec.ts gates on that. Latin, so `lang` lets a
          screen reader pronounce it (SC 3.1.2).
        */}
        <div class="footer-name" lang="la">
          Lepus Ridet
        </div>

        {/*
          Two navs, and their labels are what keep them useful. "Site" is
          where else this is; "About this site" is what the site says about
          itself: its policies and its credits. A reader listing landmarks sees
          distinct names, and "Privacy" never reads as one more page of content.

          It duplicates the header's destinations on purpose: a footer nav is
          for someone who has reached the bottom of a long page.
          tests/focus.spec.ts walks both.
        */}
        <nav aria-label="Site" class="footer-pages">
          <ul>
            {NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="label text-text hover:text-cyan">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/*
          `subtle` rather than `text` sets the policies apart from the pages
          without an underline; it is AAA on `background`, 8.62.
        */}
        <nav aria-label="About this site" class="footer-policies">
          <ul>
            {POLICY_LINKS.map((link) => (
              <li>
                <a href={link.href} class="label text-subtle hover:text-cyan">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/*
          THE PROFILES, AS STICKERS. Each tile is a real link whose name is
          the visually hidden label, so a screen reader hears "GitHub, link"
          and voice control can say it; the icon is aria-hidden and names
          nothing. A tile is 56px, 48px below `lg`, past the 24px of SC 2.5.8.
        */}
        <nav aria-label="Social" class="footer-social">
          <ul class="footer-stickers">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a href={link.href} class="footer-sticker">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={SOCIAL_ICONS[link.label]} />
                  </svg>
                  <span class="sr-only">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-base">
        {/*
          <small>, which HTML defines for side comments such as copyright
          lines, and which WAVE does not report as a possible heading the way
          it reports a short, large, bold <p>. `.footer-copyright` sets its
          size over the base layer's `small { font-size: 80% }`;
          tests/footer.spec.ts asserts the 20px.
        */}
        <small class="footer-copyright">{copyright}</small>

        {/*
          THE TUFT. Decoration, so aria-hidden and nothing focusable in it.
          Drawn in its own units with x = 0 at the hare's middle and y = 0 on
          the ground; the viewBox is cropped to the drawing, so centring the
          element centres what is visible. global.css colours every part.
        */}
        <svg
          class="footer-tuft"
          viewBox="-142 -94 266 102"
          aria-hidden="true"
          focusable="false"
        >
          <g class="tuft-back">
            <path d="M-132.18 0Q-135.75 -32.73 -139.4 -59.5Q-128.18 -29.75 -122.83 0Z"></path>
            <path d="M-113.47 0Q-115 -44.88 -113.9 -81.6Q-106.42 -40.8 -104.12 0Z"></path>
            <path d="M-96.47 0Q-93.92 -27.12 -83.3 -49.3Q-83.3 -24.65 -87.12 0Z"></path>
            <path d="M78.62 0Q81.69 -39.27 93.5 -71.4Q92.56 -35.7 87.97 0Z"></path>
            <path d="M95.62 0Q100.22 -28.05 115.6 -51Q111.86 -25.5 104.97 0Z"></path>
            <path d="M110.92 0Q112.45 -18.7 120.7 -34Q122.57 -17 120.27 0Z"></path>
          </g>
          <g class="hare-shadow" transform="translate(6 6) scale(1.7)">
            <circle cx="-47" cy="-13" r="7"></circle>
            <path d="M36 0C38-24 16-36-12-37C-36-38-52-24-48 0Z"></path>
            <ellipse cx="42" cy="-3" rx="9" ry="3.6"></ellipse>
            <ellipse
              cx="34"
              cy="-19"
              rx="16"
              ry="13"
              transform="rotate(-8.6 34 -19)"
            ></ellipse>
            <ellipse
              cx="8"
              cy="-38"
              rx="26"
              ry="5.5"
              transform="rotate(9.2 8 -38)"
            ></ellipse>
            <ellipse
              cx="4"
              cy="-44"
              rx="24"
              ry="5"
              transform="rotate(12.6 4 -44)"
            ></ellipse>
          </g>
          <g class="hare" transform="scale(1.7)">
            <ellipse
              cx="4"
              cy="-44"
              rx="24"
              ry="5"
              transform="rotate(12.6 4 -44)"
            ></ellipse>
            <circle cx="-47" cy="-13" r="7"></circle>
            <path d="M36 0C38-24 16-36-12-37C-36-38-52-24-48 0Z"></path>
            <path class="hare-line" d="M-8-3Q-6-26-28-29"></path>
            <ellipse cx="42" cy="-3" rx="9" ry="3.6"></ellipse>
            <ellipse
              cx="34"
              cy="-19"
              rx="16"
              ry="13"
              transform="rotate(-8.6 34 -19)"
            ></ellipse>
            <ellipse
              cx="8"
              cy="-38"
              rx="26"
              ry="5.5"
              transform="rotate(9.2 8 -38)"
            ></ellipse>
            <path class="hare-line" d="M28-34.5Q10-37.5-12-41"></path>
            <path class="hare-line" d="M37.5-19.5Q40.5-24 43.5-19.5"></path>
            <circle class="hare-nose" cx="49" cy="-16" r="1.6"></circle>
          </g>
          <g class="tuft-front">
            <path d="M-63.75 0Q-65.79 -11.22 -66.3 -20.4Q-58.31 -10.2 -55.25 0Z"></path>
            <path d="M-12.75 0Q-11.22 -8.42 -3.4 -15.3Q-1.96 -7.65 -4.25 0Z"></path>
            <path d="M38.25 0Q40.8 -10.29 51 -18.7Q50.58 -9.35 46.75 0Z"></path>
          </g>
        </svg>
      </div>
    </div>
  </div>
</footer>
