---
/*
 * A bordered box standing in for an image that does not exist yet.
 *
 * Every photographic slot in the comps is an image placeholder and no asset
 * has been supplied for any of them. The images the repo does have
 * (`bunny-*.png`, `badge-*.png`) are marks, not photographs.
 *
 * So the box renders at the right aspect ratio, in the right border, and says
 * what belongs in it. That beats three worse options: omitting the slot,
 * which changes the layout the page was designed around and hides the gap; a
 * stock image, which claims content nobody has decided; and an `<img>` with a
 * broken `src`, which announces a filename to a screen reader and a
 * broken-image icon to everyone else.
 *
 * The label is functional microcopy describing the state of the build, so it
 * is written rather than left as PLACEHOLDER. It is real text rather than
 * `aria-hidden` decoration on purpose: someone who cannot see the empty frame
 * should be told it is empty and why, not handed a silent gap.
 */

const RATIOS = {
  /* 16 / 9, Tailwind's own. Unused. */
  video: 'aspect-video',
  /* 4 / 3. The post artwork in BlogCard. */
  photo: 'aspect-photo',
  /* 4 / 5. The About portrait. */
  portrait: 'aspect-portrait',
  /* 1 / 1. The workspace square in the homepage About teaser. */
  square: 'aspect-square',
} as const;

interface Props {
  ratio: keyof typeof RATIOS;
  /** What belongs in this slot, in sentence case. Uppercased by `.label-wide`. */
  label: string;
  class?: string;
}

const { ratio, label, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center border-8 border-dashed border-border bg-surface',
    RATIOS[ratio],
    className,
  ]}
>
  <p class="label-wide max-w-full px-6 text-center text-subtle">
    Placeholder: {label}
  </p>
</div>
