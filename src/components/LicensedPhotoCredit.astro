---
import { LICENSED_PHOTOS, licensedCaption } from '../lib/credits';

/* The credit after "Photo: ": CC BY 2.0 §4(a) asks for the license link with every copy. */
interface Props {
  photo: keyof typeof LICENSED_PHOTOS;
}

const parts = licensedCaption(LICENSED_PHOTOS[Astro.props.photo]);
---

{parts.map((part) =>
  typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>,
)}
