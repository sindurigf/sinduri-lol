---
import { LICENSED_PHOTOS } from '../lib/credits';

/* The name after "Photo: ": CC BY 2.0 §4(a) asks for the license link with every copy. */
interface Props {
  photo: keyof typeof LICENSED_PHOTOS;
}

const { photographer, source, licenseShort, licenseHref } =
  LICENSED_PHOTOS[Astro.props.photo];
---

<a href={source}>{photographer}</a> (<a href={licenseHref}>{licenseShort}</a>)
