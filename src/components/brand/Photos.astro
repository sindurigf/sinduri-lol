---
import type { ImageMetadata } from 'astro';
import {
  LICENSED_PHOTOS,
  PHOTO_CREDIT_PREFIX,
  photographerHref,
  type Photographer,
} from '../../lib/credits';
import LicensedPhotoCredit from '../LicensedPhotoCredit.astro';
import PhotoTile from '../PhotoTile.astro';
import PhotoViewer from '../PhotoViewer.astro';
import ComponentRow from './ComponentRow.astro';
import lectureHall from '../../assets/photos/drupal-lecture-hall.jpg';
import mountainCamp from '../../assets/photos/drupal-mountain-camp.webp';

const STRIP_ID = 'brand-photos';
/*
 * The strip's width in a part's stage, measured at each layout step: the
 * stacked halves, the halves side by side, the sections list from `lg`, the
 * page column's cap. tests/image-size.spec.ts fails on drift.
 */
const stageSizes = (natural: number): string =>
  [
    `(min-width: 83rem) min(${natural}px, 21.75rem)`,
    `(min-width: 71.5rem) min(${natural}px, calc(48.3vw - 18.25rem))`,
    `(min-width: 64rem) min(${natural}px, calc(96.6vw - 29.5rem))`,
    `(min-width: 51rem) min(${natural}px, calc(50vw - 9.25rem))`,
    `(min-width: 40rem) min(${natural}px, calc(100vw - 11rem))`,
    `min(${natural}px, calc(100vw - 9rem))`,
  ].join(', ');
interface Photo {
  src: ImageMetadata;
  alt: string;
  credit:
    { licensed: keyof typeof LICENSED_PHOTOS } | { photographer: Photographer };
}

const PHOTOS: readonly Photo[] = [
  {
    src: lectureHall,
    alt: 'Sinduri standing and clapping in a lecture hall full of Drupal event attendees.',
    credit: { licensed: 'drupal-lecture-hall' },
  },
  {
    src: mountainCamp,
    alt: 'Drupal Mountain Camp attendees gathered together in the snow.',
    credit: { photographer: 'Patrick Itten' },
  },
];

const tileProps = ({ src, alt }: Photo) => ({
  image: src,
  alt,
  group: 'brand',
  size: 'natural' as const,
  stripSizes: stageSizes,
});
---

<ul role="list" class="brand-parts">
  <ComponentRow
    id="photo-strip"
    use="a row of photos that scrolls sideways."
    rule="Every photo opens full size in the viewer. The arrows show, and the strip takes keyboard focus, only while it overflows."
  >
    <div class="card sm:p-card-tight">
      <div class="mb-4 flex items-center justify-between gap-4">
        <span class="label block text-subtle">Photos</span>
        <div class="flex gap-3">
          <button
            type="button"
            class="strip-button"
            aria-controls={STRIP_ID}
            aria-label="Scroll photos left"
            data-strip-scroll="-1"
            hidden
          >
            <span aria-hidden="true">&larr;</span>
          </button>
          <button
            type="button"
            class="strip-button"
            aria-controls={STRIP_ID}
            aria-label="Scroll photos right"
            data-strip-scroll="1"
            hidden
          >
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </div>
      <ul
        role="list"
        id={STRIP_ID}
        class="photo-strip"
        tabindex="0"
        aria-label="Photos, scrolls sideways"
      >
        {PHOTOS.map((photo) => (
          <li>
            <PhotoTile {...tileProps(photo)}>
              {PHOTO_CREDIT_PREFIX}
              {'licensed' in photo.credit ? (
                <LicensedPhotoCredit photo={photo.credit.licensed} />
              ) : (
                <a href={photographerHref(photo.credit.photographer)}>
                  {photo.credit.photographer}
                </a>
              )}
            </PhotoTile>
          </li>
        ))}
      </ul>
    </div>
  </ComponentRow>
</ul>
<PhotoViewer />
