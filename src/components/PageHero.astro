---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Roundel from './Roundel.astro';
import { WIDTHS } from '../lib/image-densities';

/*
 * The opening of every page except Home, 404 and a blog post: a full-bleed
 * wall of cast blocks behind a gold `h1`, chosen with Sinduri on 2026-09-19.
 * The wall ends the hero. There is no card, no fill and no rule under it;
 * the blocks stop and the page carries on. See `.cast-blocks` in global.css.
 *
 * The section is a `.band`, so the wall runs edge to edge while the text keeps
 * the page column and the heading floors keep the box they are fitted to.
 */
interface Props {
  title: string;
  /*
   * `h2` for a title that is data rather than a chosen string: a tag is one
   * long word no soft hyphen can be written into, and `text-h1`'s 33px floor
   * does not fit `sustainability` in the 273px box. The level stays h1.
   */
  titleSize?: 'h1' | 'h2';
  /*
   * A page that opens with a photo. It sits on the wall beside the text with
   * its own border and gold shadow, overlapping the blocks rather than
   * replacing any: chosen over a photo cut into the wall on its joints.
   */
  image?: ImageMetadata;
  imageAlt?: string;
  /* The roundel on a joint crossing. Contact is the one page that has it. */
  roundel?: boolean;
  /*
   * `reading` for a page that is one column of prose, Privacy and
   * Accessibility: the text sits in that column's `max-w-3xl`, centred, so
   * the title and the text start on one edge. The wall stays full width.
   */
  measure?: 'page' | 'reading';
}

const {
  title,
  titleSize = 'h1',
  image,
  imageAlt = '',
  roundel = false,
  measure = 'page',
} = Astro.props;

const reading = measure === 'reading' && !image;

const TITLE_CLASS = { h1: 'text-h1', h2: 'text-h2' } as const;
const titleClass =
  reading && titleSize === 'h1' ? 'text-reading-h1' : TITLE_CLASS[titleSize];

/* Six columns by three rows from `sm`; a phone shows three columns, nine. */
const BLOCK_COUNT = 18;

/*
 * The photo column: four of twelve tracks of `max-w-page` from `lg`, and at
 * most 24rem below it, where a full-width portrait would be a screen and a
 * half tall. Only used to pick a file from WIDTHS; tests/image-size.spec.ts
 * fails when it drifts from the layout.
 */
const IMAGE_SIZES =
  '(min-width: 64rem) min(calc((100vw - 3rem) * 0.3333), 26.67rem), min(calc(100vw - 2rem), 24rem)';
---

<section class="page-hero band relative isolate py-16 lg:py-20">
  <div class="cast-blocks" aria-hidden="true">
    {Array.from({ length: BLOCK_COUNT }, () => (
      <span />
    ))}
  </div>

  <div
    class:list={[
      'relative mx-auto max-w-page',
      image && 'lg:grid lg:grid-cols-12 lg:items-start',
    ]}
  >
    <div
      class:list={[image && 'lg:col-span-7', reading && 'mx-auto max-w-3xl']}
    >
      <slot name="eyebrow" />
      <h1 class:list={[titleClass, 'text-gold']}>{title}</h1>
      <slot />
    </div>

    {image && (
      <figure class="mt-12 max-w-sm lg:col-span-4 lg:col-start-9 lg:mt-0 lg:max-w-none">
        <Image
          src={image}
          alt={imageAlt}
          widths={WIDTHS}
          sizes={IMAGE_SIZES}
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full border-4 border-border shadow-hard-gold-8"
        />
        <figcaption class="mt-5 text-body text-muted">
          <slot name="credit" />
        </figcaption>
      </figure>
    )}
  </div>

  {/*
    A child of the section, not of the column: its crossing is measured on the
    wall, which is the section's box.
  */}
  {roundel && (
    <div class="cast-blocks-crossing mt-10 flex justify-end lg:mt-0">
      <Roundel eager />
    </div>
  )}
</section>
