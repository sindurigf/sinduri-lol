---
import MobileMenu from './ui/MobileMenu.vue';

const NAV_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/career', label: 'Career' },
  { href: '/blog', label: 'Blog' },
] as const;

const CTA = { href: '/contact', label: 'Get in touch' } as const;

// Dark line-art mark, sits on the gold logo tile.
const BUNNY_MARK = {
  src: '/images/bunny-dark.png',
  alt: 'Lepus Ridet mark',
  width: 458,
  height: 900,
} as const;

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!--
  The gutter goes on <header>, not on the column inside it, so this element
  matches <main> and the footer. It used to be the other way round, which put
  the header's content one gutter inside theirs on any viewport wider than the
  column. See the --container-page comment in global.css.
-->
<header
  class="page-gutter sticky top-0 z-50 h-header border-b-8 border-border bg-header-bg backdrop-blur-header"
>
  <div class="mx-auto flex h-full max-w-page items-center justify-between">
    <!--
      No aria-label on this link. It would override both the image's alt and the
      visible wordmark, hiding the mark from assistive tech and breaking voice
      control for anyone who says "sinduri.lol". The width and height are the
      intrinsic pixel size so the browser reserves the right box before load.
    -->
    <a href="/" class="flex items-center gap-4">
      <span
        class="flex h-12 w-12 rotate-3 items-center justify-center rounded-nav border-4 border-border bg-gold shadow-hard-pink-12"
      >
        <img
          src={BUNNY_MARK.src}
          alt={BUNNY_MARK.alt}
          width={BUNNY_MARK.width}
          height={BUNNY_MARK.height}
          class="h-6 w-auto"
        />
      </span>
      <span class="label text-text">sinduri.lol</span>
    </a>

    <!--
      py-2 is a target-size rule, not spacing. The 13px/1.2 label renders a
      15.6px line box, well under the 24px SC 2.5.8 asks for. 8px top and
      bottom takes each link to 31.6px, so the links pass on their own size
      instead of leaning on the spacing exception the 40px gap used to
      provide. The border-4 adds 8px more, to 39.6px. The ul is items-center,
      so the padding grows the hit area symmetrically about the same centre
      line and moves no glyph.

      THE ACTIVE LINK IS A BOX, AND EVERY LINK CARRIES ITS GEOMETRY. The
      border and padding are on all four links; only the border colour and the
      shadow change when a link is current. That is what stops the nav
      reflowing as you move between pages: an indicator applied to the active
      link alone would make each item wider on its own page and shuffle the
      row every time. `border-transparent` is holding space, not decorating.

      It replaces an 8x8 gold dot below the label. The dot was also
      aria-hidden, so this is a visual change only: `aria-current="page"` is
      what carries the state to assistive tech, then and now. Both are shape
      cues rather than colour alone, which is what SC 1.4.1 asks for; a rule
      that only recoloured the active label would not be.
    -->
    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-3">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'label block border-4 px-4 py-2',
                  isActive(link.href)
                    ? 'border-border text-text shadow-hard-gold-4'
                    : 'border-transparent text-muted hover:text-cyan',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={CTA.href}
            class="block rounded-nav border-4 border-border bg-cyan px-6 py-3 text-label font-black uppercase tracking-label text-darkcyan hover:shadow-hard-gold-4"
          >
            {CTA.label}
          </a>
        </li>
      </ul>
    </nav>

    <!--
      client:load, deliberately not client:media. A desktop user at 400% zoom
      crosses the mobile breakpoint, and if the island failed to hydrate on that
      media change the only navigation available to them would be dead - exactly
      the users who depend on magnification (WCAG 2.2 SC 1.4.10 Reflow). The few
      kilobytes client:media would save are not worth that risk.
    -->
    <MobileMenu
      client:load
      links={[...NAV_LINKS]}
      ctaHref={CTA.href}
      ctaLabel={CTA.label}
      currentPath={currentPath}
    />
  </div>
</header>
