---
import MobileMenu from './ui/MobileMenu.vue';

const NAV_LINKS = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/career', label: 'Career' },
  { href: '/blog', label: 'Blog' },
] as const;

const CTA = { href: '/contact', label: 'Get in touch' } as const;

// Dark line-art mark, sits on the gold logo tile. Intrinsic size 458x900.
const BUNNY_MARK = '/images/bunny-dark.png';

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="sticky top-0 z-50 h-header border-b-8 border-border bg-header-bg backdrop-blur-[10px]"
>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-4" aria-label="sinduri.lol home">
      <span
        class="flex h-12 w-12 rotate-3 items-center justify-center rounded-nav border-4 border-border bg-gold shadow-hard-pink-12"
      >
        <img src={BUNNY_MARK} alt="" width="12" height="24" class="h-6 w-auto" />
      </span>
      <span class="label text-text">sinduri.lol</span>
    </a>

    <nav class="hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-10">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="label block text-muted hover:text-cyan"
              >
                {link.label}
                {isActive(link.href) ? (
                  <span
                    aria-hidden="true"
                    class="mx-auto mt-2 block h-2 w-2 bg-gold"
                  />
                ) : null}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={CTA.href}
            class="block rounded-nav border-4 border-border bg-cyan px-6 py-3 text-label font-black uppercase tracking-label text-darkcyan hover:shadow-hard-gold-4"
          >
            {CTA.label}
          </a>
        </li>
      </ul>
    </nav>

    <MobileMenu
      client:load
      links={[...NAV_LINKS]}
      ctaHref={CTA.href}
      ctaLabel={CTA.label}
      currentPath={currentPath}
    />
  </div>
</header>
