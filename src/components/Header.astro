---
import { Image } from 'astro:assets';
import bunnyDark from '../assets/bunny-dark.png';
import {
  CTA,
  HEADER_LINKS,
  HOME_HREF,
  NAV_LINKS,
  ariaCurrent,
} from '../lib/nav';
import { DENSITIES } from '../lib/image-densities';
import { SITE_NAME } from '../lib/site';
import NavList from './NavList.astro';
import ThemeSwitch from './ThemeSwitch.astro';

/* Drawn height, `h-6` in px; tests/image-size.spec.ts fails if they drift. */
const MARK_HEIGHT = 24;

const currentPath = Astro.url.pathname;

const current = (href: string) => ariaCurrent(currentPath, href);
---

{/* Gutter on <header>, not the column, so its content box matches <main> and the footer. */}
<header class="page-gutter sticky top-0 z-50 h-header py-4 bg-background short:static">
  {/* Grid from `lg`, not `md`: between 768 and 1023px the row barely fits and centering wastes slack. */}
  <div class="header-slab mx-auto flex h-full max-w-page items-center justify-between lg:grid lg:grid-cols-header">
    {/*
      The desktop nav has no Home item, so this link carries aria-current on `/`.
      aria-label repeats the wordmark exactly (SC 2.5.3): the <wbr> below makes
      Chromium compute "sinduri. lol". `justify-self-start` stops it stretching.
    */}
    <a
      href={HOME_HREF}
      aria-label={SITE_NAME}
      aria-current={current(HOME_HREF)}
      class="logo-link header-logo-edge lift-mark flex min-w-0 items-center gap-4 max-xs:gap-2 lg:justify-self-start"
    >
      <span class="logo-tile flex h-12 w-12 rotate-3 items-center justify-center rounded-nav border-4 border-fill-edge bg-gold shadow-hard-bunny-8">
        <Image
          src={bunnyDark}
          alt=""
          height={MARK_HEIGHT}
          densities={DENSITIES}
          loading="eager"
          class="h-6 w-auto"
        />
      </span>
      {/*
        Untracked below xs so it fits at 305px; under SC 1.4.12 spacing it
        breaks after the dot instead of pushing the row off screen.
      */}
      {/* prettier-ignore */}
      <span class="label min-w-0 text-text max-xs:tracking-normal below-reflow:sr-only">sinduri.<wbr />lol</span>
    </a>

    {/* Stickers are 48px tall, past the 44px target (SC 2.5.5); styles in buttons-nav.css. */}
    <nav class="hidden md:block lg:justify-self-center" aria-label="Primary">
      {/* The md-to-lg trims (gap, px) let the row fit; tests/header-fit.spec.ts fails if it overlaps or scrolls. */}
      <NavList
        links={HEADER_LINKS}
        class="nav-stickers"
        linkClass="nav-sticker"
        activeClass=""
        restClass=""
      />
    </nav>

    {/*
      The CTA is outside the Primary nav so the nav stays centered; `ml-auto`
      inside the list would push the links off-center by half its width.
    */}
    <div class="flex items-center gap-3 lg:justify-self-end lg:gap-4">
      <ThemeSwitch />
      <div class="hidden md:block">
        <a
          href={CTA.href}
          aria-current={current(CTA.href)}
          class="nav-cta block whitespace-nowrap px-3 py-3 lg:px-6"
        >
          {CTA.label}
        </a>
      </div>

      {/*
      The script loads at every width: 400% zoom crosses `md` (SC 1.4.10). The
      name stays "Menu"; aria-expanded carries the state and drives the icon.
    */}
      <div class="mobile-menu md:hidden" data-mobile-menu>
        <button
          type="button"
          class="group flex size-12 items-center justify-center border-4 border-border bg-surface max-xs:size-target"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Menu"
          data-menu-trigger
        >
          <span aria-hidden="true" class="relative block h-4 w-6">
            <span class="absolute left-0 top-0 block h-menu-bar w-6 bg-gold forced-colors:bg-button-text group-aria-expanded:top-menu-bar-mid group-aria-expanded:rotate-45" />
            <span class="absolute left-0 top-menu-bar-mid block h-menu-bar w-6 bg-gold forced-colors:bg-button-text opacity-100 group-aria-expanded:opacity-0" />
            <span class="absolute left-0 top-menu-bar-end block h-menu-bar w-6 bg-gold forced-colors:bg-button-text group-aria-expanded:top-menu-bar-mid group-aria-expanded:-rotate-45" />
          </span>
        </button>

        {/* aria-label, not an sr-only h2, which would precede the page h1. */}
        <dialog
          id="mobile-menu-panel"
          class="mobile-menu-dialog"
          aria-label="Menu"
        >
          <div class="mobile-menu-content">
            {/* Unnamed: "Primary" would duplicate the header nav's landmark name (SC 1.3.1). */}
            <nav>
              <NavList
                links={NAV_LINKS}
                class="nav-stickers nav-stickers-column"
                linkClass="nav-sticker nav-sticker-large"
                activeClass=""
                restClass=""
              />

              <a
                href={CTA.href}
                aria-current={current(CTA.href)}
                class="nav-cta mt-12 block px-8 py-4 text-center"
              >
                {CTA.label}
              </a>
            </nav>

            <button
              type="button"
              class="btn-secondary mt-12 w-full"
              data-menu-close
            >
              Close
            </button>
          </div>
        </dialog>
      </div>
    </div>
  </div>
</header>

{/*
  No-JavaScript nav, shown by `@media (scripting: none)`, not <noscript>
  (a WAVE alert). Outside <header>: inside, wrapped links overflow the fixed
  --spacing-header. `md:hidden` avoids two "Primary" navs (tests/no-script.spec.ts).
*/}
<nav
  class="noscript-nav page-gutter edge-b border-border bg-background py-4 md:hidden"
  aria-label="Primary"
>
  <NavList
    links={[...NAV_LINKS, CTA]}
    class="mx-auto flex max-w-page flex-wrap items-center gap-6"
    linkClass="hit-target label block border-4 border-border px-4 py-2"
    activeClass="bg-text text-background"
    restClass="text-text hover:text-cyan"
  />
</nav>

<script>
  import '../scripts/mobile-menu';
</script>
