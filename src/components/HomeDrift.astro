---
/*
 * Alice's things as die-cut stickers, rising past as she falls, and the
 * rabbit once it has dived. The jar is a control: pressing it lets it go.
 * home-motion.ts moves them.
 */
import HomePause from './HomePause.astro';

/* Degrees each thing leans at rest; they alternate sides of the column. */
const QUIET = [
  { name: 'book', tilt: 7 },
  { name: 'picture', tilt: 6 },
  { name: 'watch', tilt: -7 },
  { name: 'teacup', tilt: -4 },
] as const;
const JAR_TILT = -8;
---

<div class="home-faller" aria-hidden="true" data-home-faller>
  <span class="home-faller-spin">
    <span class="home-bun" data-pose="leap">
      <i></i>
    </span>
  </span>
</div>
<div class="home-drift" data-home-drift>
  <button
    type="button"
    class="home-prop home-prop-jar home-prop-r"
    data-home-prop
    data-home-jar
    data-tilt={JAR_TILT}
  >
    <span class="home-prop-spin">
      <span class="home-prop-face"></span>
    </span>
    <span class="sr-only">Let Go of the Jar</span>
  </button>
  {QUIET.map(({ name, tilt }, index) => (
    <span
      class:list={[
        'home-prop',
        `home-prop-${name}`,
        index % 2 === 0 ? 'home-prop-l' : 'home-prop-r',
      ]}
      aria-hidden="true"
      data-home-prop
      data-tilt={tilt}
    >
      <span class="home-prop-spin">
        <span class="home-prop-face" />
      </span>
    </span>
  ))}
</div>
<div class="home-fall-pause">
  <HomePause />
</div>
