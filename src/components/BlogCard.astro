---
import type { BlogCategory } from '../content.config';
import { categoryLabel } from '../lib/blog';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PlaceholderBox from './PlaceholderBox.astro';
import { WIDTHS } from '../lib/image-densities';

/*
 * One post, as a card. Used by the homepage featured row, the blog index, and
 * the category listings, so its heading level is a prop rather than a
 * decision baked into the markup: on /blog the cards sit under the page <h1>
 * and are <h2>s, on the homepage they sit under a section <h2> and are <h3>s.
 * Headings must not skip levels.
 *
 * THE LINK IS ON THE HEADING, NOT ON THE CARD. The comps make the whole card
 * a single <a>. That would make the link's accessible name every word in the
 * card, category, reading time, title and a forty-word teaser, read as one
 * string in a links list, and the teaser text would stop being selectable.
 *
 * Deliberately no separate "Read the post" link: two links to one URL in a
 * card is a redundant tab stop and a second entry in every links list, and
 * the title already says where it goes.
 */

/*
 * Accent per category, so a card's colour means something rather than cycling
 * with position. Both halves are complete class names because Tailwind scans
 * source text: a composed `text-${accent}` is invisible to it.
 *
 * All three clear AAA on `surface` #1A1A1A: gold 10.60, cyan 10.49, pink-text
 * 7.18. `pink-text` and never `pink` for a glyph, and `pink` and never
 * `pink-text` for the shadow; see the two-pinks rule in the design system.
 */
const ACCENTS = {
  gold: { text: 'text-gold', shadow: 'shadow-hard-gold-8' },
  cyan: { text: 'text-cyan', shadow: 'shadow-hard-cyan-8' },
  pink: { text: 'text-pink-text', shadow: 'shadow-hard-pink-8' },
} as const;

const CATEGORY_ACCENT: Record<BlogCategory, keyof typeof ACCENTS> = {
  skincare: 'pink',
  travel: 'cyan',
  'personal-thoughts': 'gold',
  'professional-journey': 'cyan',
  'open-source': 'gold',
};

interface Props {
  href: string;
  title: string;
  teaser: string;
  category: BlogCategory;
  date: Date;
  readingTime?: number;
  featured?: boolean;
  /** The wide, two-column treatment the comps give the lead post. */
  feature?: boolean;
  headingLevel?: 2 | 3;
  /** Shown only on a `feature` card, where the placeholder box would be. */
  cover?: ImageMetadata;
  coverAlt?: string;
  class?: string;
}

const {
  href,
  title,
  teaser,
  category,
  date,
  readingTime,
  featured = false,
  feature = false,
  headingLevel = 3,
  cover,
  coverAlt = '',
  class: className = '',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';

/*
 * The cover column: half the card from `md`, the whole card below. Only used
 * to pick a file from WIDTHS; tests/image-size.spec.ts measures the result.
 */
const COVER_SIZES = '(min-width: 48rem) min(45vw, 36rem), 100vw';

const accent = ACCENTS[CATEGORY_ACCENT[category]];

const DATE_LOCALE = 'en-GB';
const DATE_FORMAT: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};

const machineDate = date.toISOString().slice(0, 10);
const readableDate = date.toLocaleDateString(DATE_LOCALE, DATE_FORMAT);
---

<article class:list={['card flex flex-col', accent.shadow, className]}>
  <div
    class:list={[feature ? 'grid gap-10 md:grid-cols-2 md:items-center' : '']}
  >
    <div class="flex flex-col">
      <p
        class:list={['label flex flex-wrap items-center gap-x-3', accent.text]}
      >
        <span>{categoryLabel(category)}</span>
        {featured ? (
          <Fragment>
            <span aria-hidden="true">&middot;</span>
            <span>Featured</span>
          </Fragment>
        ) : null}
        {readingTime ? (
          <Fragment>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime} min read</span>
          </Fragment>
        ) : null}
      </p>

      <Heading class:list={['mt-5', feature ? 'text-h2' : 'text-h3']}>
        <a href={href} class="text-text hover:text-cyan">
          {title}
        </a>
      </Heading>

      <p class="mt-6 text-body text-muted text-pretty">{teaser}</p>

      <p class="label mt-8 text-subtle">
        <time datetime={machineDate}>{readableDate}</time>
      </p>
    </div>

    {feature && cover ? (
      <Image
        src={cover}
        alt={coverAlt}
        widths={WIDTHS}
        sizes={COVER_SIZES}
        class="mt-2 block aspect-photo h-auto w-full border-4 border-border object-cover"
      />
    ) : feature ? (
      <PlaceholderBox ratio="photo" label="post artwork" class="mt-2" />
    ) : null}
  </div>
</article>
