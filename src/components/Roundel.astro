---
import { Image } from 'astro:assets';
import roundelRabbit from '../assets/roundel-rabbit.png';

/*
 * The rabbit is the badge, with no disc: thick ink edge, hard pink throw
 * (scripts/make-logo.mjs). The caller positions it with `class`. alt="": the
 * header names the site.
 */
interface Props {
  class?: string;
  eager?: boolean;
  /* `hero`: on a gold slab edge, sized by --spacing-roundel. */
  variant?: 'page' | 'hero';
}

const { class: className = '', eager = false, variant = 'page' } = Astro.props;

const BOX_CLASS = {
  page: 'size-24 lg:size-32',
  hero: 'size-roundel',
} as const;

/*
 * The art bleeds an eighth past each side of the box (ROUNDEL_BLEED in
 * scripts/make-logo.mjs), so it is drawn at 1.25x the box: 120 and 160px for
 * page, 70 to 160px for hero. tests/image-size.spec.ts fails on drift.
 */
const ART_WIDTHS = [70, 120, 160, 240, 320];
const ART_SIZES = {
  page: '(min-width: 64rem) 160px, 120px',
  hero: 'clamp(70px, calc(20vw - 70px), 160px)',
} as const;
---

<span class:list={['relative block rotate-3', BOX_CLASS[variant], className]}>
  <span class="absolute -inset-1/8">
    <Image
      src={roundelRabbit}
      alt=""
      widths={ART_WIDTHS}
      sizes={ART_SIZES[variant]}
      loading={eager ? 'eager' : 'lazy'}
      class="size-full"
    />
  </span>
</span>
