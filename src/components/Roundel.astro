---
import RabbitMark from './RabbitMark.astro';

/*
 * The caller positions it with `class`. An ink disc holds the gold knockout
 * rabbit; on the page a gold ring keeps the disc's edge visible (SC 1.4.11).
 */
interface Props {
  class?: string;
  /* `hero`: on a gold slab edge, dark ring, sized by --spacing-roundel. */
  variant?: 'page' | 'hero';
}

const { class: className = '', variant = 'page' } = Astro.props;

const DISC_CLASS = {
  page: 'size-24 border-8 border-block-gold lg:size-32',
  hero: 'size-roundel border-4 border-gold-text lg:border-8',
} as const;

const MARK_CLASS = {
  page: 'h-14 lg:h-20',
  hero: 'h-roundel-mark',
} as const;
---

<span
  class:list={[
    'rabbit-tile flex rotate-3 items-center justify-center rounded-full shadow-hard-bunny-8',
    DISC_CLASS[variant],
    className,
  ]}
>
  <RabbitMark class:list={['w-auto', MARK_CLASS[variant]]} />
</span>
