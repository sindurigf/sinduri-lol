---
import roundelRabbit from '../assets/roundel-rabbit.svg';

/*
 * The rabbit is the badge, with no disc: a die-cut sticker on a pink block
 * (scripts/make-logo.mjs). The caller positions it with `class`. alt="": the
 * header names the site.
 */
interface Props {
  class?: string;
  eager?: boolean;
  /* `hero`: on a gold slab edge, sized by --spacing-roundel. */
  variant?: 'page' | 'hero';
}

/* The box holds the absolute art, so a caller's `class` must set a position. */
const {
  class: className = 'relative',
  eager = false,
  variant = 'page',
} = Astro.props;

const BOX_CLASS = {
  page: 'size-24 lg:size-32',
  hero: 'size-roundel',
} as const;
---

<span class:list={['block rotate-3', BOX_CLASS[variant], className]}>
  {/* The art bleeds an eighth past the box (ROUNDEL_BLEED in scripts/make-logo.mjs). */}
  <span class="absolute -inset-1/8">
    <img
      src={roundelRabbit.src}
      alt=""
      width={roundelRabbit.width}
      height={roundelRabbit.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="size-full"
    />
  </span>
</span>
