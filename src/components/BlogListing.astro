---
import type { BlogCategory } from '../content.config';
import {
  cardProps,
  CATEGORY_FILTERS,
  categoryLabel,
  getCategoriesWithPosts,
  indexPageHref,
  tagLabel,
  type BlogPost,
} from '../lib/blog';
import BlogCard from './BlogCard.astro';

/*
 * The post listing: the category filter, the cards, and the pager. Shared by
 * /blog, /blog/page/<n> and every category route, so all three present the
 * same controls in the same order and a reader who has learned one has learned
 * all of them.
 *
 * THE FILTER IS SIX LINKS AND NO JAVASCRIPT.
 *
 * Each option is a real URL the site builds anyway, `/blog` and the five
 * `/blog/<category>` routes, so filtering is navigation rather than state.
 * The links are keyboard operable because they are links, the active option
 * is `aria-current="page"` because the page it points at is the page you are
 * on, every filtered view is shareable, and there is nothing to hydrate. A
 * Vue island would have had to reimplement focus, state and the URL, and the
 * five category pages would still have to exist.
 *
 * THE ACTIVE STATE IS NOT CARRIED BY COLOUR (SC 1.4.1). Three signals, two of
 * them non-colour:
 *
 *   - `aria-current="page"`, the machine-readable one, which is not optional;
 *   - a small square marker present on the active option and absent from the
 *     others, which is the shape difference. It is aria-hidden: it
 *     reinforces, it does not inform;
 *   - the inverted gold fill, which on its own is insufficient.
 */

/**
 * Which view of the posts this is. A tag listing marks no filter option
 * current, because none of them points at it: the filter is still offered, so
 * a reader who followed a tag can get back to a category or to every post.
 */
export type ListingFilter =
  | { kind: 'all' }
  | { kind: 'category'; category: BlogCategory }
  | { kind: 'tag'; tag: string };

interface Props {
  posts: BlogPost[];
  filter: ListingFilter;
  currentPage: number;
  totalPages: number;
  /**
   * The comps give the lead post a wide two-column treatment. Only the first
   * page of the unfiltered index gets it; on page two it would be arbitrary,
   * and on a category page there is no "lead" post to speak of.
   */
  featureFirst?: boolean;
}

const {
  posts,
  filter,
  currentPage,
  totalPages,
  featureFirst = false,
} = Astro.props;

const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);

/*
 * Only categories with a post in them, plus the one being viewed: someone
 * who arrives at an empty category from an old link still sees where they
 * are marked in the filter.
 */
const withPosts = await getCategoriesWithPosts();
const filterOptions = CATEGORY_FILTERS.filter(
  (option) =>
    option.category === null ||
    withPosts.has(option.category) ||
    (filter.kind === 'category' && filter.category === option.category),
);

const activeHref =
  filter.kind === 'all'
    ? '/blog/'
    : filter.kind === 'category'
      ? `/blog/${filter.category}/`
      : null;

const emptyState =
  filter.kind === 'tag'
    ? { holds: `tagged ${tagLabel(filter.tag)}`, other: 'Try a category' }
    : {
        holds: `filed under ${filter.kind === 'category' ? categoryLabel(filter.category) : 'the blog'}`,
        other: 'Try another category',
      };
---

{/*
  Named, because this page carries two navs beyond the header's, and a
  landmarks list of unlabelled "navigation" entries is a list of nothing.
*/}
<nav aria-label="Filter posts by category">
  <ul class="flex flex-wrap gap-3">
    {filterOptions.map((option) => {
      const isActive = option.href === activeHref;
      return (
        <li>
          <a
            href={option.href}
            aria-current={isActive ? 'page' : undefined}
            class="chip"
          >
            {isActive ? (
              <span aria-hidden="true" class="block size-2 bg-background" />
            ) : null}
            {option.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

{/*
  The empty state keeps the filter above it, so a reader can still reach the
  categories that do have posts. `data-empty-listing` is what
  tests/blog.spec.ts looks for; the label is small, so it is not a heading
  WAVE would guess at.
*/}
{posts.length === 0 ? (
  <div class="card mt-head shadow-hard-gold-8" data-empty-listing>
    <p class="label-wide text-gold">No posts yet</p>
    <p class="mt-4 max-w-prose text-body text-muted text-pretty">
      Nothing is {emptyState.holds} so far. {emptyState.other}, or read{' '}
      <a href="/blog/">every post</a>.
    </p>
  </div>
) : (
  <ul class="mt-head grid gap-grid lg:grid-cols-2">
    {posts.map((post, index) => {
      const feature = featureFirst && index === 0;
      return (
        <li class:list={['flex min-w-0', feature ? 'lg:col-span-2' : '']}>
          <BlogCard
            {...cardProps(post)}
            feature={feature}
            cover={post.data.cover}
            coverAlt={post.data.coverAlt}
            headingLevel={2}
            class="w-full"
          />
        </li>
      );
    })}
  </ul>
)}

{totalPages > 1 ? (
  <nav aria-label="Pagination" class="mt-actions">
    {/*
        Page numbers only. A "Previous page" or "Next page" link sits beside a
        number going to the same place, which is two adjacent links to one URL:
        two tab stops for one destination, and WAVE's "Redundant link" alert.
        See tests/wave-alerts.spec.ts.
      */}
    <ul class="flex flex-wrap items-center gap-3">
      {pageNumbers.map((page) => {
        const isCurrent = page === currentPage;
        return (
          <li>
            {/*
                The current page stays a link rather than becoming a <span>:
                `aria-current="page"` says where you are, and a link that
                drops out of the tab order when you reach it changes the
                pager's shape under a keyboard user. The accessible name needs
                the word "Page", and an aria-label would override the visible
                number and break voice control, so it is visually hidden text
                inside the link.
              */}
            <a
              href={indexPageHref(page)}
              aria-current={isCurrent ? 'page' : undefined}
              class="chip"
            >
              {isCurrent ? (
                <span aria-hidden="true" class="block size-2 bg-background" />
              ) : null}
              <span class="sr-only">Page&nbsp;</span>
              {page}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
) : null}
