---
/*
 * The end of a long page: a pointer to the post that tells the story at
 * length, and the one action that leads on from here. Closes /about and
 * /career.
 */
interface Props {
  readHref: string;
  readLabel: string;
  actionHref: string;
  actionLabel: string;
}

const { readHref, readLabel, actionHref, actionLabel } = Astro.props;
---

<div class="card mt-actions flex flex-wrap items-center justify-between gap-x-inline gap-y-8">
  <p>
    <span class="label block text-subtle">Continue reading</span>
    <a href={readHref} class="link mt-3 block text-h3 font-extrabold">
      {readLabel}
    </a>
  </p>
  <a href={actionHref} class="btn-primary">
    {actionLabel}
  </a>
</div>
