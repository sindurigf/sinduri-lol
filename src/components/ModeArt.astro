---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

/* One drawing in both pinks; light-mode.css hides the one the mode does not use. */
interface Props extends Omit<HTMLAttributes<'img'>, 'src'> {
  dark: ImageMetadata;
  light: ImageMetadata;
}

const { dark, light, class: className, ...rest } = Astro.props;
---

<img src={dark.src} class:list={['art-dark', className]} {...rest} />
<img src={light.src} class:list={['art-light', className]} {...rest} />
