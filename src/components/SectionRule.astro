---
/*
 * The short accent bar that opens a band, on the page column. Decoration only:
 * the section's heading carries its meaning. Full class names in the table so
 * Tailwind's scanner finds each one.
 */
const RULE_COLOURS = {
  gold: 'bg-gold',
  cyan: 'bg-cyan',
  pink: 'bg-pink',
} as const;

interface Props {
  accent: keyof typeof RULE_COLOURS;
}

const { accent } = Astro.props;
---

<div class="mx-auto max-w-page">
  <span class:list={['section-rule', RULE_COLOURS[accent]]}></span>
</div>
