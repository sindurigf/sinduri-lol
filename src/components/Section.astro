---
/*
 * A page section: a full-bleed band with the section heading and an optional
 * lead, then the content. Every section on the site after the PageHero is
 * one of these, so every section opens the same way and sits the same
 * distance from the next.
 *
 * No rule above the heading. The heading is display-sized and uppercase and
 * marks the section on its own; the spacing tokens separate one from the
 * next.
 *
 * `title` is a prop for the common case. A heading that needs markup, such as
 * the homepage's two roles on two lines, goes in the `title` slot instead.
 *
 * `panel` puts the whole section, heading included, in one card: for a
 * section that is a group of photos, so the heading, words and photos read as
 * one object rather than loose parts on the page. The heading comes down to
 * card-title size and the lead to body size inside it.
 *
 * `headless` keeps the band and the column and leaves the heading to the
 * slot, for a section whose heading sits inside its own layout rather than
 * above it. The slot must render an `h2` with the id `${id}-heading`, which
 * the section is labelled by.
 */
interface Props {
  title?: string;
  /** Also the heading's id prefix and the jump-link target. */
  id?: string;
  lead?: string;
  panel?: boolean;
  headless?: boolean;
  /** The panel's hard shadow; see the colour roles in ARCHITECTURE.md. */
  shadow?: 'gold' | 'pink';
  class?: string;
}

const {
  title,
  id,
  lead,
  panel = false,
  headless = false,
  shadow = 'gold',
  class: className = '',
} = Astro.props;

const SHADOW = {
  gold: 'shadow-hard-gold-8',
  pink: 'shadow-hard-pink-8',
} as const;
const headingId = id ? `${id}-heading` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['band py-section', className]}
>
  <div class="mx-auto max-w-page">
    {headless ? (
      <slot />
    ) : panel ? (
      <div class:list={['card', SHADOW[shadow]]}>
        <h2 id={headingId} class="card-title">
          <slot name="title">{title}</slot>
        </h2>
        {lead && <p class="panel-lead">{lead}</p>}
        <slot name="lead" />
        <div class="mt-8">
          <slot />
        </div>
      </div>
    ) : (
      <>
        <h2 id={headingId} class="text-h2 text-text">
          <slot name="title">{title}</slot>
        </h2>
        {lead && <p class="lead">{lead}</p>}
        <slot name="lead" />
        <div class="mt-head">
          <slot />
        </div>
      </>
    )}
  </div>
</section>
