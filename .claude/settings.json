{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-context.sh",
            "args": []
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-context.sh",
            "args": []
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '.workspace.project_dir // .cwd' | { read -r d; f=\"$d/TODO.md\"; [ -f \"$f\" ] || exit 0; printf \"%s todo remaining\" \"$(grep -c \"^[[:space:]]*- \\[ \\]\" \"$f\")\"; }"
  }
}
