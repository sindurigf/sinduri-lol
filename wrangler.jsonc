// Cloudflare Workers configuration.
//
// The @astrojs/cloudflare adapter reads this file at build time and writes a
// redirect config to dist/client/wrangler.json, which is what wrangler deploys.
// That generated file supplies the entry point, so there is no `main` here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Worker's name in the Cloudflare dashboard, or Workers
  // Builds refuses to deploy.
  "name": "sinduri-lol",
  "compatibility_date": "2026-09-11",

  // Logs only what the code writes with `console.error`: today, the reason a
  // contact form submission could not be stored, and never the submission.
  //
  // Invocation logs off. They record "the Request, Response, and related
  // metadata" for every call, and Cloudflare does not list which fields, so they
  // cannot be shown not to hold the visitor's address, which /privacy says is
  // never written down. Traces off: they record the user agent, country and ASN
  // of every submission, and they are beta, billed from 2026-10-01.
  //
  // In this file rather than the dashboard, because a deploy replaces what the
  // dashboard set: that is how a dashboard-only custom domain was lost.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
  },

  // Off: the workers.dev address would be a second copy of the site.
  "workers_dev": false,

  // The apex, as a custom domain rather than a route pattern; without
  // `custom_domain` the entry is a pattern and attaches no hostname. In this
  // file and not only in the dashboard, so a deploy never disagrees with it.
  //
  // A deploy fails while the domain is still attached to the Pages project,
  // which is why this lands only after it has been removed there.
  "routes": [{ "pattern": "sinduri.lol", "custom_domain": true }],

  // The contact form's store, created with the EU jurisdiction, which cannot be
  // changed afterwards; /privacy states it. `database_id` is an identifier, not
  // a secret: it grants nothing without an API token scoped to this account.
  "d1_databases": [
    {
      "binding": "MESSAGES_DB",
      "database_name": "sinduri-lol",
      "database_id": "c664ffd5-976d-4b32-b17f-efa254825d54",
    },
  ],

  // Keyed on a salted hash of the address, never the address itself; see
  // src/lib/contact-env.ts.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],

  "assets": {
    // The adapter splits the build into dist/client and dist/server. Built by
    // `npm run build`; no `build` key, which would build a second time.
    "directory": "./dist/client",

    // The contact form's endpoint has to reach the Worker on a browser
    // submission. With `not_found_handling` set and a compatibility date from
    // 2025-04-01, a navigation request (`Sec-Fetch-Mode: navigate`, which every
    // form submission carries) to a path with no asset is answered by the asset
    // layer without invoking the Worker, and a POST there is a 405. Measured
    // 2026-09-12: curl got a 303, Chrome got a 405, and nothing was stored.
    "run_worker_first": ["/contact/send", "/contact/send/"],

    // Serve 404.html with a 404 status for any path with no file. Pages did
    // this without being told; Workers does not. tests/not-found.spec.ts
    // asserts it.
    "not_found_handling": "404-page",

    // The default, written out: /about redirects to /about/, with a 307.
    "html_handling": "auto-trailing-slash",
  },
}
