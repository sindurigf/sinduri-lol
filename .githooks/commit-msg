#!/bin/sh
#
# Strip AI attribution trailers from commit messages.
#
# Attribution for this project is in AI_DISCLOSURE.md, not on every commit.
# `.claude/settings.json` sets an empty attribution template as the primary
# control; that setting has known reliability problems, so this hook is the
# backstop whatever tool wrote the message, and scripts/check-commits.sh fails
# a pull request that still carries one.
#
# Removed:
#   Co-Authored-By: ... claude ... / ... anthropic ...
#   Generated with [Claude Code](https://claude.com/claude-code)
#
# A `Co-Authored-By:` naming a person is left alone: dropping a human
# collaborator's credit is the worse failure.
#
# Hooks are not cloned. `git config core.hooksPath .githooks` turns this on.
#
# Nothing records it ever firing. It is the only layer that acts before the
# commit exists, and never firing is what this looks like when it works.

set -eu

msg_file=${1:?commit-msg: called without a message file}
tmp_file="${msg_file}.noai"

awk '
  {
    lowered = tolower($0)
    if (lowered ~ /^[[:space:]]*co-authored-by:.*(anthropic|claude)/) next
    if (lowered ~ /generated with \[?claude code/) next
    lines[++kept] = $0
  }
  END {
    # Drop the trailing blank lines the removal leaves behind.
    last = 0
    for (i = 1; i <= kept; i++) {
      if (lines[i] ~ /[^[:space:]]/) last = i
    }
    for (i = 1; i <= last; i++) print lines[i]
  }
' "$msg_file" > "$tmp_file"

if ! grep -q '[^[:space:]]' "$tmp_file"; then
  rm -f "$tmp_file"
  echo "commit-msg: the message is only attribution; refusing to empty it." >&2
  exit 1
fi

mv "$tmp_file" "$msg_file"
